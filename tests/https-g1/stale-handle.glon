;; Test application: the second and later requests try to respond through the
;; first request's (now stale) handle.  A correct implementation rejects that
;; and still serves the current request.
[
saved: none
home: func [request] [
    either saved [
        e: judge [ http/respond saved 200 "text/plain; charset=utf-8" "stale accepted" ]
        either sin? e [
            http/respond request 200 "text/html; charset=utf-8" "<h1>Served by Glon</h1>"
        ] [
            http/respond request 200 "text/plain; charset=utf-8" "STALE ACCEPTED"
        ]
    ] [
        saved: request
        http/respond request 200 "text/html; charset=utf-8" "<h1>Served by Glon</h1>"
    ]
]
http/listen 8443 :home
]
