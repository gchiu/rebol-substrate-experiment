;; GLON-VIEW-CORE-V1: the control for literal_block_gc.glon -- the same value
;; stored into a reduced (managed) block survives the collections.  Expected:
;; "glon" 1
gc/collect: masm 0 [ CALL collect ARITY 0 EXIT ]
g: reduce [ 0 ]
block-set!: masm 3 [ LIT SCRATCH_C ! LIT SCRATCH_B ! DUP LIT 16 MOD SUB LIT SCRATCH_A ! LIT SCRATCH_C @ LIT SCRATCH_A @ LIT 2 ADD LIT SCRATCH_B @ LIT 16 DIV ADD ! ARITY 0 EXIT ]
block-set! g 0 reduce [ s/+ "glo" "n" 1 2 3 ]
churn: func [n] [ either = n 0 [ 0 ] [ reduce [ s/+ "xxxxxxxx" "yyyyyyyy" 1 2 3 4 5 6 ]  churn - n 1 ] ]
gc/collect
churn 40
gc/collect
churn 40
values [ block-at block-at g 0 0  block-at block-at g 0 1 ]
