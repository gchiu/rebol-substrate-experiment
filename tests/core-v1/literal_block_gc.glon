;; GLON-VIEW-CORE-V1: literal-block GC hazard -- an explicit regression test
;; (tests/core-v1/literal_block_gc.sh; make literal-block-gc-check).
;;
;; KNOWN DEFECT, UNRESOLVED (GLON-LANG-1 2.4 probe a2; GLON-VIEW-C1-CONTRACT.md
;; 1.4; reproduced on C2 4dcae2aa in GLON-VIEW-CORE-V0 6.1).  A literal block
;; lives in the loader heap and the collector treats loader blocks as leaves,
;; so a managed value stored into one (here by the unchecked masm block-set!)
;; is not marked; after collections its cells are reused and the read below
;; returns another object's bytes.
;;   recorded defect:  "xxxxxxxxyyyyyyyy" 1
;;   once corrected:   "glon" 1   (or a refusal of the store)
block-set!: masm 3 [ LIT SCRATCH_C ! LIT SCRATCH_B ! DUP LIT 16 MOD SUB LIT SCRATCH_A ! LIT SCRATCH_C @ LIT SCRATCH_A @ LIT 2 ADD LIT SCRATCH_B @ LIT 16 DIV ADD ! ARITY 0 EXIT ]
gc/collect: masm 0 [ CALL collect ARITY 0 EXIT ]
holder: func [] [ [ 0 ] ]
keep: func [v] [ block-set! holder 0 v ]
keep reduce [ s/+ "glo" "n" 1 2 3 ]
churn: func [n] [ either = n 0 [ 0 ] [ reduce [ s/+ "xxxxxxxx" "yyyyyyyy" 1 2 3 4 5 6 ]  churn - n 1 ] ]
gc/collect
churn 40
gc/collect
churn 40
values [ block-at block-at holder 0 0  block-at block-at holder 0 1 ]
