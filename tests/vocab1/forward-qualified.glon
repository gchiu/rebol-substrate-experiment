;; KNOWN DEFECT (GLON-VIEW-PREP-1): the same forward reference written with the
;; full name is refused at load ("no such vocabulary"). Expected once fixed: 7
vocabulary geo [
    total: func [p] [ geo/point/sum p ]
    vocabulary point [ sum: func [p] [ + block-at p 0 block-at p 1 ] ]
]
values [ geo/total reduce [ 3 4 ] ]
