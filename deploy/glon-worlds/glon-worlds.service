[Unit]
Description=Glon Worlds loopback HTTPS pilot service
Documentation=file:/opt/glon-worlds/deploy/glon-worlds/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glon-worlds
Group=glon-worlds
WorkingDirectory=/opt/glon-worlds
StateDirectory=glon-worlds
StateDirectoryMode=0700
ExecStart=/opt/glon-worlds/glon --http-tasks --http-bind 127.0.0.1 --http-cert /etc/glon-worlds/localhost.pem --io-root /var/lib/glon-worlds --allow-file-read --allow-file-write --http-timeout-ms 30000 --http-max-body 4096 /opt/glon-worlds/modules/web.glon /opt/glon-worlds/modules/json.glon /opt/glon-worlds/examples/glon-worlds-g3b/server.glon
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
