;; demos/patrol/patrol.glon -- Glon Patrol, the game logic (Glon owns it).
;;
;; Browser supplies input + Canvas + requestAnimationFrame; Glon owns all game
;; state and rules and emits a tiny render script (canvas commands + HTML
;; status).  JS only feeds keys/frames in and draws the script out.
;;
;; Canvas script commands (to G1_VIS, drawn by patrol-host.js):
;;   C                 clear
;;   R x y w h c       rectangle (colour index c)
;;   O x y r c         circle
;; HTML status (to G1_OUT) shows score/health/game-over/restart.
;;
;; Requires prelude.glon (mk-string, str-eq) and strings.glon.

[
;; ---- playfield state (all integers; Glon owns it) ------------------------
PFW: 640
PFH: 480
BBQY: 440

sx: 300 sy: 380
score: 0 health: 8 over: 0 tick: 0
kl: 0 kr: 0 ku: 0 kd: 0 kf: 0
;; gameplay-scaled gravity (arcade fixed-point descent). Moon is default.
grav-name: "Moon"
grav-rate: 8
grav-space: 300
grav-lurch: 0
b0f: 0 b1f: 0 b2f: 0
lurch-timer: 0 lurch-n: 0 lurch-side: 0

p0x: 0 p0y: 0 p0v: 0
p1x: 0 p1y: 0 p1v: 0

b0x: 60  b0y: 0 b0v: 0
b1x: 300 b1y: 0 b1v: 0
b2x: 540 b2y: 0 b2v: 0

;; ---- small helpers -------------------------------------------------------
mod: func [a b] [ - a * b / a b ]
abs: func [n] [ either < n 0 [ - 0 n ] [ n ] ]
hit?: func [px py bx by] [
    either < abs - px bx 16 [ either < abs - py by 16 [ 1 ] [ 0 ] ] [ 0 ]
]
;; the patrol craft is wider than a projectile; use a gentler radius
hit-ship?: func [bx by] [
    either < abs - bx sx 18 [ either < abs - by sy 16 [ 1 ] [ 0 ] ] [ 0 ]
]

;; Gravity presets: gameplay-scaled descent speed and arrival spacing, roughly
;; proportional to sqrt(surface gravity).  Glon owns the rule; JS only forwards
;; the click.  Higher gravity = faster fall and more frequent arrivals.
set-gravity: func [name] [
    either str-eq name "moon" [
        grav-name: "Moon" grav-rate: 8 grav-space: 300 grav-lurch: 0
    ] [
    either str-eq name "mercury" [
        grav-name: "Mercury" grav-rate: 12 grav-space: 200 grav-lurch: 0
    ] [
    either str-eq name "mars" [
        grav-name: "Mars" grav-rate: 12 grav-space: 200 grav-lurch: 0
    ] [
    either str-eq name "earth" [
        grav-name: "Earth" grav-rate: 32 grav-space: 80 grav-lurch: 0
    ] [
    either str-eq name "jupiter" [
        grav-name: "Jupiter" grav-rate: 64 grav-space: 45 grav-lurch: 0
    ] [
    either str-eq name "blackhole" [
        grav-name: "Black Hole" grav-rate: 128 grav-space: 18 grav-lurch: 0
    ] [
    either str-eq name "velikovsky" [
        grav-name: "Velikovsky" grav-rate: 20 grav-space: 120 grav-lurch: 1
    ] [ none ] ] ] ] ] ] ]
]
reset: func [] [
    sx: 300 sy: 380 score: 0 health: 8 over: 0 tick: 0
    kl: 0 kr: 0 ku: 0 kd: 0 kf: 0
    p0v: 0 p1v: 0 p0x: 0 p0y: 0 p1x: 0 p1y: 0
    b0v: 0 b1v: 0 b2v: 0 b0y: 0 b1y: 0 b2y: 0
    b0x: 60 b1x: 300 b2x: 540
    b0f: 0 b1f: 0 b2f: 0
    lurch-timer: 0 lurch-n: 0 lurch-side: 0
]

;; ---- canvas script output (to G1_VIS) ------------------------------------
p-reset: masm [ LIT 0 LIT SCRATCH_D ! ARITY 0 EXIT ]
;; Start every frame with an explicit clear opcode (byte 67 = 'C') so the
;; browser replaces the previous frame instead of drawing over it.
p-clear: func [] [ p-reset p-byte 67 p-eol ]
p-byte: masm 1 [
    LIT SCRATCH_D @ LIT G1_VIS_DATA ADD !
    LIT SCRATCH_D @ LIT 1 ADD LIT SCRATCH_D !
    ARITY 0 EXIT
]
p-digits: func [n] [
    either > n 9 [ p-digits / n 10 ] [ none ]
    p-byte + 48 - n * 10 / n 10
]
p-int: func [n] [ either < n 0 [ p-byte 45 p-digits - 0 n ] [ p-digits n ] ]
p-sp: does [ p-byte 32 ]
p-eol: does [ p-byte 10 ]
p-num: func [n] [ p-sp p-int n ]
p-rect: func [x y w h c] [ p-byte 82 p-num x p-num y p-num w p-num h p-num c p-eol ]
p-circ: func [x y r c] [ p-byte 79 p-num x p-num y p-num r p-num c p-eol ]
p-tri: func [x1 y1 x2 y2 x3 y3 c] [ p-byte 84 p-num x1 p-num y1 p-num x2 p-num y2 p-num x3 p-num y3 p-num c p-eol ]
p-finish: masm [ LIT SCRATCH_D @ LIT G1_VIS ! LIT G1_VIS LIT T_BLOCK ADD ARITY 1 EXIT ]

;; ---- HTML status output (to G1_OUT) --------------------------------------
e-clear: masm [ LIT 0 LIT SCRATCH_E ! ARITY 0 EXIT ]
e-byte: masm 1 [
    LIT SCRATCH_E @ LIT G1_OUT_DATA ADD !
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    ARITY 0 EXIT
]
e-digits: func [n] [
    either > n 9 [ e-digits / n 10 ] [ none ]
    e-byte + 48 - n * 10 / n 10
]
e-int: func [n] [ either < n 0 [ e-byte 45 e-digits - 0 n ] [ e-digits n ] ]
e-text: masm 1 [
    DUP LIT 16 MOD SUB LIT SCRATCH_B !
    LIT 0 LIT SCRATCH_A !
    LIT SCRATCH_B @ @ LIT SCRATCH_F !
  e-text-loop:
    LIT SCRATCH_A @ LIT SCRATCH_F @ LT ZBRANCH e-text-done
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_A @ ADD @ LIT 16 MUL
    LIT G1_OUT_DATA LIT SCRATCH_E @ ADD
    !
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_A !
    BRANCH e-text-loop
  e-text-done:
    ARITY 0 EXIT
]
e-finish: masm [ LIT SCRATCH_E @ LIT G1_OUT ! LIT G1_OUT LIT T_BLOCK ADD ARITY 1 EXIT ]

;; ---- input ---------------------------------------------------------------
set-key: func [name v] [
    either str-eq name "left" [ kl: v ] [
    either str-eq name "right" [ kr: v ] [
    either str-eq name "up" [ ku: v ] [
    either str-eq name "down" [ kd: v ] [
    either str-eq name "fire" [ kf: v ] [ none ] ] ] ] ]
]

;; ---- rules ---------------------------------------------------------------
move-ship: func [] [
    either = kl 1 [ sx: - sx 7 ] [ none ]
    either = kr 1 [ sx: + sx 7 ] [ none ]
    either = ku 1 [ sy: - sy 7 ] [ none ]
    either = kd 1 [ sy: + sy 7 ] [ none ]
    either < sx 12 [ sx: 12 ] [ none ]
    either > sx 628 [ sx: 628 ] [ none ]
    either < sy 60 [ sy: 60 ] [ none ]
    either > sy 424 [ sy: 424 ] [ none ]
]
fire: func [] [
    either = kf 1 [
        either = p0v 0 [
            p0x: sx p0y: - sy 12 p0v: 1
        ] [
            either = p1v 0 [ p1x: sx p1y: - sy 12 p1v: 1 ] [ none ]
        ]
    ] [ none ]
]
move-proj: func [] [
    either = p0v 1 [
        p0y: - p0y 12
        either < p0y 0 [ p0v: 0 ] [ none ]
    ] [ none ]
    either = p1v 1 [
        p1y: - p1y 12
        either < p1y 0 [ p1v: 0 ] [ none ]
    ] [ none ]
]
move-brick: func [] [
    either = b0v 1 [
        b0f: + b0f grav-rate
        b0y: + b0y / b0f 16
        b0f: - b0f * / b0f 16 16
        either > b0y 428 [ b0v: 0 b0f: 0 health: - health 1 ] [ none ]
    ] [ none ]
    either = b1v 1 [
        b1f: + b1f grav-rate
        b1y: + b1y / b1f 16
        b1f: - b1f * / b1f 16 16
        either > b1y 428 [ b1v: 0 b1f: 0 health: - health 1 ] [ none ]
    ] [ none ]
    either = b2v 1 [
        b2f: + b2f grav-rate
        b2y: + b2y / b2f 16
        b2f: - b2f * / b2f 16 16
        either > b2y 428 [ b2v: 0 b2f: 0 health: - health 1 ] [ none ]
    ] [ none ]
]

;; Velikovsky world: deterministic "lurch" -- every 200 ticks a 60-tick lurch
;; alternates left/right and drifts the falling briquettes sideways.
do-lurch: func [] [
    either = grav-lurch 1 [
        either > lurch-timer 0 [
            lurch-timer: - lurch-timer 1
            either = b0v 1 [ b0x: + b0x * lurch-side 2 either < b0x 12 [ b0x: 12 ] [ none ] either > b0x 628 [ b0x: 628 ] [ none ] ] [ none ]
            either = b1v 1 [ b1x: + b1x * lurch-side 2 either < b1x 12 [ b1x: 12 ] [ none ] either > b1x 628 [ b1x: 628 ] [ none ] ] [ none ]
            either = b2v 1 [ b2x: + b2x * lurch-side 2 either < b2x 12 [ b2x: 12 ] [ none ] either > b2x 628 [ b2x: 628 ] [ none ] ] [ none ]
        ] [
            either = 0 mod tick 200 [
                either > tick 0 [
                    lurch-timer: 60
                    lurch-n: + lurch-n 1
                    lurch-side: either = 0 mod - lurch-n 1 2 [ 1 ] [ -1 ]
                ] [ none ]
            ] [ none ]
        ]
    ] [ none ]
]
spawn-brick: func [] [
    ;; one briquette starts every grav-space ticks, staggered across the three
    ;; slots (period 3*grav-space) so arrivals do not cluster.
    either = b0v 0 [ either = 0 mod tick * 3 grav-space [ b0x: 40 b0y: 0 b0f: 0 b0v: 1 ] [ none ] ] [ none ]
    either = b1v 0 [ either = 0 mod + tick * 2 grav-space * 3 grav-space [ b1x: 260 b1y: 0 b1f: 0 b1v: 1 ] [ none ] ] [ none ]
    either = b2v 0 [ either = 0 mod + tick grav-space * 3 grav-space [ b2x: 500 b2y: 0 b2f: 0 b2v: 1 ] [ none ] ] [ none ]
]
collide: func [] [
    either = p0v 1 [
        either = 1 hit? p0x p0y b0x b0y [ p0v: 0 b0v: 0 score: + score 10 ] [
        either = 1 hit? p0x p0y b1x b1y [ p0v: 0 b1v: 0 score: + score 10 ] [
        either = 1 hit? p0x p0y b2x b2y [ p0v: 0 b2v: 0 score: + score 10 ] [ none ] ] ]
    ] [ none ]
    either = p1v 1 [
        either = 1 hit? p1x p1y b0x b0y [ p1v: 0 b0v: 0 score: + score 10 ] [
        either = 1 hit? p1x p1y b1x b1y [ p1v: 0 b1v: 0 score: + score 10 ] [
        either = 1 hit? p1x p1y b2x b2y [ p1v: 0 b2v: 0 score: + score 10 ] [ none ] ] ]
    ] [ none ]
    ;; player craft hit by a falling briquette: remove it, lose one health
    either = b0v 1 [ either = 1 hit-ship? b0x b0y [ b0v: 0 health: - health 1 ] [ none ] ] [ none ]
    either = b1v 1 [ either = 1 hit-ship? b1x b1y [ b1v: 0 health: - health 1 ] [ none ] ] [ none ]
    either = b2v 1 [ either = 1 hit-ship? b2x b2y [ b2v: 0 health: - health 1 ] [ none ] ] [ none ]
]
step: func [] [
    move-ship
    fire
    move-proj
    move-brick
    do-lurch
    spawn-brick
    collide
    either < health 1 [ over: 1 ] [ none ]
]

;; ---- deterministic rule self-test (runs in Glon; C/JS only reads the text) -
selftest: func [] [
    fails: 0
    set-gravity "moon"
    reset
    kr: 1 move-ship
    either = sx 307 [ none ] [ fails: + fails 1 ]
    reset sx: 20 kl: 1 move-ship move-ship
    either = sx 12 [ none ] [ fails: + fails 1 ]
    reset kf: 1 fire
    either = p0v 1 [ none ] [ fails: + fails 1 ]
    reset p0v: 1 p0x: 60 p0y: 0 b0v: 1 b0x: 60 b0y: 0 collide
    either = score 10 [
        either = p0v 0 [ either = b0v 0 [ none ] [ fails: + fails 1 ] ] [ fails: + fails 1 ]
    ] [ fails: + fails 1 ]
    reset b0v: 1 b0x: sx b0y: sy collide
    either = health 7 [ either = b0v 0 [ none ] [ fails: + fails 1 ] ] [ fails: + fails 1 ]
    ;; Moon cadenced sub-pixel movement: rate 8/16 = 0.5 px/tick
    reset b0v: 1 b0y: 0 b0f: 0 move-brick
    either = b0y 0 [ none ] [ fails: + fails 1 ]
    move-brick
    either = b0y 1 [ none ] [ fails: + fails 1 ]
    ;; Earth is faster than Moon
    set-gravity "earth"
    either = grav-rate 32 [ none ] [ fails: + fails 1 ]
    reset b0v: 1 b0y: 0 b0f: 0 move-brick
    either = b0y 2 [ none ] [ fails: + fails 1 ]
    reset b0v: 1 b0y: 429 b0f: 0 move-brick
    either = health 7 [ none ] [ fails: + fails 1 ]
    reset health: 1 b0v: 1 b0y: 429 b0f: 0 step
    either = over 1 [ none ] [ fails: + fails 1 ]
    ;; Mercury and Mars equivalent; Jupiter faster than Earth
    set-gravity "mercury"
    either = grav-rate 12 [ none ] [ fails: + fails 1 ]
    set-gravity "mars"
    either = grav-rate 12 [ none ] [ fails: + fails 1 ]
    set-gravity "jupiter"
    either > grav-rate 32 [ none ] [ fails: + fails 1 ]
    ;; Velikovsky lurch: deterministic sideways motion, then normal resumes
    set-gravity "velikovsky"
    either = grav-lurch 1 [ none ] [ fails: + fails 1 ]
    tick: 200 lurch-timer: 0 lurch-n: 0 lurch-side: 0 b0v: 1 b0x: 300 b0y: 100
    do-lurch
    either = lurch-n 1 [ none ] [ fails: + fails 1 ]
    either = lurch-timer 60 [ none ] [ fails: + fails 1 ]
    either = lurch-side 1 [ none ] [ fails: + fails 1 ]
    do-lurch
    either = b0x 302 [ none ] [ fails: + fails 1 ]
    tick: 201 lurch-timer: 0 b0x: 300
    do-lurch
    either = b0x 300 [ none ] [ fails: + fails 1 ]
    ;; restart clears lurch state but keeps the selected world
    lurch-timer: 30 lurch-n: 2 lurch-side: -1
    reset
    either str-eq grav-name "Velikovsky" [ none ] [ fails: + fails 1 ]
    either = lurch-timer 0 [ either = lurch-n 0 [ either = lurch-side 0 [ none ] [ fails: + fails 1 ] ] [ fails: + fails 1 ] ] [ fails: + fails 1 ]
    set-gravity "moon"
    reset
    either = health 8 [ either = over 0 [ none ] [ fails: + fails 1 ] ] [ fails: + fails 1 ]
    e-clear
    either = fails 0 [ e-text "PATROL-SELFTEST PASS" ] [ e-text "PATROL-SELFTEST FAIL " e-int fails ]
    e-finish
]

;; ---- render --------------------------------------------------------------
render-canvas: func [] [
    p-clear
    p-rect 0 440 640 40 2
    ;; the patrol craft: a small nose-up spacecraft (triangle + body + engine)
    p-tri sx - sy 14 - sx 9 + sy 8 + sx 9 + sy 8 1
    p-rect - sx 4 - sy 2 8 10 6
    p-circ sx + sy 8 4 7
    ;; fired projectiles: bright bolts travelling upward, with a hot tip
    either = p0v 1 [ p-rect - p0x 2 - p0y 14 4 14 7 p-circ p0x - p0y 15 3 7 ] [ none ]
    either = p1v 1 [ p-rect - p1x 2 - p1y 14 4 14 7 p-circ p1x - p1y 15 3 7 ] [ none ]
    ;; falling barbecue briquettes (orange with a hot core)
    either = b0v 1 [ p-circ b0x b0y 9 3 p-circ b0x b0y 4 5 ] [ none ]
    either = b1v 1 [ p-circ b1x b1y 9 3 p-circ b1x b1y 4 5 ] [ none ]
    either = b2v 1 [ p-circ b2x b2y 9 3 p-circ b2x b2y 4 5 ] [ none ]
    p-finish
]
render-status: func [] [
    e-clear
    e-text "<h1>Glon Patrol</h1>"
    e-text "<p class='hud'>Score: " e-int score e-text "  BBQ health: " e-int health
    e-text "  Gravity: " e-text grav-name
    either > lurch-timer 0 [ e-text "  <b>WORLD LURCH</b>" ] [ none ]
    either = over 1 [ e-text "  <b>GAME OVER</b>" ] [ none ]
    e-text "</p>"
    e-text "<p>Gravity: "
    e-text "<button data-glon-event='gravity-moon'>Moon</button> "
    e-text "<button data-glon-event='gravity-mercury'>Mercury</button> "
    e-text "<button data-glon-event='gravity-mars'>Mars</button> "
    e-text "<button data-glon-event='gravity-earth'>Earth</button> "
    e-text "<button data-glon-event='gravity-jupiter'>Jupiter</button> "
    e-text "<button data-glon-event='gravity-blackhole'>Black Hole</button> "
    e-text "<button data-glon-event='gravity-velikovsky'>Velikovsky</button>"
    e-text " <span class='muted'>(Velikovsky: orbital stability not guaranteed)</span>"
    e-text "</p>"
    e-text "<p><button data-glon-event='patrol-restart'>Restart</button></p>"
    e-text "<span id='patrol-state' style='display:none'>"
    e-int sx e-text " " e-int sy e-text " " e-int score e-text " " e-int health e-text " " e-int over e-text " " e-int p0v e-text " " e-int grav-rate e-text " " e-int lurch-timer e-text " " e-int lurch-n e-text " " e-int tick
    e-text "</span>"
    e-finish
]
render: func [] [ render-canvas render-status ]

do-event: [
    either = current-event 'gravity-moon [ set-gravity "moon" reset render ] [
    either = current-event 'gravity-mercury [ set-gravity "mercury" reset render ] [
    either = current-event 'gravity-mars [ set-gravity "mars" reset render ] [
    either = current-event 'gravity-earth [ set-gravity "earth" reset render ] [
    either = current-event 'gravity-jupiter [ set-gravity "jupiter" reset render ] [
    either = current-event 'gravity-blackhole [ set-gravity "blackhole" reset render ] [
    either = current-event 'gravity-velikovsky [ set-gravity "velikovsky" reset render ] [
        either = current-event 'patrol-selftest [ selftest ] [
            either = current-event 'patrol-tick [
                tick: + tick 1
                either = over 1 [ none ] [ step ]
                render
            ] [
                either = current-event 'patrol-key-down [ set-key current-value 1 render ]
                [
                    either = current-event 'patrol-key-up [ set-key current-value 0 render ]
                    [
                        either = current-event 'patrol-restart [ reset render ]
                        [
                            either = current-event 'patrol-start [ reset render ] [ render ]
                        ]
                    ]
                ]
            ]
        ]
    ] ] ] ] ] ] ]
]

route: [ reset render ]
]
