
;; D12S.2 "Into the Invasion": the permanent grammar is GRAHAM GOES RIGHT; the

;; right forever (no fixed width); BOUNDED state comes from recycling -- pests/
;; rocks that fall behind the ranger are reclaimed and trees spawn ahead as the
;; ranger advances (kaka-wave.glon). ROCKS kill pests; BERRIES only feed/divert
;; kaka. Shared pre-built tuple space. Requires prelude/strings/kaka-lib first.

[
NTREES: 3
NTS: 48
TW: 13
TREE_MAX: 100
KAKA_MAX: 4
RAT_MAX: 8
BERRY_MAX: 6
LIVES_MAX: 3
;; post-hit invulnerability: ~0.64 s at 25 Hz (a swarm cannot take several
;; lives in successive ticks, but the player is never permanently safe)
INVULN_TICKS: 16
GNAW_TICKS: 18
;; finite semantic reach of a thrown rock, in world px from its spawn x (~one
;; gameplay viewport, so it covers visible combat without crossing the world)
ROCK_RANGE: 960

;; of the viewport. screenX = px - cam, so clamping px >= PLAYER_LEFT_MARGIN
;; guarantees screenX >= PLAYER_LEFT_MARGIN (cam = max(0, px - 35% * view-w)).
PLAYER_LEFT_MARGIN: 56
;; ---- the road to Skull Cave ----------------------------------------------
;; ONE deterministic destination (world x). The signs are fixed world objects
;; and the displayed km are a pure function of world position -- never of score

SKULL_X: 4000

;; tuple space kinds
K_EMPTY: 0
K_KAKA: 1
K_RAT: 2
K_BERRY: 3
K_PICK: 4
K_POOP: 5
K_TREE: 6
K_ROCK: 7
;; Rangi: the ONE persistent player actor. Only rangi-step mutates it.
;; F_STATE: 0 active / 1 dead.  F_E: mode (0 = FOREST).
K_RANGI: 8
;; K_FOE: a helmet-route fighter enemy (and its single bolt). Owned by
;; kaka-fighter.glon; inert to the forest systems (parked during the fighter).
K_FOE: 9

;; tuple field indices (every tuple is TW cells wide)
F_KIND: 0
F_ID: 1
F_X: 2
F_Y: 3
F_VY: 4
F_STATE: 5
F_TARGET: 6
F_A: 7
F_B: 8
F_C: 9
F_D: 10
F_E: 11

F_F: 12

;; kaka flight phases
KS_SWEEP: 0
KS_EAT: 1
KS_DIVERT: 2
KS_MUTANT: 3
KS_LEAVE: 4
KS_SWOOP: 5

;; ---- globals -------------------------------------------------------------
tick: 0 score: 0 over: 0
;; `over` is the ONE authoritative terminal state (no lives OR no tree). tally
;; recomputes it; HUD, splash and step all read this single flag.
;; hv = (0 highscore, 1 skull-ready); set by tally / on-highscore. Highscore is
;; persistent, so slot 0 is seeded once here (reset must not clear it).
hv: new-block 2
block-set! hv 0 0
;; input intent only (host -> Glon). NOT player state: the Rangi actor consumes

;; its tuple, not here.
kl: 0 kr: 0 ku: 0 kd: 0 kf: 0 kg: 0
krock: 0
;; rangi = handle to the single K_RANGI actor tuple (kaka-rangi.glon).
rangi: 0
;; cam = world x at the view's left edge; view-w = logical viewport width.
;; dist = furthest world x the ranger has reached (monotonic progress; drives

cam: 0 view-w: 640 dist: 480
;; labels 0..5 = 100km, 75km, 50km, 25km, 5km, NEXT EXIT.
;; pest leftward speed by species (0 rat, 1 stoat, 2 possum). Tuned so a timed
;; 22-tick jump comfortably clears every ordinary ground pest; stoat>rat>possum.
pest-speed: [ 4 5 3 ]
;; 1 once the ranger has travelled to the destination (no transition yet).
cd: 0 glon-cd: 0
berries: 1
;; helmet-route mission state (owned by kaka-fighter.glon). fprog == 0 arms a
;; fresh mission; fbomb 1 = the ONE bomb still available.
fprog: 0 fbomb: 0
;; packed world groups (fewer top-level bindings). Values are set by `reset`.
;;   nx = spawn timers (0 next-kaka, 1 next-pick, 2 next-tree-x)
;;   wv = wave/rhythm (0 wave, 1 wave-left, 2 wave-cd, 3 next-milestone)
;;   lz = mutant laser (0 target, 1 x, 2 y, 3 ox, 4 oy)
;;   mt = mutant activity (0 active, 1 left)
nx: new-block 3
wv: new-block 4
lz: new-block 5
mt: new-block 2
;; ax = aux (0 tcfail, 1 idc, 2 rng); pc = pest counts, refreshed by `tally`
;; (0 n-kaka, 1 n-rat, 2 n-stoat, 3 n-possum, 4 n-pick, 5 n-rock).
ax: new-block 3
pc: new-block 6
;; aggregate tree tallies (0 trees-live, 1 tree-sum), refreshed by `tally`.
tc2: new-block 2
;; occupied high-water: the per-tick scans (move-all / tally / actor-art) only
;; walk slots < ts-hi, so empty tail slots cost nothing. Raised on claim and
;; lowered (bounded) once per tick by `ch-hi` while the top slots are empty.
ts-hi: 0

sign: func [n] [ either < n 0 [ -1 ] [ either > n 0 [ 1 ] [ 0 ] ] ]
rnd: func [] [ block-set! ax 2 mod + * block-at ax 2 1103 12345 32768  block-at ax 2 ]

;; ---- shared tuple space --------------------------------------------------
;; ts holds NTS pre-built 12-cell tuples. The actor IS its tuple: spawn claims a
;; free tuple, despawn clears its kind. No arena allocation at runtime, so a
;; long session cannot exhaust the managed heap.
ts: new-block NTS

ts-init: func [i] [
    either < i NTS [ block-set! ts i new-block TW  ts-init + i 1 ] [ none ]
]
ts-t: func [i] [ block-at ts i ]
ts-k: func [i] [ block-at ts-t i F_KIND ]
tc: func [i] [
    either < i NTS [ block-set! ts-t i F_KIND 0  tc + i 1 ] [ none ]
]
tclaim: func [i k] [
    either < i NTS [
        either = block-at ts-t i F_KIND K_EMPTY [
            t: ts-t i
            block-set! t F_KIND k
            either > + i 1 ts-hi [ ts-hi: + i 1 ] [ none ]
            block-set! ax 1 + block-at ax 1 1
            block-set! t F_ID block-at ax 1
            ;; clear every field so a reused slot never inherits stale state
            block-set! t F_X 0  block-set! t F_Y 0  block-set! t F_VY 0
            block-set! t F_STATE 0  block-set! t F_TARGET 0
            block-set! t F_A 0  block-set! t F_B 0  block-set! t F_C 0
            block-set! t F_D 0  block-set! t F_E 0  block-set! t F_F 0
            t
        ] [ tclaim + i 1 k ]
    ] [ none ]
]
ts-claim: func [k] [
    t: tclaim 0 k
    either = t none [ block-set! ax 0 + block-at ax 0 1  none ] [ t ]
]
ts-free: func [t] [ block-set! t F_KIND K_EMPTY ]

ts-count: func [k] [ tcount 0 0 k ]
tcount: func [i n k] [
    either < i ts-hi [
        tcount + i 1 either = ts-k i k [ + n 1 ] [ n ] k
    ] [ n ]
]

;; ---- trees ---------------------------------------------------------------
spawn-tree: func [i x] [
    t: ts-claim K_TREE
    either = t none [ none ] [
        block-set! t F_X x
        block-set! t F_Y 300
        block-set! t F_A TREE_MAX
        block-set! t F_B i
    ]
]
damage-tree: func [ti d] [
    bt: ts-t ti
    h: - block-at bt F_A d
    block-set! bt F_A either < h 0 [ 0 ] [ h ]
]

;; ---- rats (D12B wave/climb logic lives in kaka-wave.glon) -----------------

move-all: func [i] [
    either < i ts-hi [
        k: ts-k i
        either = k K_KAKA [ kaka-step ts-t i ] [
        either = k K_RAT [ rat-step ts-t i ] [
        either = k K_BERRY [ berry-step ts-t i ] [
        either = k K_ROCK [ rock-step ts-t i ] [
        either = k K_PICK [ pick-step ts-t i ] [
        either = k K_POOP [ poop-step ts-t i ] [ none ] ] ] ] ] ]
        move-all + i 1
    ] [ none ]
]
spawn-timers: func [] [
    block-set! nx 0  - block-at nx 0 1
    either < block-at nx 0 1 [
        either < block-at pc 0 KAKA_MAX [ spawn-kaka  block-set! nx 0  + 70 mod tick 60 ] [ block-set! nx 0  40 ]
    ] [ none ]
    wave-step
    ;; rolling forest: plant the next tree ahead as the ranger advances, and
    ;; reclaim trees well behind. Bounded -- next-tree-x only ever climbs.
    either < block-at nx 2 + block-at rangi F_X 1360 [ spawn-tree 0 block-at nx 2  block-set! nx 2  + block-at nx 2 720 ] [ none ]
    tr-cull 0
    block-set! nx 1  - block-at nx 1 1
    either < block-at nx 1 1 [
        either < berries 3 [ either = 0 block-at pc 4 [ spawn-pick ] [ none ] ] [ none ]
        block-set! nx 1  + 1100 mod tick 400
    ] [ none ]
]
;; reclaim trees that have fallen well behind the ranger (their tuples are
;; reused ahead). Keeps the live forest bounded no matter how far we go.
tr-cull: func [i] [
    either < i ts-hi [
        either = ts-k i K_TREE [
            either < block-at ts-t i F_X - block-at rangi F_X 800 [ ts-free ts-t i ] [ none ]
        ] [ none ]
        tr-cull + i 1
    ] [ none ]
]
step: func [] [
    tick: + tick 1
    either > cd 0 [ cd: - cd 1 ] [ none ]
    either > glon-cd 0 [ glon-cd: - glon-cd 1 ] [ none ]
    ;; terminal: input, spawns and scoring stop; the world keeps moving and
    ;; rendering (never frozen) so in-flight rocks/berries clear.
    either = block-at rangi F_E 2 [
        ;; HELMET ROUTE: the SAME Rangi actor pilots the fighter
        ;; (kaka-fighter.glon). The forest/world is parked (no spawn, no move).
        fighter-step
    ] [
    either > block-at rangi F_E 0 [

        ;; stops; the SAME Rangi actor lives on and can still walk.
        rangi-step
    ] [
        either = over 0 [
            spawn-timers
            rangi-step
            fire
            fire-glon
            fire-rock
        ] [ none ]
        move-all 0
    ] ]
    either = over 0 [
        either >= tick block-at wv 3 [ score: + score 50  block-set! wv 3  + block-at wv 3 600 ] [ none ]
    ] [ none ]
]
reset: func [] [
    tick: 0 score: 0 over: 0
    kl: 0 kr: 0 ku: 0 kd: 0 kf: 0 kg: 0
    krock: 0
    cd: 0 glon-cd: 0
    cam: 0 dist: 480
    berries: 1
    fprog: 0 fbomb: 0
    block-set! nx 0  40 block-set! nx 1  1100 block-set! wv 3  600
    block-set! wv 0  0 block-set! wv 1  0 block-set! wv 2  0
    block-set! nx 2  2400
        block-set! lz 0  -99 block-set! lz 1  0 block-set! lz 2  0 block-set! lz 3  0 block-set! lz 4  0
    block-set! ax 0 0
    block-set! ax 1 0 block-set! ax 2 12345
    ;; pc / tc2 / hv:1 are recomputed every tick by `tally`; only highscore
    ;; (hv:0) is persistent and is seeded once at load, below.
    ts-hi: 0
    tc 0
    ;; create the ONE player actor in its RESERVED top tuple slot (NTS-1); its
    ;; tuple is the source of truth for all Rangi state (kaka-rangi.glon).
    rangi: ts-t - NTS 1
    block-set! rangi F_KIND K_RANGI
    block-set! rangi F_ID 1
    block-set! rangi F_X 480
    block-set! rangi F_Y 330
    block-set! rangi F_VY 0
    block-set! rangi F_D 1
    block-set! rangi F_B LIVES_MAX
    block-set! rangi F_A 0
    block-set! rangi F_TARGET 0
    block-set! rangi F_STATE 0
    block-set! rangi F_E 0
    block-set! rangi F_C 0
    ;; initial forest: three stable trees within the opening window; the rolling

    spawn-tree 0 240
    spawn-tree 1 960
    spawn-tree 2 1680
    tally
]
;; one pass over the tuple space, refreshing every aggregate the spawn logic,
;; HUD and tests read. Replaces Patrol's hard-coded per-entity variables.
tally: func [] [
    either > score block-at hv 0 [ block-set! hv 0 score ] [ none ]
    ch-hi 6
    block-set! mt 0  0  block-set! mt 1  0
    block-set! pc 0 0  block-set! pc 1 0  block-set! pc 2 0  block-set! pc 3 0  block-set! pc 4 0  block-set! pc 5 0
    block-set! tc2 0 0  block-set! tc2 1 0
    tly 0
    ;; ONE terminal predicate: no lives, or no gameplay tree. HUD, splash and
    ;; step gating all read this single `over`.
    over: either = block-at rangi F_B 0 [ 1 ] [ either = block-at tc2 0 0 [ 1 ] [ 0 ] ]
    ;; Skull Cave destination: reached purely by travelled world progress.
    block-set! hv 1 either >= dist SKULL_X [ 1 ] [ 0 ]
]
tly: func [i] [
    either < i ts-hi [
        k: ts-k i
        either = k K_KAKA [
            block-set! pc 0 + block-at pc 0 1
            either = block-at ts-t i F_STATE KS_MUTANT [
                block-set! mt 0  1
                l: - block-at ts-t i F_B tick
                either > l block-at mt 1 [ block-set! mt 1  l ] [ none ]
            ] [ none ]
        ] [
        either = k K_RAT [
            ;; ghosts (F_STATE 9) are transient presentation and are NOT counted
            ;; as live pests, so a fading corpse never blocks the next wave.
            either < block-at ts-t i F_STATE 9 [
                block-set! pc 1 + block-at pc 1 1
                either = block-at ts-t i F_A 1 [ block-set! pc 2 + block-at pc 2 1 ] [
                either = block-at ts-t i F_A 2 [ block-set! pc 3 + block-at pc 3 1 ] [ none ] ]
            ] [ none ]
        ] [
        either = k K_ROCK [ block-set! pc 5 + block-at pc 5 1 ] [
        either = k K_BERRY [ none ] [
        either = k K_PICK [ block-set! pc 4 + block-at pc 4 1 ] [
        either = k K_POOP [ none ] [
        either = k K_TREE [
            block-set! tc2 1 + block-at tc2 1 block-at ts-t i F_A
            either > block-at ts-t i F_A 0 [ block-set! tc2 0 + block-at tc2 0 1 ] [ none ]
        ] [ none ] ] ] ] ] ] ]
        tly + i 1
    ] [ none ]
]
;; lower the occupied high-water while the top slots are empty (bounded so the
;; clamp itself stays cheap); keeps the per-tick scans proportional to actors.
ch-hi: func [n] [
    either > n 0 [
        either > ts-hi 0 [
            either = ts-k - ts-hi 1 K_EMPTY [ ts-hi: - ts-hi 1  ch-hi - n 1 ] [ none ]
        ] [ none ]
    ] [ none ]
]

;; ---- input / events ------------------------------------------------------
set-key: func [name v] [
    either str-eq name "left" [ kl: v ] [
    either str-eq name "right" [ kr: v ] [
    either str-eq name "up" [ ku: v ] [
    either str-eq name "down" [ kd: v ] [
    either str-eq name "fire" [ kf: v ] [
    either str-eq name "glon" [ kg: v ] [
    either str-eq name "rock" [ krock: v ] [ none ] ] ] ] ] ] ]
]
reset-input: func [] [ kl: 0 kr: 0 ku: 0 kd: 0 kf: 0 kg: 0  krock: 0 ]

;; always step: game over gates new threats/score inside step, never the world
on-tick: func [] [ step  tally  render ]
on-start: func [] [ reset tally render ]
on-key-down: func [] [ set-key current-value 1 render ]
on-key-up: func [] [ set-key current-value 0 render ]
on-input-reset: func [] [ reset-input render ]
;; The persisted high score is handed in as an event value at boot. Glon owns
;; the comparison: a stored value can only ever raise the high score, so lower
;; junk can never overwrite a better one.
on-highscore: func [] [
    v: str-int current-value
    either > v block-at hv 0 [ block-set! hv 0 v ] [ none ]
    render
]
;; soak/test hooks (deterministic; they change state, not rules): force the
;; first kaka into mutant state, and grant a Mystery Glon Berry.
on-debug-mutant: func [] [ dm 0  tally  render ]
dm: func [i] [
    either < i NTS [
        either = ts-k i K_KAKA [ block-set! ts-t i F_STATE KS_MUTANT  block-set! ts-t i F_B + tick 300 ] [ dm + i 1 ]
    ] [ none ]
]

dmg-all-trees: func [i] [
    either < i NTS [
        either = ts-k i K_TREE [ block-set! ts-t i F_A 0 ] [ none ]
        dmg-all-trees + i 1
    ] [ none ]
]
on-debug-over: func [] [ dmg-all-trees 0  tally  render ]
;; deterministic test hooks: force one life loss, and set the current score
on-debug-hit: func [] [ lose-life  tally  render ]
on-debug-score: func [] [ score: str-int current-value  tally  render ]
;; soak hook: pin the life count so long-session berry/actor soaks do not end
;; the game and stop firing (the life rules have their own tests).
on-debug-lives: func [] [ block-set! rangi F_B str-int current-value  tally render ]
;; test/screenshot hook: jump straight into the helmet mission at a chosen
;; mission clock (value = fprog; 0/empty arms it). No rule lives here.
on-debug-fighter: func [] [
    block-set! rangi F_E 2
    fighter-enter
    fprog: either > str-int current-value 0 [ str-int current-value ] [ 1 ]
    tally render
]

;; the dispatcher is a table lookup (the same shape traffic.glon uses), so the
;; game reads as data and the routing stays in Glon.
events: [
    ['kaka-tick [ on-tick ]]
    ['kaka-start [ on-start ]]
    ['kaka-restart [ on-start ]]
    ['kaka-key-down [ on-key-down ]]
    ['kaka-key-up [ on-key-up ]]
    ['kaka-input-reset [ on-input-reset ]]
    ['kaka-selftest [ selftest ]]
    ['kaka-highscore [ on-highscore ]]
    ['kaka-viewport [ on-viewport ]]
    ['kaka-debug-mutant [ on-debug-mutant ]]
    ['kaka-debug-over [ on-debug-over ]]
    ['kaka-debug-hit [ on-debug-hit ]]
    ['kaka-debug-score [ on-debug-score ]]
    ['kaka-debug-lives [ on-debug-lives ]]
    ['kaka-debug-fighter [ on-debug-fighter ]]
]
do-event: [
    event-row: select events current-event
    either event-row [ do block-at event-row 1 ] [ render ]
]
route: [ reset tally render ]

ts-init 0
]
