;; demos/kaka/kaka.glon -- Attack of the Mutant Kaka (Glon owns all state/rules).
;;
;; The kaka are native wildlife and must never be shot; the player fires
;; BERRIES that divert them away from the trees. Introduced rats damage the
;; habitat. A rare Mystery Glon Berry turns one kaka into a giant mutant whose
;; ocular lasers zap rats (not birds). Berry-fed kaka occasionally poop, which
;; regenerates a damaged tree. All actors live in a shared, pre-built Glon
;; tuple space (kaka-lib.glon provides new-block/block-set!); JS only paints.
;;
;; Requires prelude.glon, strings.glon, kaka-lib.glon (loaded first).

[
PFW: 640
PFH: 480
GROUND: 360
NTREES: 3
NTS: 32
TW: 12
TREE_MAX: 100
KAKA_MAX: 4
RAT_MAX: 5
BERRY_MAX: 6
LIVES_MAX: 3
INVULN_TICKS: 50
GNAW_TICKS: 18

;; tuple space kinds
K_EMPTY: 0
K_KAKA: 1
K_RAT: 2
K_BERRY: 3
K_PICK: 4
K_POOP: 5
K_TREE: 6

;; tuple field indices (every tuple is TW=12 cells wide)
F_KIND: 0
F_ID: 1
F_X: 2
F_Y: 3
F_VY: 4
F_STATE: 5
F_TARGET: 6
F_A: 7
F_B: 8
F_C: 9
F_D: 10
F_E: 11

;; kaka flight phases
KS_SWEEP: 0
KS_EAT: 1
KS_DIVERT: 2
KS_MUTANT: 3
KS_LEAVE: 4
KS_SWOOP: 5

;; ---- globals -------------------------------------------------------------
tick: 0 score: 0 over: 0
;; `over` is the ONE authoritative terminal state (no lives OR no tree). tally
;; recomputes it; HUD, splash and step all read this single flag.
lives: 3 invuln: 0 highscore: 0
kl: 0 kr: 0 ku: 0 kd: 0 kf: 0 kg: 0
px: 220 py: 330
;; camera: a small smoothed horizontal offset used ONLY for presentation. The
;; world/logic coordinates stay absolute; the render emits `cam` so the browser
;; can scroll the parallax PNGs (and the host scrolls the gameplay plane 1:1).
cam: 0
cd: 0 glon-cd: 0
berries: 1
    next-kaka: 60 next-pick: 1100 next-milestone: 600
    wave: 0 wave-left: 0 wave-cd: 0 breaches: 0
laser: -99 laser-x: 0 laser-y: 0 laser-ox: 0 laser-oy: 0
idc: 0 rng: 12345
;; aggregate actor/tree tallies, refreshed once per tick by `tally` so the
;; spawn logic, HUD and game-over test never re-scan the tuple space.
mutant-active: 0 mutant-left: 0
n-kaka: 0 n-rat: 0 n-berry: 0 n-pick: 0 n-poop: 0
trees-live: 0 tree-sum: 0
;; occupied high-water: the per-tick scans (move-all / tally / actor-art) only
;; walk slots < ts-hi, so empty tail slots cost nothing. Raised on claim and
;; lowered (bounded) once per tick by `ch-hi` while the top slots are empty.
ts-hi: 0

sign: func [n] [ either < n 0 [ -1 ] [ either > n 0 [ 1 ] [ 0 ] ] ]
rnd: func [] [ rng: mod + * rng 1103 12345 32768  rng ]

;; ---- shared tuple space --------------------------------------------------
;; ts holds NTS pre-built 12-cell tuples. The actor IS its tuple: spawn claims a
;; free tuple, despawn clears its kind. No arena allocation at runtime, so a
;; long session cannot exhaust the managed heap.
ts: new-block NTS

ts-init: func [i] [
    either < i NTS [ block-set! ts i new-block TW  ts-init + i 1 ] [ none ]
]
ts-t: func [i] [ block-at ts i ]
ts-k: func [i] [ block-at ts-t i F_KIND ]
ts-clear: func [] [ tc 0 ]
tc: func [i] [
    either < i NTS [ block-set! ts-t i F_KIND 0  tc + i 1 ] [ none ]
]
tclaim: func [i k] [
    either < i NTS [
        either = block-at ts-t i F_KIND K_EMPTY [
            t: ts-t i
            block-set! t F_KIND k
            either > + i 1 ts-hi [ ts-hi: + i 1 ] [ none ]
            idc: + idc 1
            block-set! t F_ID idc
            ;; clear every field so a reused slot never inherits stale state
            block-set! t F_X 0  block-set! t F_Y 0  block-set! t F_VY 0
            block-set! t F_STATE 0  block-set! t F_TARGET 0
            block-set! t F_A 0  block-set! t F_B 0  block-set! t F_C 0
            block-set! t F_D 0  block-set! t F_E 0
            t
        ] [ tclaim + i 1 k ]
    ] [ none ]
]
ts-claim: func [k] [ tclaim 0 k ]
ts-free: func [t] [ block-set! t F_KIND K_EMPTY ]

ts-count: func [k] [ tcount 0 0 k ]
tcount: func [i n k] [
    either < i ts-hi [
        tcount + i 1 either = ts-k i k [ + n 1 ] [ n ] k
    ] [ n ]
]

;; ---- trees ---------------------------------------------------------------
spawn-tree: func [i x] [
    t: ts-claim K_TREE
    either = t none [ none ] [
        block-set! t F_X x
        block-set! t F_Y 300
        block-set! t F_A TREE_MAX
        block-set! t F_B i
    ]
]
tree-sum: func [] [ tsum 0 0 ]
tsum: func [i n] [
    either < i NTREES [
        tsum + i 1 either = ts-k i K_TREE [ + n block-at ts-t i F_A ] [ n ]
    ] [ n ]
]
damage-tree: func [ti d] [
    bt: ts-t ti
    h: - block-at bt F_A d
    block-set! bt F_A either < h 0 [ 0 ] [ h ]
]

;; ---- rats (D12B wave/climb logic lives in kaka-wave.glon) -----------------

;; ---- berries and the Mystery Glon Berry ----------------------------------
fire: func [] [
    either = kf 1 [
        either < cd 1 [
            either < ts-count K_BERRY BERRY_MAX [
                b: ts-claim K_BERRY
                either = b none [ none ] [
                    block-set! b F_X px
                    block-set! b F_Y - py 14
                    block-set! b F_VY -9
                    block-set! b F_A 0
                    cd: 9
                ]
            ] [ none ]
        ] [ none ]
    ] [ none ]
]
fire-glon: func [] [
    either = kg 1 [
        either < glon-cd 1 [
            either > berries 0 [
                b: ts-claim K_BERRY
                either = b none [ none ] [
                    block-set! b F_X px
                    block-set! b F_Y - py 14
                    block-set! b F_VY -8
                    block-set! b F_A 1
                    berries: - berries 1
                    glon-cd: 20
                ]
            ] [ none ]
        ] [ none ]
    ] [ none ]
]
divert: func [kt bt] [
    block-set! kt F_STATE KS_DIVERT
    block-set! kt F_C 0
    ;; keep momentum; steer away so the turn is an arc, never an instant flip
    block-set! kt F_D either < - block-at kt F_X px 0 [ -1 ] [ 1 ]
    ts-free bt
    score: + score 10
]
mutate: func [kt bt] [
    block-set! kt F_STATE KS_MUTANT
    block-set! kt F_B + tick 540
    ts-free bt
]
berry-step: func [t] [
    block-set! t F_Y + block-at t F_Y block-at t F_VY
    ;; after the terminal life loss, berries still travel and despawn but have
    ;; after the single terminal state, berries travel and despawn but
    ;; have no effect
    either = over 0 [
        either < block-at t F_Y 265 [
            either > block-at t F_Y 215 [ either = 1 berry-blocked? 0 t [ none ] [ berry-hit t 0 ] ] [ berry-hit t 0 ]
        ] [ berry-hit t 0 ]
    ] [ none ]
    ;; berries are fired upward (F_VY < 0), so they leave the playfield at the
    ;; TOP. Freeing on Y > 480 (which only a downward-moving actor can reach)
    ;; leaked every missed berry in the fixed BERRY_MAX pool until firing died.
    either < block-at t F_Y 0 [ ts-free t ] [ none ]
]
berry-hit: func [t i] [
    either < i ts-hi [
        either = ts-k i K_KAKA [
            either < + abs - block-at ts-t i F_X block-at t F_X abs - block-at ts-t i F_Y block-at t F_Y 34 [
                either = block-at t F_A 1 [ mutate ts-t i t ] [ divert ts-t i t ]
            ] [ berry-hit t + i 1 ]
        ] [ berry-hit t + i 1 ]
    ] [ none ]
]
spawn-pick: func [] [
    t: ts-claim K_PICK
    either = t none [ none ] [
        block-set! t F_X + 60 mod rnd 520
        block-set! t F_Y 20
        block-set! t F_VY 2
    ]
]
pick-step: func [t] [
    y: + block-at t F_Y block-at t F_VY
    block-set! t F_Y y
    either < abs - px block-at t F_X 26 [
        either < abs - py y 30 [ either = over 1 [ none ] [ berries: + berries 1 ]  ts-free t ] [ either > y 470 [ ts-free t ] [ none ] ]
    ] [ either > y 470 [ ts-free t ] [ none ] ]
]
poop-step: func [t] [
    y: + block-at t F_Y block-at t F_VY
    block-set! t F_Y y
    either >= y 330 [ either = over 1 [ ts-free t ] [ poop-land 0 t ] ] [ none ]
]
poop-land: func [i t] [
    either < i NTREES [
        either = ts-k i K_TREE [
            either < abs - block-at ts-t i F_X block-at t F_X 44 [
                either < block-at ts-t i F_A TREE_MAX [
                    h: + block-at ts-t i F_A 25
                    block-set! ts-t i F_A either > h TREE_MAX [ TREE_MAX ] [ h ]
                    score: + score 25
                    ts-free t
                ] [ ts-free t ]
            ] [ poop-land + i 1 t ]
        ] [ poop-land + i 1 t ]
    ] [ ts-free t ]
]

;; ---- one world tick (deterministic; no randomness beyond Glon's own rng) --
move-player: func [] [
    dx: - kr kl
    dy: - kd ku
    ;; cardinal 10 px/tick (~3 s to cross at 25 Hz); diagonal 7/7 so it is not
    ;; faster than a straight line. Reacts within one tick; no acceleration.
    either = 0 * dx dy [ px: + px * dx 10  py: + py * dy 7 ] [ px: + px * dx 7  py: + py * dy 7 ]
    either < px 24 [ px: 24 ] [ none ]
    either > px 616 [ px: 616 ] [ none ]
    either < py 300 [ py: 300 ] [ none ]
    either > py 348 [ py: 348 ] [ none ]
    ;; camera follow (presentation only; world coordinates are never changed):
    ;; dead zone of 60 px, target clamped to +/-120 so the whole 640-wide
    ;; playfield stays framed, then eased by at most 2 px/tick (no jitter).
    dx: - px 320
    dx: either > abs dx 60 [ - dx * 60 sign dx ] [ 0 ]
    dx: either > dx 120 [ 120 ] [ either < dx -120 [ -120 ] [ dx ] ]
    either > abs - dx cam 2 [ cam: + cam * 2 sign - dx cam ] [ cam: dx ]
]
move-all: func [i] [
    either < i ts-hi [
        k: ts-k i
        either = k K_KAKA [ kaka-step ts-t i ] [
        either = k K_RAT [ rat-step ts-t i ] [
        either = k K_BERRY [ berry-step ts-t i ] [
        either = k K_PICK [ pick-step ts-t i ] [
        either = k K_POOP [ poop-step ts-t i ] [ none ] ] ] ] ]
        move-all + i 1
    ] [ none ]
]
spawn-timers: func [] [
    next-kaka: - next-kaka 1
    either < next-kaka 1 [
        either < n-kaka KAKA_MAX [ spawn-kaka  next-kaka: + 150 mod tick 120 ] [ next-kaka: 60 ]
    ] [ none ]
    wave-step
    next-pick: - next-pick 1
    either < next-pick 1 [
        either < berries 3 [ either = 0 n-pick [ spawn-pick ] [ none ] ] [ none ]
        next-pick: + 1100 mod tick 400
    ] [ none ]
]
step: func [] [
    tick: + tick 1
    either > cd 0 [ cd: - cd 1 ] [ none ]
    either > glon-cd 0 [ glon-cd: - glon-cd 1 ] [ none ]
    either > invuln 0 [ invuln: - invuln 1 ] [ none ]
    ;; terminal: input, spawns and scoring stop; the world keeps moving and
    ;; rendering (never frozen) so in-flight berries clear.
    either = over 0 [
        spawn-timers
        move-player
        fire
        fire-glon
    ] [ none ]
    move-all 0
    either = over 0 [
        either >= tick next-milestone [ score: + score 50  next-milestone: + next-milestone 600 ] [ none ]
    ] [ none ]
]
reset: func [] [
    tick: 0 score: 0 over: 0
    lives: LIVES_MAX invuln: 0
    kl: 0 kr: 0 ku: 0 kd: 0 kf: 0 kg: 0
    px: 220 py: 330 cd: 0 glon-cd: 0
    cam: 0
    berries: 1
next-kaka: 60 next-pick: 1100 next-milestone: 600
        laser: -99 laser-x: 0 laser-y: 0 laser-ox: 0 laser-oy: 0
    idc: 0 rng: 12345
    ts-hi: 0
    ts-clear
    spawn-tree 0 120
    spawn-tree 1 320
    spawn-tree 2 520
    tally
]
;; one pass over the tuple space, refreshing every aggregate the spawn logic,
;; HUD and tests read. Replaces Patrol's hard-coded per-entity variables.
tally: func [] [
    update-high
    ch-hi 6
    mutant-active: 0  mutant-left: 0
    n-kaka: 0  n-rat: 0  n-berry: 0  n-pick: 0  n-poop: 0
    trees-live: 0  tree-sum: 0
    tly 0
    ;; ONE terminal predicate: no lives, or no gameplay tree. HUD, splash and
    ;; step gating all read this single `over`.
    over: either = lives 0 [ 1 ] [ either = trees-live 0 [ 1 ] [ 0 ] ]
]
tly: func [i] [
    either < i ts-hi [
        k: ts-k i
        either = k K_KAKA [
            n-kaka: + n-kaka 1
            either = block-at ts-t i F_STATE KS_MUTANT [
                mutant-active: 1
                l: - block-at ts-t i F_B tick
                either > l mutant-left [ mutant-left: l ] [ none ]
            ] [ none ]
        ] [
        either = k K_RAT [ n-rat: + n-rat 1 ] [
        either = k K_BERRY [ n-berry: + n-berry 1 ] [
        either = k K_PICK [ n-pick: + n-pick 1 ] [
        either = k K_POOP [ n-poop: + n-poop 1 ] [
        either = k K_TREE [
            tree-sum: + tree-sum block-at ts-t i F_A
            either > block-at ts-t i F_A 0 [ trees-live: + trees-live 1 ] [ none ]
        ] [ none ] ] ] ] ] ]
        tly + i 1
    ] [ none ]
]
;; lower the occupied high-water while the top slots are empty (bounded so the
;; clamp itself stays cheap); keeps the per-tick scans proportional to actors.
ch-hi: func [n] [
    either > n 0 [
        either > ts-hi 0 [
            either = ts-k - ts-hi 1 K_EMPTY [ ts-hi: - ts-hi 1  ch-hi - n 1 ] [ none ]
        ] [ none ]
    ] [ none ]
]

;; ---- input / events ------------------------------------------------------
set-key: func [name v] [
    either str-eq name "left" [ kl: v ] [
    either str-eq name "right" [ kr: v ] [
    either str-eq name "up" [ ku: v ] [
    either str-eq name "down" [ kd: v ] [
    either str-eq name "fire" [ kf: v ] [
    either str-eq name "glon" [ kg: v ] [ none ] ] ] ] ] ]
]
reset-input: func [] [ kl: 0 kr: 0 ku: 0 kd: 0 kf: 0 kg: 0 ]

;; always step: game over gates new threats/score inside step, never the world
on-tick: func [] [ step  tally  render ]
on-start: func [] [ reset tally render ]
on-key-down: func [] [ set-key current-value 1 render ]
on-key-up: func [] [ set-key current-value 0 render ]
on-input-reset: func [] [ reset-input render ]
;; The persisted high score is handed in as an event value at boot. Glon owns
;; the comparison: a stored value can only ever raise the high score, so lower
;; junk can never overwrite a better one.
on-highscore: func [] [
    v: str-int current-value
    either > v highscore [ highscore: v ] [ none ]
    render
]
;; soak/test hooks (deterministic; they change state, not rules): force the
;; first kaka into mutant state, and grant a Mystery Glon Berry.
on-debug-mutant: func [] [ dm 0  tally  render ]
dm: func [i] [
    either < i NTS [
        either = ts-k i K_KAKA [ block-set! ts-t i F_STATE KS_MUTANT  block-set! ts-t i F_B + tick 300 ] [ dm + i 1 ]
    ] [ none ]
]
on-debug-give: func [] [ berries: + berries 1  render ]
;; soak/test hook: destroy every tree and mark game over (tick_regression_cdp.js)
dmg-all-trees: func [i] [
    either < i NTS [
        either = ts-k i K_TREE [ block-set! ts-t i F_A 0 ] [ none ]
        dmg-all-trees + i 1
    ] [ none ]
]
on-debug-over: func [] [ dmg-all-trees 0  tally  render ]
;; deterministic test hooks: force one life loss, and set the current score
on-debug-hit: func [] [ lose-life  tally  render ]
on-debug-score: func [] [ score: str-int current-value  tally  render ]
;; soak hook: pin the life count so long-session berry/actor soaks do not end
;; the game and stop firing (the life rules have their own tests).
on-debug-lives: func [] [ lives: str-int current-value  tally  render ]

;; the dispatcher is a table lookup (the same shape traffic.glon uses), so the
;; game reads as data and the routing stays in Glon.
events: [
    ['kaka-tick [ on-tick ]]
    ['kaka-start [ on-start ]]
    ['kaka-restart [ on-start ]]
    ['kaka-key-down [ on-key-down ]]
    ['kaka-key-up [ on-key-up ]]
    ['kaka-input-reset [ on-input-reset ]]
    ['kaka-selftest [ selftest ]]
    ['kaka-highscore [ on-highscore ]]
    ['kaka-debug-mutant [ on-debug-mutant ]]
    ['kaka-debug-give [ on-debug-give ]]
    ['kaka-debug-over [ on-debug-over ]]
    ['kaka-debug-hit [ on-debug-hit ]]
    ['kaka-debug-score [ on-debug-score ]]
    ['kaka-debug-lives [ on-debug-lives ]]
]
do-event: [
    event-row: select events current-event
    either event-row [ do block-at event-row 1 ] [ render ]
]
route: [ reset tally render ]

ts-init 0
]
