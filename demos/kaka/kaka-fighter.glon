;; demos/kaka/kaka-fighter.glon -- D12S.12 "Helmet Route": the trench mission.
;;
;; The SAME Rangi actor (id, tuple, slot) pilots the fighter in place: F_E == 2.
;; No second player actor exists and the forest lives (F_B) are untouched -- the
;; fighter uses a compact mission-local shield in F_C. Glon owns mission state,
;; steering, spawn timing, collision, hits, target and bomb logic; the host owns
;; projection/presentation of the cockpit + wireframe trench.
;;
;; kaka.glon's `step` routes F_E == 2 to `fighter-step` (the only name it needs).
;;
;; Rangi field reuse in fighter mode:
;;   F_X  lateral world  (+/-180)      F_Y  vertical world (+/-120)
;;   F_STATE  phase 0 run / 1 escape / 2 win / 3 fail
;;   F_C  local shield (hits left)     F_A  brief invulnerability
;;   F_TARGET  laser cooldown / escape countdown   F_D  boost timer
;; Globals (declared in kaka.glon): fprog = mission clock, fbomb = 1 armed.
;; Kind K_FOE carries one foe AND its single in-flight bolt in the same tuple:
;;   F_X/F_Y pos  F_C depth (420->0)  F_A behaviour  F_B crossing sign
;;   F_D fire cooldown  F_TARGET bolt life  F_E/F_F bolt x/y  F_VY bolt z
;;   F_STATE 0 alive / 1 destroyed

;; first fighter tick: fprog == 0 means "arm a fresh mission" (reset on every
;; win/fail/reset), so the route always re-initialises.
fighter-enter: func [] [
    block-set! rangi F_X 0  block-set! rangi F_Y 0  block-set! rangi F_VY 0
    block-set! rangi F_STATE 0  block-set! rangi F_C 3  block-set! rangi F_A 30
    block-set! rangi F_TARGET 0  block-set! rangi F_D 0
    fprog: 1  fbomb: 1
]
;; free every live foe (mission entry/exit; forest actors stay parked)
fighter-clear: func [i] [
    either < i ts-hi [
        either = ts-k i K_FOE [ ts-free ts-t i ] [ none ]
        fighter-clear + i 1
    ] [ none ]
]
;; mission-local hit: one shield step + brief invulnerability; 0 shield = fail
fighter-hit: func [] [
    either > block-at rangi F_A 0 [ none ] [
        either > block-at rangi F_C 0 [ block-set! rangi F_C - block-at rangi F_C 1  block-set! rangi F_A 20 ] [ none ]
        either < block-at rangi F_C 1 [ block-set! rangi F_STATE 3 ] [ none ]
    ]
]
;; steering + boost. FIRE (kf) is the boost (the forest jump input is the
;; vertical-up control here): steerable, self-expiring, lasers still fire.
fighter-controls: func [] [
    either = kf 1 [ block-set! rangi F_D 24 ] [ none ]
    sp: either > block-at rangi F_D 0 [ 9 ] [ 5 ]
    block-set! rangi F_X + block-at rangi F_X * - kr kl sp
    block-set! rangi F_Y + block-at rangi F_Y * - kd ku sp
    either > block-at rangi F_X 180 [ block-set! rangi F_X 180 ] [ none ]
    either < block-at rangi F_X -180 [ block-set! rangi F_X -180 ] [ none ]
    either > block-at rangi F_Y 120 [ block-set! rangi F_Y 120 ] [ none ]
    either < block-at rangi F_Y -120 [ block-set! rangi F_Y -120 ] [ none ]
]
;; deterministic spawn: a foe every 18 ticks, <=5 live; behaviour = id mod 3
;; one foe: close depth, behave, fire its bolt, ram/bolt the player
foe-step: func [t] [
    block-set! t F_C - block-at t F_C 3
    b: block-at t F_A
    either = b 0 [ block-set! t F_X + block-at t F_X * block-at t F_B 6 ] [ none ]
    either > b 0 [
        block-set! t F_X + block-at t F_X sign - block-at rangi F_X block-at t F_X
        block-set! t F_Y + block-at t F_Y sign - block-at rangi F_Y block-at t F_Y
    ] [ none ]
    either < block-at t F_D 1 [
        either < block-at t F_TARGET 1 [
            either < block-at t F_C 300 [
                block-set! t F_TARGET 70  block-set! t F_E block-at t F_X
                block-set! t F_F block-at t F_Y  block-set! t F_VY block-at t F_C
            ] [ none ]
        ] [ none ]
        block-set! t F_D + 24 mod rnd 40
    ] [ block-set! t F_D - block-at t F_D 1 ]
    either > block-at t F_TARGET 0 [
        block-set! t F_TARGET - block-at t F_TARGET 1
        block-set! t F_VY - block-at t F_VY 6
        either < block-at t F_VY 12 [
            either < abs - block-at t F_E block-at rangi F_X 60 [
                either < abs - block-at t F_F block-at rangi F_Y 52 [ fighter-hit ] [ none ]
            ] [ none ]
        ] [ none ]
    ] [ none ]
    either < abs - block-at t F_X block-at rangi F_X 40 [
        either < block-at t F_C 30 [ fighter-hit ] [ none ]
    ] [ none ]
    either < block-at t F_C -20 [ ts-free t ] [ none ]
]
fighter-foes: func [i] [
    either < i ts-hi [
        either = ts-k i K_FOE [ foe-step ts-t i ] [ none ]
        fighter-foes + i 1
    ] [ none ]
]
;; is foe t inside the reticle cone? (kept separate so the search stays shallow;
;; the loader mis-compiles ~6-deep conditionals)
zap-ok?: func [t] [
    either < abs - block-at t F_X block-at rangi F_X 90 [
        either < abs - block-at t F_Y block-at rangi F_Y 72 [ 1 ] [ 0 ]
    ] [ 0 ]
]
;; ROCK -> hitscan laser: destroys the nearest foe inside the reticle cone
fighter-zap: func [i best bz] [
    either < i ts-hi [
        either = ts-k i K_FOE [
            either = 1 zap-ok? ts-t i [
                either < block-at ts-t i F_C bz [ fighter-zap + i 1 i block-at ts-t i F_C ] [ fighter-zap + i 1 best bz ]
            ] [ fighter-zap + i 1 best bz ]
        ] [ fighter-zap + i 1 best bz ]
    ] [ either < best 0 [ none ] [ ts-free ts-t best  score: + score 15 ] ]
]
;; trench gate every 200 ticks: one blocked region forces one clear direction.
;; q==198 is the single collision tick and the index matches the rendered gate.
fighter-gates: func [] [
    either > fprog 120 [
        either = 198 mod - fprog 120 200 [
            p: mod / - fprog 120 200 5
            either = p 0 [ either > block-at rangi F_Y 0 [ none ] [ fighter-hit ] ] [ none ]
            either = p 1 [ either < block-at rangi F_Y 0 [ none ] [ fighter-hit ] ] [ none ]
            either = p 2 [ either > block-at rangi F_X 0 [ none ] [ fighter-hit ] ] [ none ]
            either = p 3 [ either < block-at rangi F_X 0 [ none ] [ fighter-hit ] ] [ none ]
            either = p 4 [ either < abs block-at rangi F_Y 60 [ none ] [ fighter-hit ] ] [ none ]
        ] [ none ]
    ] [ none ]
]
;; ONE bomb. From tick 850 the station node is present: GLON aligned (<70 off
;; centre) kills it and begins the escape; anywhere else/earlier the bomb is
;; spent for nothing, so the node is later unopposed and the mission fails.
fighter-run: func [] [
    fighter-controls
    ;; spawn a foe every 18 ticks, <=5 live (behaviour = id mod 3)
        either = 0 mod fprog 18 [
            either < ts-count K_FOE 5 [
                t: ts-claim K_FOE
                either = t none [ none ] [
                    b: mod block-at t F_ID 3
                    block-set! t F_A b  block-set! t F_D + 20 mod rnd 40
                    block-set! t F_C 420  block-set! t F_TARGET 0  block-set! t F_VY 0
                    either = b 0 [
                        block-set! t F_X either = 0 mod block-at t F_ID 2 [ -260 ] [ 260 ]
                        block-set! t F_Y - 90 mod rnd 180
                        block-set! t F_B * -1 sign block-at t F_X
                    ] [
                        block-set! t F_X - 130 mod rnd 260
                        block-set! t F_Y - 90 mod rnd 180
                        block-set! t F_B 0
                    ]
                ]
            ] [ none ]
        ] [ none ]
    fighter-foes 0
    either = krock 1 [ either < block-at rangi F_TARGET 1 [ block-set! rangi F_TARGET 6  fighter-zap 0 -1 99999 ] [ none ] ] [ none ]
    fighter-gates
    ;; the ONE bomb (target window >= tick 850)
        either = kg 1 [
            either > fbomb 0 [
                fbomb: 0
                either < abs block-at rangi F_X 70 [
                    either >= fprog 850 [
                        block-set! rangi F_STATE 1  block-set! rangi F_TARGET 90  score: + score 200
                    ] [ none ]
                ] [ none ]
            ] [ none ]
        ] [ none ]
    either > block-at rangi F_A 0 [ block-set! rangi F_A - block-at rangi F_A 1 ] [ none ]
    either > block-at rangi F_D 0 [ block-set! rangi F_D - block-at rangi F_D 1 ] [ none ]
    either > block-at rangi F_TARGET 0 [ block-set! rangi F_TARGET - block-at rangi F_TARGET 1 ] [ none ]
    either >= fprog 1300 [ block-set! rangi F_STATE 3 ] [ none ]
]
;; exit: fail -> SKULL_CAVE hub; success -> FOREST just short of the cave
;; (a later continuation point; no bespoke post-cave section exists yet, so the
;; run can be repeated -- documented temporary behaviour)
fighter-exit: func [fail] [
    fighter-clear 0
    block-set! rangi F_STATE 0  block-set! rangi F_VY 0  block-set! rangi F_C 0
    block-set! rangi F_TARGET 0
    cam: 0  fprog: 0
    either = fail 1 [
        block-set! rangi F_E 1  block-set! rangi F_X 200  block-set! rangi F_Y 352  block-set! rangi F_A 0
    ] [
        block-set! rangi F_E 0  block-set! rangi F_X 3400  block-set! rangi F_Y 330  block-set! rangi F_A 30
        dist: 3400
        keep-visible
    ]
]
fighter-step: func [] [
    either = fprog 0 [ fighter-enter ] [
        either = block-at rangi F_STATE 2 [ fighter-exit 0 ] [
        either = block-at rangi F_STATE 3 [ fighter-exit 1 ] [
        either = block-at rangi F_STATE 1 [
            ;; escape: keep steering/dodging, then count the escape clock down
            fighter-controls
            fighter-foes 0
            block-set! rangi F_TARGET - block-at rangi F_TARGET 1
            either < block-at rangi F_TARGET 1 [ block-set! rangi F_STATE 2 ] [ none ]
        ] [
            fprog: + fprog 1
            fighter-run
        ] ] ] ]
    ]

;; ---- fighter render (semantic ops; the host projects/draws) ---------------
;; A px py phase shield boost laser prog   fighter frame header
;; X present aligned                        station node
;; G pattern pct                            approaching gate
;; U ex ey ez behaviour                     foe
;; K bx by bz                               enemy bolt
;; Y on                                     player laser this tick
;; render-only loop (never steps): emits each foe and its in-flight bolt
fdraw: func [i] [
    either < i ts-hi [
        either = ts-k i K_FOE [
            t: ts-t i
            p-byte 85 p-num block-at t F_X p-num block-at t F_Y p-num block-at t F_C p-num block-at t F_A p-eol
            either > block-at t F_TARGET 0 [
                p-byte 75 p-num block-at t F_E p-num block-at t F_F p-num block-at t F_VY p-eol
            ] [ none ]
        ] [ none ]
        fdraw + i 1
    ] [ none ]
]
fighter-scene: func [] [
    p-byte 65 p-num block-at rangi F_X p-num block-at rangi F_Y
    p-num block-at rangi F_STATE p-num block-at rangi F_C
    p-num either > block-at rangi F_D 0 [ 1 ] [ 0 ] p-num krock p-num fprog p-eol
    either > fprog 120 [
        p-byte 71 p-num mod / - fprog 120 200 5
        p-num / * mod - fprog 120 200 50 100 p-eol
    ] [ none ]
    fdraw 0
    p-byte 89 p-num fbomb p-eol
]
