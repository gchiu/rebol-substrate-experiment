;; demos/kaka/kaka-draw.glon -- rendering for Attack of the Mutant Kaka.
[
;; --- lives / laser hazard / high score ---
imin: func [a b] [ either < a b [ a ] [ b ] ]
imax: func [a b] [ either > a b [ a ] [ b ] ]
;; separating-axis test: beam (ax,ay)-(bx,by) vs box [x0,y0,x1,y1]
seg-rect?: func [ax ay bx by x0 y0 x1 y1] [
    dx: - bx ax
    dy: - by ay
    p: - * dx ay * dy ax
    rl: imin imin - * dx y0 * dy x0 - * dx y0 * dy x1 imin - * dx y1 * dy x0 - * dx y1 * dy x1
    rh: imax imax - * dx y0 * dy x0 - * dx y0 * dy x1 imax - * dx y1 * dy x0 - * dx y1 * dy x1
    either > imin ax bx x1 [ 0 ] [
    either < imax ax bx x0 [ 0 ] [
    either > imin ay by y1 [ 0 ] [
    either < imax ay by y0 [ 0 ] [
        either < p rl [ 0 ] [ either > p rh [ 0 ] [ 1 ] ]
    ] ] ] ]
]
;; The ranger's hitbox in world coordinates (matches draw-player: head + body).
laser-hits-player?: func [] [
    seg-rect? laser-ox laser-oy laser-x laser-y - block-at rangi F_X 10 - block-at rangi F_Y 14 + block-at rangi F_X 10 + block-at rangi F_Y 22
]
;; One life, exactly, with NO teleport (the rolling world must not jump back);
;; short invulnerability follows. The ONE canonical player-consequence path.
;; mutant laser crossing the ranger (invuln / game over change nothing)
laser-hazard: func [] [
    either = over 0 [
        either < block-at rangi F_A 1 [ either laser-hits-player? [ lose-life ] [ none ] ] [ none ]
    ] [ none ]
]
;; The host reports the logical presentation width (from the display aspect) so
;; the camera can show more world on wide landscape screens.
on-viewport: func [] [
    v: str-int current-value
    view-w: either < v 320 [ 320 ] [ either > v 1600 [ 1600 ] [ v ] ]
    render
]

;; ---- kaka flight: bounded steering => curved paths -----------------------
steer: func [v d] [
    e: - d v
    either > e 2 [ + v 2 ] [ either < e -2 [ - v 2 ] [ d ] ]
]
k-move: func [t wx wy sx sy] [
    vx: steer block-at t F_VY * sign - wx block-at t F_X sx
    vy: steer block-at t F_E * sign - wy block-at t F_Y sy
    block-set! t F_VY vx
    block-set! t F_E vy
    block-set! t F_X + block-at t F_X vx
    block-set! t F_Y + block-at t F_Y vy
]
;; pick the first live tree from an id-derived offset (distinct ids spread out)
kp: func [n t] [
    either < n NTS [
        i: mod + mod block-at t F_ID NTS n NTS
        either = ts-k i K_TREE [
            either > block-at ts-t i F_A 0 [ block-set! t F_TARGET i ] [ kp + n 1 t ]
        ] [ kp + n 1 t ]
    ] [ block-set! t F_STATE KS_LEAVE ]
]
spawn-kaka: func [] [
    t: ts-claim K_KAKA
    either = t none [ none ] [
        ;; birds roam the battlefield AROUND the ranger (not a fixed world slot)
        block-set! t F_X + - block-at rangi F_X 260 mod rnd 900
        block-set! t F_Y 20
        block-set! t F_STATE KS_SWEEP
        block-set! t F_D either = 0 mod block-at t F_ID 2 [ 1 ] [ -1 ]
        block-set! t F_VY * block-at t F_D 3
        block-set! t F_E 2
        kp 0 t
    ]
]
kaka-step: func [t] [
    s: block-at t F_STATE
    either = s KS_MUTANT [ kaka-mutant t ] [
    either = s KS_DIVERT [ kaka-divert t ] [
    either = s KS_EAT [ kaka-eat t ] [
    either = s KS_LEAVE [ kaka-leave t ] [
    either = s KS_SWOOP [ kaka-swoop t ] [ kaka-sweep t ] ] ] ] ]
]
;; entry + approach: a shallow gliding arc across to the tree (broad curve)
kaka-sweep: func [t] [
    ti: block-at t F_TARGET
    tx: block-at ts-t ti F_X
    wy: + 74 mod block-at t F_ID 36
    k-move t tx wy 6 3
    either < abs - block-at t F_X tx 24 [ block-set! t F_STATE KS_SWOOP ] [ none ]
]
;; steeper dive onto the canopy (steering rounds the turn into a bank)
kaka-swoop: func [t] [
    ti: block-at t F_TARGET
    tx: block-at ts-t ti F_X
    k-move t tx 250 3 7
    either > block-at t F_Y 242 [
        block-set! t F_STATE KS_EAT
        block-set! t F_A 0
    ] [ none ]
]
kaka-eat: func [t] [
    ti: block-at t F_TARGET
    either < block-at ts-t ti F_A 1 [ kp 0 t ] [
        tx: block-at ts-t ti F_X
        k-move t tx + 250 mod tick 8 3 2
        a: + block-at t F_A 1
        block-set! t F_A a
        either = 0 mod a 36 [ either = over 1 [ none ] [ damage-tree ti 10 ] ] [ none ]
        ;; fed enough: pull away and leave (kaka-leave curves up and out)
        either > a 108 [ block-set! t F_STATE KS_LEAVE ] [ none ]
    ]
]
kaka-leave: func [t] [
    k-move t either > block-at t F_D 0 [ + block-at rangi F_X 1400 ] [ -1400 ] 16 7 4
    either > block-at t F_X + block-at rangi F_X 1500 [ ts-free t ] [
        either < block-at t F_X - block-at rangi F_X 1300 [ ts-free t ] [ none ]
    ]
]
kaka-divert: func [t] [
    either = block-at t F_C 0 [
        p: ts-claim K_POOP
        either = p none [ none ] [
            block-set! p F_X block-at t F_X
            block-set! p F_Y block-at t F_Y
            block-set! p F_VY 3
            block-set! t F_C 1
        ]
    ] [ none ]
    k-move t + block-at t F_X * block-at t F_D 180 -50 6 5
    either < block-at t F_Y -24 [ ts-free t ] [ none ]
]
nr: func [i best bd t] [
    either < i ts-hi [
        either = ts-k i K_RAT [
            ;; skip ghosts (F_STATE 9): a fading corpse is not a target
            either < block-at ts-t i F_STATE 9 [
                d: + abs - block-at ts-t i F_X block-at t F_X abs - block-at ts-t i F_Y block-at t F_Y
                either < d bd [ nr + i 1 ts-t i d t ] [ nr + i 1 best bd t ]
            ] [ nr + i 1 best bd t ]
        ] [ nr + i 1 best bd t ]
    ] [ best ]
]
;; ocular beam origin relative to the mutant's logical (x,y), right-facing frame
kaka-mutant: func [t] [
    either > tick block-at t F_B [ block-set! t F_STATE KS_LEAVE  laser: -99 ] [
        r: nr 0 none 99999 t
        either = r none [
            laser: -99
            k-move t block-at t F_X 130 0 4
        ] [
            rx: block-at r F_X
            ry: block-at r F_Y
            k-move t rx ry 6 6
            ;; ocular beam + its ranger-crossing test; off-screen birds may
            ;; still simulate but draw/zap nothing until near the viewport
            d: either < block-at t F_VY 0 [ -1 ] [ 1 ]
            laser: -99
            either < block-at t F_X - cam 40 [ none ] [
            either > block-at t F_X + + cam view-w 40 [ none ] [
                laser: tick
                laser-ox: + block-at t F_X * d 11
                laser-oy: + block-at t F_Y -7
                laser-x: rx
                laser-y: ry
                laser-hazard
            ] ]
            either < + abs - block-at t F_X rx abs - block-at t F_Y ry 40 [
                either = over 1 [ none ] [
                    ;; same canonical transition (ghost); laser keeps its +25
                    kill-pest r
                    score: + score 25
                ]
            ] [ none ]
        ]
    ]
]

;; ---- rendering (Glon -> Canvas script; JS paints) -------------------------
;; beech tree; health F_A 0..100 drives five stages (intact -> dead)
tree-art: func [t] [
    x: block-at t F_X
    h: block-at t F_A
    either < h 1 [
        p-rect - x 5 306 10 54 2
        p-line x 306 - x 17 286 2 2
        p-line x 306 + x 15 282 2 2
    ] [
        p-rect - x 6 300 12 60 8
        p-tri - x 10 360 + x 10 360 x 336 8
        p-line x 300 - x 30 250 3 8
        p-line x 300 + x 27 244 3 8
        p-line x 300 - x 6 228 2 8
        p-line x 300 + x 8 224 2 8
        either > h 70 [
            p-circ - x 16 244 14 9
            p-circ + x 14 236 14 4
            p-circ x 226 13 9
            p-circ - x 28 254 10 4
            p-circ + x 28 248 10 13
            p-circ x 252 10 13
            p-circ - x 6 232 11 4
            p-circ + x 8 224 10 9
            p-circ x 240 12 4
            p-circ - x 10 238 2 1
            p-circ + x 12 232 2 1
            p-circ x 250 2 1
            p-circ - x 22 252 1 1
        ] [
            either > h 40 [
                p-circ - x 18 248 11 9
                p-circ + x 16 240 10 4
                p-circ x 230 9 13
                p-circ + x 26 250 7 4
                p-circ - x 26 254 7 9
                p-circ x 248 7 13
                p-circ - x 12 244 2 1
                p-circ + x 8 238 1 1
            ] [
                either > h 10 [
                    p-circ - x 14 248 8 9
                    p-circ + x 12 240 7 4
                    p-circ x 232 6 13
                ] [
                    p-line - x 24 250 - x 34 236 2 8
                    p-line + x 22 244 + x 34 232 2 8
                    p-line - x 6 230 - x 14 218 2 8
                ]
            ]
        ]
    ]
]
;; sprite actors: `S id x y dir`; id names a host-owned frame
p-spr: func [id x y d] [ p-byte 83 p-num id p-num x p-num y p-num d p-eol ]

spr-kaka: func [t] [
    x: block-at t F_X
    y: block-at t F_Y
    d: either < block-at t F_VY 0 [ -1 ] [ 1 ]
    st: block-at t F_STATE
    either = st KS_MUTANT [
        either < - tick laser 9 [ p-spr 12 x y d ] [
            p-spr either < mod tick 10 5 [ 10 ] [ 11 ] x y d
        ]
    ] [
    either = st KS_SWOOP [ p-spr 3 x y d ] [
    either = st KS_EAT [ p-spr 2 x y d ] [
    either = st KS_DIVERT [ p-spr 0 x y d ] [
    either = st KS_LEAVE [ p-spr 1 x y d ] [
        p-spr either < mod tick 12 6 [ 0 ] [ 1 ] x y d
    ] ] ] ] ]
]
;; Pest art by species (0 rat, 1 stoat, 2 possum); death/hit emit halo/spark.
spr-rat: func [t] [
    x: block-at t F_X
    y: block-at t F_Y
    sp: block-at t F_A
    either = block-at t F_STATE 9 [
        ;; SEMANTIC DEATH EVENT (species id world-x world-y); the HOST stages
        ;; the pest-heaven ghost, so this dead tuple emits then reclaims.
        p-byte 68 p-num sp p-num block-at t F_ID p-num x p-num y p-eol
    ] [
        either > block-at t F_D 0 [
            c: - y 12
            p-line x - c 18 x - c 28 2 7
            p-line - x 16 c - x 26 c 2 7
            p-line + x 16 c + x 26 c 2 7
        ] [ none ]
        either = sp 1 [
            ;; stoat: long, low and slender -- unmistakably longer than a rat
            p-line - x 10 - y 5 - x 12 y 3 8
            p-line + x 8 - y 5 + x 10 y 3 8
            p-line - x 26 - y 9 - x 46 - y 14 3 8
            p-ell x - y 9 22 6 8
            p-ell + x 1 - y 7 18 3 16
            p-circ + x 20 - y 11 6 8
            p-circ + x 26 - y 11 3 16
            p-circ + x 21 - y 13 1 0
        ] [
        either = sp 2 [
            ;; possum: bulky/squat grey, pointed face, pink ears + long bare tail
            p-line - x 34 - y 12 - x 74 - y 20 6 10
            p-line - x 16 - y 4 - x 20 y 6 8
            p-line + x 12 - y 4 + x 16 y 6 8
            p-ell x - y 14 34 16 2
            p-ell + x 2 - y 8 26 9 17
            p-tri + x 34 - y 12 + x 56 - y 18 + x 34 - y 24 2
            p-circ + x 30 - y 18 11 2
            p-circ + x 26 - y 30 5 10
            p-circ + x 36 - y 28 4 10
            p-circ + x 52 - y 18 3 10
            p-circ + x 30 - y 20 2 0
        ] [
            either > block-at t F_C 0 [ p-spr 22 x - y mod tick 6 -1 ] [
                p-spr either < mod tick 8 4 [ 20 ] [ 21 ] x y -1
            ]
        ] ]
    ]
]
;; A rat chewing at a trunk: a few bark flecks and a brief hit flash at the
;; gnawed tree, so it is obvious which tree just lost health.
gnaw-cue: func [t] [
    either > block-at t F_C 0 [
        gx: block-at t F_E
        p-circ - gx 6 - 330 mod tick 5 2 8
        p-circ + gx 4 + 334 mod tick 7 2 8
        p-circ + gx 10 + 326 mod tick 6 2 8
        either > block-at t F_C - GNAW_TICKS 6 [ p-line gx 296 gx 344 2 16 ] [ none ]
    ] [ none ]
]
spr-berry: func [t] [
    x: block-at t F_X
    y: block-at t F_Y
    either = block-at t F_A 1 [ p-spr 31 x y 1 ] [ p-spr 30 x y 1 ]
]
actor-art: func [i] [
    either < i ts-hi [
        k: ts-k i
        either = k K_KAKA [ spr-kaka ts-t i ] [
        either = k K_RAT [ spr-rat ts-t i  gnaw-cue ts-t i ] [
        either = k K_BERRY [ spr-berry ts-t i ] [
        either = k K_ROCK [
            p-circ block-at ts-t i F_X block-at ts-t i F_Y 5 0
            p-circ block-at ts-t i F_X block-at ts-t i F_Y 3 2
        ] [
        either = k K_PICK [ p-spr 31 block-at ts-t i F_X block-at ts-t i F_Y 1 ] [
        either = k K_POOP [ p-spr 32 block-at ts-t i F_X block-at ts-t i F_Y 1 ] [ none ] ] ] ] ] ]
        actor-art + i 1
    ] [ none ]
]
;; cam markers: 66 background, 70 foreground
draw-trees: func [i] [
    either < i ts-hi [
        either = ts-k i K_TREE [ tree-art ts-t i ] [ none ]
        draw-trees + i 1
    ] [ none ]
]
;; The mutant's ocular beam, drawn from its eye to its target rat.
draw-laser: func [] [
    either > laser 0 [ p-line laser-ox laser-oy laser-x laser-y 2 14 ] [ none ]
]
render-canvas: func [] [
    p-clear
    p-byte 66 p-num cam p-eol
    draw-trees 0
    actor-art 0
    draw-laser
    ;; foreground foliage is emitted BEFORE the ranger so the protagonist is
    ;; never composited behind it (he must always be visible)
    p-byte 70 p-num cam p-eol
    draw-player
    p-finish
]

;; ---- HTML status (Glon builds only the dynamic part; the static head/tag/
;; keyboard/muted markup lives in kaka.html so it is not re-emitted every tick) --
render-status: func [] [
    e-clear
    e-text "<p class='hud'>SCORE: " e-int score
    e-text "    Lives: " e-int block-at rangi F_B
    e-text "    Trees: " e-int trees-live e-text "/" e-int NTREES
    e-text "    Habitat: " e-int tree-sum e-text "/" e-int * NTREES TREE_MAX
    e-text "    Glon Berries: " e-int berries
    e-text "    Wave: " e-int wave
    e-text "    HIGH SCORE: " e-int highscore
    either > block-at rangi F_A 0 [ e-text "    <b class='invuln'>INVULNERABLE</b>" ] [ none ]
    either = over 1 [ e-text "    <b>GAME OVER</b>" ] [ none ]
    e-text "</p>"
    either = mutant-active 1 [
        e-text "<p class='mutant'>MUTANT KAKA &mdash; OCULAR LASERS ACTIVE ("
        e-int / mutant-left 60 e-text "s)</p>"
    ] [ none ]
    ;; The host mirrors this numeric value into localStorage (small semantic
    ;; bridge); Glon owns the value and the comparison.
    e-text "<i id='kaka-hs' style='display:none'>" e-int highscore e-text "</i>"
    e-text "<i id='kaka-state' style='display:none'>"
    e-int tick e-text " " e-int score e-text " " e-int over e-text " " e-int berries e-text " "
    e-int block-at rangi F_X e-text " " e-int kl e-text " " e-int kr e-text " " e-int kf e-text " " e-int kg e-text " "
    e-int n-kaka e-text " " e-int n-rat e-text " "
    e-int mutant-active e-text " " e-int mutant-left e-text " " e-int block-at rangi F_Y e-text " "
    e-int block-at rangi F_B e-text " " e-int block-at rangi F_A e-text " " e-int highscore e-text " "
    e-int n-rock e-text " " e-int tcfail e-text " " e-int n-stoat e-text " " e-int n-possum e-text " " e-int block-at rangi F_VY e-text " " e-int ku
    e-text "</i>"
    either = over 1 [
        e-text "<div class='kaka-gameover'><div class='kaka-go-panel'>"
        e-text "<div class='kaka-go-title'>GAME OVER!!!</div>"
        e-text "<div class='kaka-go-sub'>THE FOREST HAS FALLEN</div>"
        e-text "<div class='kaka-go-line'>SCORE: " e-int score "</div>"
        e-text "<div class='kaka-go-line'>HIGH SCORE: " e-int highscore "</div>"
        e-text "<div class='kaka-go-again'>PRESS R TO PLAY AGAIN</div>"
        e-text "<button class='kaka-go-btn' data-glon-event='kaka-restart'>PLAY AGAIN</button>"
        e-text "</div></div>"
    ] [ none ]
    e-finish
]
render: func [] [ render-canvas render-status ]

]
