;; demo/shop/strings-ext.glon -- byte access, slicing, scanning and integer text
;; for STRING!: an OPTIONAL extension of the standard s/ string vocabulary.
;; STATUS: approved API (2026-11-07); see GLON-ARCHITECTURE-MEMORY.md §7.
;;
;; All indices are 0-based BYTE offsets. Ranges are half-open, as in Python:
;; [start, end) contains start but not end; s/slice takes a start and a length,
;; s/span a start and an exclusive end. Neither accepts negative indices or
;; clamps: an out-of-range request raises 'range.
;;
;; EXTRACTION IS STRICT; SCANNING CLAMPS. s/slice and s/span raise 'range for
;; any bad range: asking for bytes that do not exist is an error. s/scan-set
;; clamps its start to [0, length] instead: a scanner positioned at or beyond
;; the end of its input is a normal state (the input is exhausted), and the
;; answer is simply the length.
;;
;;   s/at s i           the byte (0..255) at 0-based index i; NONE when i is outside
;;                      [0, length) (including any index into an empty string)
;;   s/slice s start n  a NEW string of the n bytes starting at 0-based `start`;
;;                      requires 0 <= start, 0 <= n, start + n <= length, else it raises
;;                      SIN! 'range 's/slice [start n]. n = 0 gives an empty string.
;;   s/span s start end a NEW string of the bytes in [start, end); requires
;;                      0 <= start <= end <= length, else it raises
;;                      SIN! 'range 's/span [start end]. start = end gives "".
;;                      (s/span s a b is s/slice s a b - a.)
;;   s/scan-set s i set the first index >= i whose byte is NOT one of the bytes of
;;                      the string `set` (the length if there is none); i is
;;                      clamped to [0, length]; an empty `set` returns i (clamped)
;;   s/from-int n       the decimal text of the integer n (any integer the build holds)
;;
;; Errors follow strings.glon: a wrong argument type raises SIN! 'type with the
;; operation's name as the id and the offending value as the arg. All arguments
;; are evaluated first, as for any function. Nothing changes an argument:
;; strings stay immutable.
;;
;; BYTES, NOT CHARACTERS. A STRING! holds bytes (GLON-ALPHA-LAWS.md §9a), and
;; none of these decode UTF-8:
;;   - "π" is 2 bytes (207 128): s/at gives each byte;
;;   - s/slice and s/span can split a multi-byte character, leaving invalid UTF-8;
;;   - a `set` of s/scan-set is a set of BYTES, so "π" in a set matches either of
;;     its bytes anywhere.
;;
;; INTEGER RANGE. Glon integers are tagged cells: about +-2^59 in the native
;; 64-bit build, but only about +-2^27 (134,217,727) in the 32-bit WebAssembly
;; build. s/from-int handles the most negative integer of either build.
;;
;; WHY A SEPARATE FILE. strings.glon is loaded by every interactive Glon page
;; (primer, LaTeX, Patrol, Attack of the Mutant Kaka) and by the CLI and
;; Jupyter. These operations cost 10 global bindings and 1,212 loader-heap
;; cells. Kaka's browser session already uses 252 of the 256 global bindings
;; and has 242 loader cells free (measured 2026-11-07), so adding them to
;; strings.glon would stop it loading. Sessions that need them load this file
;; after strings.glon (GLON-ARCHITECTURE-MEMORY.md §2: mechanisms in the
;; kernel, meanings in loadable Glon; sessions load only what they use).
;;
;; Mechanisms are unchecked masm workers (s/raw-...); meanings are checked Glon
;; funcs, as in strings.glon. CALL THE s/raw-... WORKERS ONLY THROUGH THE
;; VALIDATED PUBLIC WRAPPERS ABOVE. They check neither types nor bounds: given
;; a bad index or a negative count they read or write outside the string, and
;; can corrupt memory or run until the machine faults. The wrappers' checks
;; are what make the operations safe, and the regression tests for invalid
;; ranges (r0_s1_string_ext_tests.c B5-B8, E6-E9) must be kept. Workers loop in S1 (no recursion per byte) and use
;; only the safe scratch cells A/B/C/F. Promoted from the GLON-PRATT v004
;; experiment (experiments/glon-pratt/s-extra.glon keeps its own frozen copy).
;; NAMES DIFFER FROM v004: there, s/span is the byte-set scanner, which is
;; s/scan-set here; s/span here extracts a half-open range. Do not load this
;; file into a session that uses v004's s-extra.glon: whichever loads last
;; defines s/span. v004's scanner also built a 256-byte table per call;
;; s/scan-set scans the set directly. s/from-int now negates no value, so the
;; most negative integer is handled too.
;;
;; Requires prelude.glon or common.glon (mk-string, s/raw-string?) and
;; strings.glon (s/+, s/raw-length). Wrapped in [ ] because it contains masm.
[
;; s/raw-int? ( value -> 1|0 ): the value is an INTEGER! (tag 0); internal
s/raw-int?: masm 1 [ LIT 16 MOD LIT 0 EQ LIT 16 MUL ARITY 1 EXIT ]

;; s/raw-at ( string! i -> byte ): unchecked; 0 <= i < length
s/raw-at: masm 2 [
    LIT 16 DIV LIT SCRATCH_A !
    LIT T_STRING SUB LIT 1 ADD LIT SCRATCH_A @ ADD @ LIT 16 MUL ARITY 1 EXIT
]

;; s/raw-slice ( string! start n -> string! ): unchecked; the caller checks the
;; range. The input stays on the data stack (a GC root) across the allocation;
;; the new string is pushed at once and filled before it is returned.
s/raw-slice: masm 3 [
    LIT 16 DIV LIT SCRATCH_F !
    LIT 16 DIV LIT SCRATCH_B !
    LIT SCRATCH_F @ LIT 16 ADD LIT 16 DIV LIT 16 MUL LIT GC_KIND_STRING CALL alloc LIT SCRATCH_C !
    LIT SCRATCH_A !
    LIT SCRATCH_F @ LIT SCRATCH_C @ !
    LIT SCRATCH_C @ LIT T_STRING ADD
    LIT SCRATCH_A @ LIT T_STRING SUB LIT 1 ADD LIT SCRATCH_B @ ADD LIT SCRATCH_A !
    LIT SCRATCH_C @ LIT 1 ADD LIT SCRATCH_C !
  s-slice-loop:
    LIT SCRATCH_F @ ZBRANCH s-slice-done
    LIT SCRATCH_A @ @ LIT SCRATCH_C @ !
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_A !
    LIT SCRATCH_C @ LIT 1 ADD LIT SCRATCH_C !
    LIT SCRATCH_F @ LIT 1 SUB LIT SCRATCH_F !
    BRANCH s-slice-loop
  s-slice-done:
    ARITY 1 EXIT
]

;; s/raw-scan-set ( string! i set:string! -> index ): unchecked; 0 <= i <= length.
;; A nested loop needs more than the safe scratch cells A/B/C/F, so it keeps
;; its pointers and lengths in a 16-cell workspace: a length-0 STRING!, so the
;; collector never scans its raw contents. That workspace is garbage on return.
;; The inputs stay on the data stack (GC roots) across that allocation. Nothing
;; allocates in the loop, so the raw pointers stay valid. Each byte is looked
;; up in `set` directly. A 256-byte table would cost 272 cells of the 7,232-cell
;; managed heap.
;;   W+1 string payload   W+2 string length   W+3 set payload   W+4 set length
s/raw-scan-set: masm 3 [
    LIT SCRATCH_C ! LIT SCRATCH_B ! LIT SCRATCH_A !
    LIT SCRATCH_A @ LIT SCRATCH_B @ LIT SCRATCH_C @
    LIT 16 LIT GC_KIND_STRING CALL alloc LIT SCRATCH_F !
    LIT SCRATCH_C ! LIT SCRATCH_B ! LIT SCRATCH_A !
    LIT 0 LIT SCRATCH_F @ !
    LIT SCRATCH_A @ LIT T_STRING SUB LIT SCRATCH_F @ LIT 1 ADD !
    LIT SCRATCH_A @ LIT T_STRING SUB @ LIT SCRATCH_F @ LIT 2 ADD !
    LIT SCRATCH_C @ LIT T_STRING SUB LIT SCRATCH_F @ LIT 3 ADD !
    LIT SCRATCH_C @ LIT T_STRING SUB @ LIT SCRATCH_F @ LIT 4 ADD !
    LIT SCRATCH_B @ LIT 16 DIV LIT SCRATCH_B !
  s-scan-outer:
    LIT SCRATCH_B @ LIT SCRATCH_F @ LIT 2 ADD @ LT ZBRANCH s-scan-done
    LIT SCRATCH_F @ LIT 1 ADD @ LIT 1 ADD LIT SCRATCH_B @ ADD @ LIT SCRATCH_C !
    LIT SCRATCH_F @ LIT 4 ADD @ LIT SCRATCH_A !
  s-scan-inner:
    LIT SCRATCH_A @ ZBRANCH s-scan-done
    LIT SCRATCH_A @ LIT 1 SUB LIT SCRATCH_A !
    LIT SCRATCH_F @ LIT 3 ADD @ LIT 1 ADD LIT SCRATCH_A @ ADD @ LIT SCRATCH_C @ EQ ZBRANCH s-scan-inner
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_B !
    BRANCH s-scan-outer
  s-scan-done:
    LIT SCRATCH_B @ LIT 16 MUL ARITY 1 EXIT
]

s/at: func [s i] [
    either s/raw-string? s [
        either s/raw-int? i [
            either either < i 0 [ 0 ] [ < i s/raw-length s ] [ s/raw-at s i ] [ none ]
        ] [ raise create-sin 'type 's/at i ]
    ] [ raise create-sin 'type 's/at s ]
]

s/slice: func [s start n] [
    either s/raw-string? s [
        either either s/raw-int? start [ s/raw-int? n ] [ 0 ] [
            either either either >= start 0 [ >= n 0 ] [ 0 ] [ <= + start n s/raw-length s ] [ 0 ] [
                s/raw-slice s start n
            ] [ raise create-sin 'range 's/slice reduce [ start n ] ]
        ] [ raise create-sin 'type 's/slice reduce [ start n ] ]
    ] [ raise create-sin 'type 's/slice s ]
]

s/span: func [s start end] [
    either s/raw-string? s [
        either either s/raw-int? start [ s/raw-int? end ] [ 0 ] [
            either either either >= start 0 [ <= start end ] [ 0 ] [ <= end s/raw-length s ] [ 0 ] [
                s/raw-slice s start - end start
            ] [ raise create-sin 'range 's/span reduce [ start end ] ]
        ] [ raise create-sin 'type 's/span reduce [ start end ] ]
    ] [ raise create-sin 'type 's/span s ]
]

s/scan-set: func [s i set] [
    either either s/raw-string? s [ s/raw-string? set ] [ 0 ] [
        either s/raw-int? i [
            s/raw-scan-set s either < i 0 [ 0 ] [ either > i s/raw-length s [ s/raw-length s ] [ i ] ] set
        ] [ raise create-sin 'type 's/scan-set i ]
    ] [ raise create-sin 'type 's/scan-set either s/raw-string? s [ set ] [ s ] ]
]

;; s/from-int: the digits are produced from the NEGATED value (n <= 0), so the
;; most negative integer needs no positive counterpart. At most 19 frames.
s/raw-digits: func [n] [
    either < n -9 [
        s/+ s/raw-digits / n 10 mk-string reduce [ - 48 - n * 10 / n 10 ]
    ] [ mk-string reduce [ - 48 n ] ]
]
s/from-int: func [n] [
    either s/raw-int? n [
        either < n 0 [ s/+ "-" s/raw-digits n ] [ s/raw-digits - 0 n ]
    ] [ raise create-sin 'type 's/from-int n ]
]
]
