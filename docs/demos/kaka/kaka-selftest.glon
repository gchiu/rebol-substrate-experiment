;; demos/kaka/kaka-selftest.glon -- lean deterministic Glon rule self-test.
;; Dispatched by the kaka-selftest event; the C and WASM harnesses read the
;; emitted PASS/FAIL text. Kept deliberately small: the loader heap is tight and
;; the exhaustive D12S.2 direction/species/rolling assertions live in the C
;; harness (kaka_wave_tests.c / kaka_damage_tests.c), which need no loader code.
[
fails: 0

test-rules: func [] [
    ;; 1. ordinary berry diverts a kaka (never damages it); +10
    reset
    k: ts-claim K_KAKA
    block-set! k F_STATE KS_EAT  block-set! k F_TARGET 0
    block-set! k F_X 200  block-set! k F_Y 300
    b: ts-claim K_BERRY
    block-set! b F_X 200  block-set! b F_Y 300  block-set! b F_VY -9  block-set! b F_A 0
    berry-hit b 0
    either = block-at k F_STATE KS_DIVERT [ none ] [ fails: + fails 1 ]
    either = ts-count K_KAKA 1 [ none ] [ fails: + fails 1 ]
    ;; 2. Glon berry powers a kaka; it expires; a powered kaka zaps a pest
    reset
    k: ts-claim K_KAKA
    block-set! k F_STATE KS_SWEEP  block-set! k F_X 200  block-set! k F_Y 200
    g: ts-claim K_BERRY
    block-set! g F_X 200  block-set! g F_Y 200  block-set! g F_A 1
    berry-hit g 0
    either = block-at k F_STATE KS_MUTANT [ none ] [ fails: + fails 1 ]
    either > block-at k F_B tick [ none ] [ fails: + fails 1 ]
    block-set! k F_B -1  kaka-mutant k
    either = block-at k F_STATE KS_MUTANT [ fails: + fails 1 ] [ none ]
    reset
    k: ts-claim K_KAKA
    block-set! k F_STATE KS_MUTANT  block-set! k F_B + tick 540
    block-set! k F_X 300  block-set! k F_Y 320
    r: ts-claim K_RAT
    block-set! r F_X 305  block-set! r F_Y 330
    kaka-mutant k
    either = block-at r F_STATE 9 [ none ] [ fails: + fails 1 ]
    either = score 25 [ none ] [ fails: + fails 1 ]
    ;; 3. ROCK fires in facing direction; kills a 1-hp rat; +20; no tree damage
    reset
    block-set! rangi F_X  300  block-set! rangi F_D  1  krock: 1  block-set! rangi F_TARGET  0
    fire-rock
    either > block-at ts-t 3 F_VY 0 [ none ] [ fails: + fails 1 ]
    reset
    block-set! rangi F_X  300  block-set! rangi F_D  -1  krock: 1  block-set! rangi F_TARGET  0
    fire-rock
    either < block-at ts-t 3 F_VY 0 [ none ] [ fails: + fails 1 ]
    reset
    r: ts-claim K_RAT
    block-set! r F_X 330  block-set! r F_Y 330  block-set! r F_B 1  block-set! r F_A 0  block-set! r F_VY 2
    block-set! rangi F_X  300  block-set! rangi F_D  1  krock: 1  block-set! rangi F_TARGET  0
    fire-rock  rock-step ts-t 4
    either = block-at r F_STATE 9 [ none ] [ fails: + fails 1 ]
    either = score 20 [ none ] [ fails: + fails 1 ]
    reset
    b: ts-claim K_ROCK
    block-set! b F_X 200  block-set! b F_Y 330  block-set! b F_VY 12
    rock-step b  rock-step b  rock-step b
    either = block-at ts-t 0 F_A 100 [ none ] [ fails: + fails 1 ]
    ;; 4. a berry never damages a pest; a pest that passes the ranger marches on
    reset
    r: ts-claim K_RAT
    block-set! r F_X 200  block-set! r F_Y 330  block-set! r F_B 1  block-set! r F_A 0  block-set! r F_VY 2
    b: ts-claim K_BERRY
    block-set! b F_X 200  block-set! b F_Y 330  block-set! b F_A 0
    berry-step b
    either = block-at r F_B 1 [ none ] [ fails: + fails 1 ]
    either = block-at r F_STATE 0 [ none ] [ fails: + fails 1 ]
    x0: block-at r F_X
    block-set! rangi F_X  100  rat-step r
    either < block-at r F_X x0 [ none ] [ fails: + fails 1 ]
    either = ts-count K_RAT 1 [ none ] [ fails: + fails 1 ]
    ;; 5. restart clears pests/rocks/berries and resets progress + camera
    r: ts-claim K_RAT  b: ts-claim K_ROCK  g: ts-claim K_BERRY
    block-set! rangi F_X  5000  dist: 5000  next-tree-x: 6000
    reset
    either = ts-count K_RAT 0 [ none ] [ fails: + fails 1 ]
    either = ts-count K_ROCK 0 [ none ] [ fails: + fails 1 ]
    either = ts-count K_BERRY 0 [ none ] [ fails: + fails 1 ]
    either = block-at rangi F_X 480 [ none ] [ fails: + fails 1 ]
    either = dist 480 [ none ] [ fails: + fails 1 ]
    either = cam 0 [ none ] [ fails: + fails 1 ]
    either = trees-live 3 [ none ] [ fails: + fails 1 ]
]

test-camera: func [] [
    ;; 6. rightward camera: the ranger sits ~35% from the left (more ahead than
    ;; behind), and moving across the old midpoint never reverses the invasion.
    reset
    view-w: 1000  block-set! rangi F_X  3000
    rangi-step
    either = cam 2650 [ none ] [ fails: + fails 1 ]
    either > - block-at rangi F_X cam - cam view-w block-at rangi F_X [ none ] [ fails: + fails 1 ]
    either > block-at rangi F_X 1000 [ none ] [ fails: + fails 1 ]
    ;; 7. same world, different viewport: view-w never relocates actors
    reset
    spawn-pest
    x0: block-at ts-t 3 F_X
    t0: block-at ts-t 0 F_X
    view-w: 1056  rangi-step
    either = block-at ts-t 3 F_X x0 [ none ] [ fails: + fails 1 ]
    either = block-at ts-t 0 F_X t0 [ none ] [ fails: + fails 1 ]
    view-w: 640  rangi-step
    either = block-at ts-t 3 F_X x0 [ none ] [ fails: + fails 1 ]
    ;; 8. pest species HP: stoat needs two rocks, possum five
    reset
    r: ts-claim K_RAT
    block-set! r F_A 1  block-set! r F_B 2
    damage-pest r 1
    either = block-at r F_B 1 [ none ] [ fails: + fails 1 ]
    either = block-at r F_STATE 0 [ none ] [ fails: + fails 1 ]
    damage-pest r 1
    either = block-at r F_STATE 9 [ none ] [ fails: + fails 1 ]
    either = score 35 [ none ] [ fails: + fails 1 ]
    reset
    r: ts-claim K_RAT
    block-set! r F_A 2  block-set! r F_B 5
    damage-pest r 1  damage-pest r 1  damage-pest r 1  damage-pest r 1
    either = block-at r F_STATE 0 [ none ] [ fails: + fails 1 ]
    damage-pest r 1
    either = block-at r F_STATE 9 [ none ] [ fails: + fails 1 ]
    either = score 60 [ none ] [ fails: + fails 1 ]
]

selftest: func [] [
    fails: 0
    reset
    test-rules
    test-camera
    reset
    e-clear
    either = fails 0 [ e-text "KAKA-SELFTEST PASS" ] [ e-text "KAKA-SELFTEST FAIL " e-int fails ]
    e-finish
]
]
