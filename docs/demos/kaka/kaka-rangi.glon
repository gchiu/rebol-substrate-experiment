;; kaka-rangi.glon -- Rangi, the ONE persistent player actor.
;;
;; Ownership rule: ONLY this file mutates the Rangi actor tuple. Everything else
;; sends semantic input (host) or a contact request (pests); Rangi decides the
;; consequence. The renderer only reads the actor's semantic state.

;; Rangi lives in the RESERVED top tuple slot (NTS-1) so it never competes with
;; pests for shared slots and never shifts their slot indices. `reset` creates it
;; in place (no allocation).

;; camera derives from the actor; it never owns it. Single order: clamp the
;; actor inside the visible left margin, then derive cam from the clamped x
;; (screenX = x - cam = min(x, 35% * view-w)).
keep-visible: func [] [
    ;; finite SKULL_CAVE chamber [60,1740]; the forest keeps only the left margin
    either > block-at rangi F_E 0 [
        either < block-at rangi F_X 60 [ block-set! rangi F_X 60 ] [ none ]
        either > block-at rangi F_X 1740 [ block-set! rangi F_X 1740 ] [ none ]
    ] [
        either < block-at rangi F_X PLAYER_LEFT_MARGIN [ block-set! rangi F_X PLAYER_LEFT_MARGIN ] [ none ]
    ]
    t: - block-at rangi F_X / * view-w 35 100
    cam: either < t 0 [ 0 ] [ t ]
    ;; stop the camera at the cave's right wall (nothing scrolls past 1800)
    either > block-at rangi F_E 0 [
        either > cam - 1800 view-w [ cam: - 1800 view-w ] [ none ]
    ] [ none ]
    either < cam 0 [ cam: 0 ] [ none ]
]

;; canonical hit consequence, owned by Rangi (pests only request it).
lose-life: func [] [
    either < block-at rangi F_B 1 [ none ] [
        block-set! rangi F_B - block-at rangi F_B 1
        ;; on the final life, become DEAD and settle on the ground: no jump state
        ;; survives, so a death in mid-air cannot cause posthumous drift
        either < block-at rangi F_B 1 [
            block-set! rangi F_B 0
            block-set! rangi F_STATE 1
            block-set! rangi F_VY 0
            gnd: 330
            either > block-at rangi F_E 0 [ gnd: 352 ] [ none ]
            block-set! rangi F_Y gnd
        ] [ none ]
        block-set! rangi F_A INVULN_TICKS
    ]
]
hit-ranger: func [] [
    block-set! rangi F_C 0
    either > block-at rangi F_A 0 [ none ] [
        block-set! rangi F_X - block-at rangi F_X 14
        keep-visible
        lose-life
    ]
]



;; one deterministic Rangi update: pending-hit resolution, facing, horizontal
;; movement, jump arc, invuln/cooldown ticks, camera derivation.
rangi-step: func [] [
    either = block-at rangi F_STATE 1 [ none ] [
        ;; FOREST-only: contact request, rock cooldown, invulnerability blink.
        either = block-at rangi F_E 0 [
            either > block-at rangi F_C 0 [ hit-ranger ] [ none ]
            either > block-at rangi F_TARGET 0 [ block-set! rangi F_TARGET - block-at rangi F_TARGET 1 ] [ none ]
            either > block-at rangi F_A 0 [ block-set! rangi F_A - block-at rangi F_A 1 ] [ none ]
        ] [ none ]
        dx: - kr kl
        either > kr kl [ block-set! rangi F_D 1 ] [ either > kl kr [ block-set! rangi F_D -1 ] [ none ] ]
        either = dx 0 [ none ] [ block-set! rangi F_X + block-at rangi F_X * dx 10 ]
        gnd: 330
        pt: 280
        either > block-at rangi F_E 0 [ gnd: 352  pt: 182 ] [ none ]
        ;; BERRY (kf) drops a nearby BUNDLED rope (cave). F_TARGET holds the rope
        ;; bits: 1=helmet rope, 2=phone rope, 4=key rope (0 = bundled).
        either = block-at rangi F_E 1 [
            either = kf 1 [
                either < abs - block-at rangi F_X 1120 50 [
                    either = 0 mod block-at rangi F_TARGET 2 [ block-set! rangi F_TARGET + block-at rangi F_TARGET 1 ] [ none ]
                ] [ none ]
                either < abs - block-at rangi F_X 1300 50 [
                    either = 0 mod / block-at rangi F_TARGET 2 2 [ block-set! rangi F_TARGET + block-at rangi F_TARGET 2 ] [ none ]
                ] [ none ]
                either < abs - block-at rangi F_X 1480 50 [
                    either = 0 mod / block-at rangi F_TARGET 4 2 [ block-set! rangi F_TARGET + block-at rangi F_TARGET 4 ] [ none ]
                ] [ none ]
            ] [ none ]
        ] [ none ]
        ;; F_A doubles as the CLIMB flag in the cave (invuln in the forest).
        either = block-at rangi F_E 1 [
            block-set! rangi F_A 0
            either < block-at rangi F_Y 360 [
                either = 1 mod block-at rangi F_TARGET 2 [ either < abs - block-at rangi F_X 1120 24 [ block-set! rangi F_A 1 ] [ none ] ] [ none ]
                either = 1 mod / block-at rangi F_TARGET 2 2 [ either < abs - block-at rangi F_X 1300 24 [ block-set! rangi F_A 1 ] [ none ] ] [ none ]
                either = 1 mod / block-at rangi F_TARGET 4 2 [ either < abs - block-at rangi F_X 1480 24 [ block-set! rangi F_A 1 ] [ none ] ] [ none ]
            ] [ none ]
        ] [ none ]
        ;; `cl` = actually climbing (cave AND F_A set); F_A is invuln in forest.
        cl: 0
        either = block-at rangi F_E 1 [ either = block-at rangi F_A 1 [ cl: 1 ] [ none ] ] [ none ]
        either = cl 1 [
            ;; climbing a dropped rope: UP/DOWN move, horizontal detaches, and no
            ;; jump state may survive the climb.
            block-set! rangi F_VY 0
            either > ku 0 [ block-set! rangi F_Y - block-at rangi F_Y 8 ] [ none ]
            either > kd 0 [ block-set! rangi F_Y + block-at rangi F_Y 8 ] [ none ]
            either < block-at rangi F_Y 182 [ block-set! rangi F_Y 182 ] [ none ]
            either > block-at rangi F_Y 352 [ block-set! rangi F_Y 352 ] [ none ]
            either > kr kl [ block-set! rangi F_A 0 ] [ either > kl kr [ block-set! rangi F_A 0 ] [ none ] ]
        ] [
            either > ku 0 [
                either = block-at rangi F_VY 0 [
                    either = block-at rangi F_Y gnd [ block-set! rangi F_VY 22 ] [ none ]
                ] [ none ]
            ] [ none ]
            either > kd 0 [ either > block-at rangi F_VY 2 [ block-set! rangi F_VY - block-at rangi F_VY 2 ] [ block-set! rangi F_VY 0 ] ] [ none ]
            either > block-at rangi F_VY 0 [
                p: - 22 block-at rangi F_VY
                b: - gnd / * p - 22 p 2
                dx: gnd
                either > block-at rangi F_E 0 [
                    either <= b + pt 5 [
                        either < abs - block-at rangi F_X 1120 44 [ dx: pt ] [ none ]
                        either < abs - block-at rangi F_X 1300 44 [ dx: pt ] [ none ]
                        either < abs - block-at rangi F_X 1480 44 [ dx: pt ] [ none ]
                    ] [ none ]
                ] [ none ]
                either < b dx [
                    block-set! rangi F_Y b
                    block-set! rangi F_VY - block-at rangi F_VY 1
                ] [
                    either > block-at rangi F_VY 11 [
                        block-set! rangi F_Y b
                        block-set! rangi F_VY - block-at rangi F_VY 1
                    ] [ block-set! rangi F_Y dx  block-set! rangi F_VY 0 ]
                ]
            ] [
                dx: gnd
                either > block-at rangi F_E 0 [
                    either <= block-at rangi F_Y + pt 5 [
                        either < abs - block-at rangi F_X 1120 44 [ dx: pt ] [ none ]
                        either < abs - block-at rangi F_X 1300 44 [ dx: pt ] [ none ]
                        either < abs - block-at rangi F_X 1480 44 [ dx: pt ] [ none ]
                    ] [ none ]
                ] [ none ]
                block-set! rangi F_Y dx
            ]
        ]
        ;; relic choice: Rangi visibly at/on the relic (standing OR on the rope).
        ;; Generous zone from the cave art: pedestals span +/-42 (84 wide), the
        ;; relic sits at y~185, the climb apex pt=182, the floor at 352. Horizontal
        ;; +/-64 (relics 180 apart -> zones never overlap); vertical band 130..260
        ;; (relic height + modest above/below; excludes the floor and far above).
        either = block-at rangi F_E 1 [
            block-set! rangi F_C 0
            either > block-at rangi F_Y 130 [
                either < block-at rangi F_Y 260 [
                    either < abs - block-at rangi F_X 1120 64 [ block-set! rangi F_C 1 ] [ none ]
                    either < abs - block-at rangi F_X 1300 64 [ block-set! rangi F_C 2 ] [ none ]
                    either < abs - block-at rangi F_X 1480 64 [ block-set! rangi F_C 3 ] [ none ]
                ] [ none ]
            ] [ none ]
            either = krock 1 [
                either > block-at rangi F_C 0 [ block-set! rangi F_E + block-at rangi F_C 1 ] [ none ]
            ] [ none ]
        ] [ none ]
        either > block-at rangi F_X dist [ dist: block-at rangi F_X ] [ none ]
        either = block-at rangi F_E 0 [
            either >= dist SKULL_X [
                block-set! rangi F_E 1
                block-set! rangi F_X 200
                block-set! rangi F_Y 352
                block-set! rangi F_VY 0
                block-set! rangi F_C 0
                block-set! rangi F_TARGET 0
                block-set! rangi F_A 0
                cam: 0
            ] [ none ]
        ] [ none ]
        keep-visible
    ]
]

;; ROCK: Rangi consumes the ROCK input and only then does the world spawn the
;; projectile (after Rangi validates cooldown and pool capacity).
fire-rock: func [] [
    either = block-at rangi F_STATE 0 [
    either = krock 1 [
        either < block-at rangi F_TARGET 1 [
            either < ts-count K_ROCK 5 [
                b: ts-claim K_ROCK
                either = b none [ none ] [
                    block-set! b F_X + block-at rangi F_X * block-at rangi F_D 18
                    ;; launch on a FIXED combat line (grounded chest height), so a
                    ;; throw made mid-jump engages ground pests exactly like a
                    ;; grounded throw. ROCK must not depend on vertical position.
                    block-set! b F_Y 328
                    block-set! b F_VY * block-at rangi F_D 12
                    block-set! b F_A + block-at rangi F_X * block-at rangi F_D 18
                    block-set! rangi F_TARGET 6
                ]
            ] [ none ]
        ] [ none ]
    ] [ none ]
    ] [ none ]
]

;; semantic render op `P <pose> <x> <y> <dir>`; pose/pos/facing come only from
;; the actor. 0 idle / 1 run-a / 2 run-b / 3 jump / 4 hit / 5 fallen.
draw-player: func [] [
    either > + over block-at rangi F_STATE 0 [
        p-byte 80 p-num 5 p-num block-at rangi F_X p-num 330 p-num block-at rangi F_D p-eol
    ] [
        p: either > block-at rangi F_VY 0 [ 3 ] [
            either = 0 - kr kl [ 0 ] [ either < mod tick 12 6 [ 1 ] [ 2 ] ]
        ]
        either = block-at rangi F_E 0 [
            either > block-at rangi F_A 0 [ either < mod tick 8 4 [ p: 4 ] [ none ] ] [ none ]
        ] [ none ]
        either = block-at rangi F_E 1 [
            either = block-at rangi F_A 1 [ p: 6 ] [ none ]
        ] [ none ]
        p-byte 80 p-num p p-num block-at rangi F_X p-num block-at rangi F_Y p-num block-at rangi F_D p-eol
    ]
]
