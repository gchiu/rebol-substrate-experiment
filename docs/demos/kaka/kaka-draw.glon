;; demos/kaka/kaka-draw.glon -- rendering for Attack of the Mutant Kaka.
;; Split out of kaka.glon to stay within the 16 KiB Glon source buffer; the
;; game state and rules live in kaka.glon (loaded first).
[
;; ---- lives, laser hazard and high score ----------------------------------
;; Split out of kaka.glon to stay within the 16 KiB source buffer; the game
;; state and globals live in kaka.glon (loaded first), functions resolve at call.
imin: func [a b] [ either < a b [ a ] [ b ] ]
imax: func [a b] [ either > a b [ a ] [ b ] ]
;; Does the beam (ax,ay)-(bx,by) touch the axis-aligned box
;; [x0,y0,x1,y1]? Integer separating-axis test, no division: overlap on X, on
;; Y, and on the beam normal. Used for the powered kaka's ocular laser only.
;; (Kept to 13 bindings: an activation context holds at most R0S1_CTX_CAP=16.)
seg-rect?: func [ax ay bx by x0 y0 x1 y1] [
    dx: - bx ax
    dy: - by ay
    p: - * dx ay * dy ax
    rl: imin imin - * dx y0 * dy x0 - * dx y0 * dy x1 imin - * dx y1 * dy x0 - * dx y1 * dy x1
    rh: imax imax - * dx y0 * dy x0 - * dx y0 * dy x1 imax - * dx y1 * dy x0 - * dx y1 * dy x1
    either > imin ax bx x1 [ 0 ] [
    either < imax ax bx x0 [ 0 ] [
    either > imin ay by y1 [ 0 ] [
    either < imax ay by y0 [ 0 ] [
        either < p rl [ 0 ] [ either > p rh [ 0 ] [ 1 ] ]
    ] ] ] ]
]
;; The ranger's hitbox in world coordinates (matches draw-player: head + body).
laser-hits-player?: func [] [
    seg-rect? laser-ox laser-oy laser-x laser-y - px 10 - py 14 + px 10 + py 22
]
respawn: func [] [ px: 320 py: 330 cam: 0 invuln: INVULN_TICKS ]
;; One life, exactly: a non-terminal hit respawns with brief invulnerability;
;; the last life is terminal (over). `over` gates all further loss.
lose-life: func [] [
    either < lives 1 [ none ] [
        lives: - lives 1
        either < lives 1 [ lives: 0 ] [ respawn ]
    ]
]
;; Called by a mutant kaka each tick it holds a beam on its target rat. A
;; crossing during invulnerability or after game over changes nothing.
laser-hazard: func [] [
    either = over 0 [
        either < invuln 1 [ either laser-hits-player? [ lose-life ] [ none ] ] [ none ]
    ] [ none ]
]
;; The high score is Glon's: it only ever rises from the current score.
update-high: func [] [ either > score highscore [ highscore: score ] [ none ] ]

;; ---- kaka flight: velocity + bounded steering gives curved bird paths -----
;; Each bird carries its own x/y velocity (F_VY/F_E). Every tick it steers one
;; bounded step toward a phase waypoint, so heading changes lag the target and
;; the path banks rather than drawing straight segments. Per-bird id variation
;; and the tick counter keep individual birds distinct. All of it is Glon.
KSPD: 6
SACC: 2
SNEG: -2
steer: func [v d] [
    e: - d v
    either > e SACC [ + v SACC ] [ either < e SNEG [ - v SACC ] [ d ] ]
]
k-move: func [t wx wy sx sy] [
    vx: steer block-at t F_VY * sign - wx block-at t F_X sx
    vy: steer block-at t F_E * sign - wy block-at t F_Y sy
    block-set! t F_VY vx
    block-set! t F_E vy
    block-set! t F_X + block-at t F_X vx
    block-set! t F_Y + block-at t F_Y vy
]
kaka-pick: func [t] [ kp 0 t ]
;; Pick the first live tree starting from the kaka's id-derived offset, wrapping
;; around. Distinct ids therefore spread across the live trees instead of every
;; kaka piling onto the lowest-index tree (which made damage march 0 -> 1 -> 2).
kp: func [n t] [
    either < n NTS [
        i: mod + mod block-at t F_ID NTS n NTS
        either = ts-k i K_TREE [
            either > block-at ts-t i F_A 0 [ block-set! t F_TARGET i ] [ kp + n 1 t ]
        ] [ kp + n 1 t ]
    ] [ block-set! t F_STATE KS_LEAVE ]
]
;; presentation only: snap a gnawing rat to the trunk and start its gnaw state.
;; rat-gnaw still applies the unchanged damage after this.
rat-gnaw-prep: func [i t] [
    either < i NTS [
        either = ts-k i K_TREE [
            either < abs - block-at ts-t i F_X block-at t F_X 44 [
                either = over 1 [ none ] [
                    block-set! t F_X - block-at ts-t i F_X 12
                    block-set! t F_E block-at ts-t i F_X
                    block-set! t F_C GNAW_TICKS
                ]
            ] [ rat-gnaw-prep + i 1 t ]
        ] [ rat-gnaw-prep + i 1 t ]
    ] [ none ]
]
spawn-kaka: func [] [
    t: ts-claim K_KAKA
    either = t none [ none ] [
        block-set! t F_X + 60 mod rnd 520
        block-set! t F_Y 20
        block-set! t F_STATE KS_SWEEP
        block-set! t F_D either = 0 mod block-at t F_ID 2 [ 1 ] [ -1 ]
        block-set! t F_VY * block-at t F_D 3
        block-set! t F_E 2
        kaka-pick t
    ]
]
kaka-step: func [t] [
    s: block-at t F_STATE
    either = s KS_MUTANT [ kaka-mutant t ] [
    either = s KS_DIVERT [ kaka-divert t ] [
    either = s KS_EAT [ kaka-eat t ] [
    either = s KS_LEAVE [ kaka-leave t ] [
    either = s KS_SWOOP [ kaka-swoop t ] [ kaka-sweep t ] ] ] ] ]
]
;; entry + approach: a shallow gliding arc across to the tree (broad curve)
kaka-sweep: func [t] [
    ti: block-at t F_TARGET
    tx: block-at ts-t ti F_X
    wy: + 74 mod block-at t F_ID 36
    k-move t tx wy 6 3
    either < abs - block-at t F_X tx 24 [ block-set! t F_STATE KS_SWOOP ] [ none ]
]
;; steeper dive onto the canopy (steering rounds the turn into a bank)
kaka-swoop: func [t] [
    ti: block-at t F_TARGET
    tx: block-at ts-t ti F_X
    k-move t tx 250 3 7
    either > block-at t F_Y 242 [
        block-set! t F_STATE KS_EAT
        block-set! t F_A 0
    ] [ none ]
]
kaka-eat: func [t] [
    ti: block-at t F_TARGET
    either < block-at ts-t ti F_A 1 [ kaka-pick t ] [
        tx: block-at ts-t ti F_X
        k-move t tx + 250 mod tick 8 3 2
        a: + block-at t F_A 1
        block-set! t F_A a
        either = 0 mod a 36 [ either = over 1 [ none ] [ damage-tree ti 10 ] ] [ none ]
        ;; fed enough: pull away and leave (kaka-leave curves up and out)
        either > a 108 [ block-set! t F_STATE KS_LEAVE ] [ none ]
    ]
]
kaka-leave: func [t] [
    k-move t either > block-at t F_D 0 [ 780 ] [ -140 ] 16 7 4
    either > block-at t F_X 700 [ ts-free t ] [
        either < block-at t F_X -70 [ ts-free t ] [ none ]
    ]
]
kaka-divert: func [t] [
    either = block-at t F_C 0 [ drop-poop t ] [ none ]
    k-move t + block-at t F_X * block-at t F_D 180 -50 6 5
    either < block-at t F_Y -24 [ ts-free t ] [ none ]
]
drop-poop: func [t] [
    p: ts-claim K_POOP
    either = p none [ none ] [
        block-set! p F_X block-at t F_X
        block-set! p F_Y block-at t F_Y
        block-set! p F_VY 3
        block-set! t F_C 1
        poops: + poops 1
    ]
]
nearest-rat: func [t] [ nr 0 none 99999 t ]
nr: func [i best bd t] [
    either < i NTS [
        either = ts-k i K_RAT [
            d: + abs - block-at ts-t i F_X block-at t F_X abs - block-at ts-t i F_Y block-at t F_Y
            either < d bd [ nr + i 1 ts-t i d t ] [ nr + i 1 best bd t ]
        ] [ nr + i 1 best bd t ]
    ] [ best ]
]
kaka-mutant: func [t] [
    either > tick block-at t F_B [ block-set! t F_STATE KS_LEAVE  laser: -99 ] [
        r: nearest-rat t
        either = r none [
            laser: -99
            k-move t block-at t F_X 130 0 4
        ] [
            rx: block-at r F_X
            ry: block-at r F_Y
            k-move t rx ry 6 6
            ;; The ocular laser runs from the kaka's eye to its target rat for
            ;; as long as it is targeting. It only ever aims at a rat; the
            ;; ranger is hit only if the actual beam segment crosses its hitbox.
            laser: tick
            laser-ox: block-at t F_X
            laser-oy: - block-at t F_Y 18
            laser-x: rx
            laser-y: ry
            laser-hazard
            either < + abs - block-at t F_X rx abs - block-at t F_Y ry 40 [
                either = over 1 [ none ] [
                    ts-free r
                    score: + score 25
                    mutant-kills: + mutant-kills 1
                ]
            ] [ none ]
        ]
    ]
]

;; ---- rendering (Glon -> compact Canvas script; JS only paints) -----------
;; NZ beech (mast) tree. A visible forked trunk with a root flare carries an
;; irregular crown of overlapping fine-foliage clumps and small pale beech seed
;; -- never a round lollipop canopy. The health `h` (F_A, 0..100) drives five
;; readable stages: intact, partly shredded, badly shredded, bare branches, and
;; dead. Lives purely in Glon; kaka/rat damage reads as a thinner crown and more
;; exposed branch.
tree-art: func [t] [
    x: block-at t F_X
    h: block-at t F_A
    either < h 1 [
        p-rect - x 5 306 10 54 2
        p-line x 306 - x 17 286 2 2
        p-line x 306 + x 15 282 2 2
    ] [
        p-rect - x 6 300 12 60 8
        p-tri - x 10 360 + x 10 360 x 336 8
        p-line x 300 - x 30 250 3 8
        p-line x 300 + x 27 244 3 8
        p-line x 300 - x 6 228 2 8
        p-line x 300 + x 8 224 2 8
        either > h 70 [
            p-circ - x 16 244 14 9
            p-circ + x 14 236 14 4
            p-circ x 226 13 9
            p-circ - x 28 254 10 4
            p-circ + x 28 248 10 13
            p-circ x 252 10 13
            p-circ - x 6 232 11 4
            p-circ + x 8 224 10 9
            p-circ x 240 12 4
            p-circ - x 10 238 2 1
            p-circ + x 12 232 2 1
            p-circ x 250 2 1
            p-circ - x 22 252 1 1
        ] [
            either > h 40 [
                p-circ - x 18 248 11 9
                p-circ + x 16 240 10 4
                p-circ x 230 9 13
                p-circ + x 26 250 7 4
                p-circ - x 26 254 7 9
                p-circ x 248 7 13
                p-circ - x 12 244 2 1
                p-circ + x 8 238 1 1
            ] [
                either > h 10 [
                    p-circ - x 14 248 8 9
                    p-circ + x 12 240 7 4
                    p-circ x 232 6 13
                ] [
                    p-line - x 24 250 - x 34 236 2 8
                    p-line + x 22 244 + x 34 232 2 8
                    p-line - x 6 230 - x 14 218 2 8
                ]
            ]
        ]
    ]
]
;; ---- sprite actors (Glon names the frame; the host paints it) -------------
;; `S id x y dir` -- id selects a frame on a host-owned sheet, dir is +1/-1 for
;; facing. Glon chooses id from actor kind + state + a deterministic flap/run
;; cycle; it never sends bitmap bytes and never inspects image data.
p-spr: func [id x y d] [ p-byte 83 p-num id p-num x p-num y p-num d p-eol ]

spr-kaka: func [t] [
    x: block-at t F_X
    y: block-at t F_Y
    d: either < block-at t F_VY 0 [ -1 ] [ 1 ]
    st: block-at t F_STATE
    either = st KS_MUTANT [
        either < - tick laser 9 [ p-spr 12 x y d ] [
            p-spr either < mod tick 10 5 [ 10 ] [ 11 ] x y d
        ]
    ] [
    either = st KS_SWOOP [ p-spr 3 x y d ] [
    either = st KS_EAT [ p-spr 2 x y d ] [
    either = st KS_DIVERT [ p-spr 0 x y d ] [
    either = st KS_LEAVE [ p-spr 1 x y d ] [
        p-spr either < mod tick 12 6 [ 0 ] [ 1 ] x y d
    ] ] ] ] ]
]
spr-rat: func [t] [
    x: block-at t F_X
    y: block-at t F_Y
    either > block-at t F_C 0 [
        p-spr 22 x - y mod tick 6 block-at t F_A
    ] [
        p-spr either < mod tick 8 4 [ 20 ] [ 21 ] x y block-at t F_A
    ]
]
;; A rat chewing at a trunk: a few bark flecks and a brief hit flash at the
;; gnawed tree, so it is obvious which tree just lost health.
gnaw-cue: func [t] [
    either > block-at t F_C 0 [
        gx: block-at t F_E
        p-circ - gx 6 - 330 mod tick 5 2 8
        p-circ + gx 4 + 334 mod tick 7 2 8
        p-circ + gx 10 + 326 mod tick 6 2 8
        either > block-at t F_C - GNAW_TICKS 6 [ p-line gx 296 gx 344 2 15 ] [ none ]
    ] [ none ]
]
spr-berry: func [t] [
    x: block-at t F_X
    y: block-at t F_Y
    either = block-at t F_A 1 [ p-spr 31 x y 1 ] [ p-spr 30 x y 1 ]
]
actor-art: func [i] [
    either < i NTS [
        k: ts-k i
        either = k K_KAKA [ spr-kaka ts-t i ] [
        either = k K_RAT [ spr-rat ts-t i  gnaw-cue ts-t i ] [
        either = k K_BERRY [ spr-berry ts-t i ] [
        either = k K_PICK [ p-spr 31 block-at ts-t i F_X block-at ts-t i F_Y 1 ] [
        either = k K_POOP [ p-spr 32 block-at ts-t i F_X block-at ts-t i F_Y 1 ] [ none ] ] ] ] ]
        actor-art + i 1
    ] [ none ]
]
;; Camera markers: `p-cam 66` makes the host paint the three background
;; parallax layers (sky/hills, native bush, orchard) and scroll the gameplay
;; plane; `p-cam 70` paints the foreground foliage after the actors. Only the
;; camera scalar crosses the boundary -- the PNG bytes never enter Glon and no
;; image is reproduced as drawing primitives.
p-cam: func [b] [ p-byte b p-num cam p-eol ]
draw-trees: func [i] [
    either < i NTS [
        either = ts-k i K_TREE [ tree-art ts-t i ] [ none ]
        draw-trees + i 1
    ] [ none ]
]
draw-player-solid: func [] [
    p-ell px 324 9 9 1
    p-rect - px 7 332 14 22 6
    p-tri px 332 + px 4 342 - px 4 342 8
    p-circ + px 8 - py 4 3 7
]
;; post-respawn invulnerability is shown by blinking the ranger (presentation
;; only; the rule lives in Glon state).
draw-player: func [] [
    either > invuln 0 [
        either < mod tick 8 4 [ draw-player-solid ] [ none ]
    ] [ draw-player-solid ]
]
;; The mutant's ocular beam, drawn from its eye to its target rat.
draw-laser: func [] [
    either > laser 0 [ p-line laser-ox laser-oy laser-x laser-y 2 14 ] [ none ]
]
render-canvas: func [] [
    p-clear
    p-cam 66
    draw-trees 0
    actor-art 0
    draw-laser
    draw-player
    p-cam 70
    p-finish
]

;; ---- HTML status (Glon builds it; JS writes the element) ------------------
render-status: func [] [
    e-clear
    e-text "<h1>Attack of the Mutant Kaka</h1>"
    e-text "<p class='tag'>Eco-Warriors of Karori, Unite!</p>"
    e-text "<p class='hud'>SCORE: " e-int score
    e-text "    Lives: " e-int lives
    e-text "    Trees: " e-int trees-live e-text "/" e-int NTREES
    e-text "    Habitat: " e-int tree-sum e-text "/" e-int * NTREES TREE_MAX
    e-text "    Glon Berries: " e-int berries
    e-text "    HIGH SCORE: " e-int highscore
    either > invuln 0 [ e-text "    <b class='invuln'>INVULNERABLE</b>" ] [ none ]
    either = over 1 [ e-text "    <b>GAME OVER</b>" ] [ none ]
    e-text "</p>"
    either = mutant-active 1 [
        e-text "<p class='mutant'>MUTANT KAKA &mdash; OCULAR LASERS ACTIVE ("
        e-int / mutant-left 60 e-text "s)</p>"
    ] [ e-text "<p class='muted'>Kaka are native wildlife: berries divert, lasers only zap rats.</p>" ]
    e-text "<p class='keys'>Arrow keys / WASD move &middot; Space fire berry &middot; G Mystery Glon Berry &middot; R restart</p>"
    ;; The host mirrors this numeric value into localStorage (small semantic
    ;; bridge); Glon owns the value and the comparison.
    e-text "<span id='kaka-hs' style='display:none'>" e-int highscore e-text "</span>"
    e-text "<span id='kaka-state' style='display:none'>"
    e-int tick e-text " " e-int score e-text " " e-int over e-text " " e-int berries e-text " "
    e-int px e-text " " e-int kl e-text " " e-int kr e-text " " e-int kf e-text " " e-int kg e-text " "
    e-int n-kaka e-text " " e-int n-rat e-text " "
    e-int mutant-active e-text " " e-int mutant-left e-text " " e-int py e-text " "
    e-int lives e-text " " e-int invuln e-text " " e-int highscore
    e-text "</span>"
    either = over 1 [
        e-text "<div class='kaka-gameover'><div class='kaka-go-title'>GAME OVER!!!</div>"
        e-text "<div class='kaka-go-sub'>THE FOREST HAS FALLEN</div>"
        e-text "<div class='kaka-go-line'>SCORE: " e-int score "</div>"
        e-text "<div class='kaka-go-line'>HIGH SCORE: " e-int highscore "</div>"
        e-text "<div class='kaka-go-again'>PRESS R TO PLAY AGAIN</div>"
        e-text "<button class='kaka-go-btn' data-glon-event='kaka-restart'>PLAY AGAIN</button>"
        e-text "</div>"
    ] [ none ]
    e-finish
]
render: func [] [ render-canvas render-status ]

]
