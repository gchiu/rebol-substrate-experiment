[ 















mk-string: masm 1 [
    DUP LIT 16 MOD SUB LIT SCRATCH_B !
    LIT SCRATCH_B @ @ LIT SCRATCH_F !
    LIT SCRATCH_F @ LIT 1 ADD LIT 15 ADD LIT 16 DIV LIT 16 MUL LIT GC_KIND_STRING CALL alloc LIT SCRATCH_C !
    LIT SCRATCH_F @ LIT SCRATCH_C @ !
    LIT 0 LIT SCRATCH_A !
  mk-loop:
    LIT SCRATCH_A @ LIT SCRATCH_F @ LT ZBRANCH mk-done
    LIT SCRATCH_B @ LIT 2 ADD LIT SCRATCH_A @ ADD @ LIT 16 DIV
    LIT SCRATCH_C @ LIT 1 ADD LIT SCRATCH_A @ ADD
    !
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_A !
    BRANCH mk-loop
  mk-done:
    LIT SCRATCH_C @ LIT T_STRING ADD ARITY 1 EXIT
]



str-eq: masm 2 [
    LIT SCRATCH_B !
    DUP LIT 16 MOD SUB LIT SCRATCH_A !
    LIT SCRATCH_B @ DUP LIT 16 MOD SUB LIT SCRATCH_B !
    LIT SCRATCH_A @ @ LIT SCRATCH_B @ @ EQ ZBRANCH str-eq-neq
    LIT SCRATCH_A @ @ LIT SCRATCH_F !
    LIT 0 LIT SCRATCH_E !
  str-eq-loop:
    LIT SCRATCH_E @ LIT SCRATCH_F @ LT ZBRANCH str-eq-yes
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_E @ ADD @
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_E @ ADD @
    EQ ZBRANCH str-eq-neq
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    BRANCH str-eq-loop
  str-eq-yes:
    INT 1 ARITY 1 EXIT
  str-eq-neq:
    INT 0 ARITY 1 EXIT
]


get: masm 1 [ CALL lookup ARITY 1 EXIT ]





lambda: func [spec body] [ func :spec :body ]
does:   func [body] [ lambda [] body ]


























emit-clear: masm [ LIT 0 LIT SCRATCH_E ! ARITY 0 EXIT ]
emit-byte: masm 1 [
    LIT SCRATCH_E @ LIT G1_OUT_DATA ADD !
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    ARITY 0 EXIT
]
emit-finish: masm [ LIT SCRATCH_E @ LIT G1_OUT ! LIT G1_OUT LIT T_BLOCK ADD ARITY 1 EXIT ]






vis-clear: masm [ LIT 0 LIT SCRATCH_D ! ARITY 0 EXIT ]
vis-byte: masm 1 [
    LIT SCRATCH_D @ LIT G1_VIS_DATA ADD !
    LIT SCRATCH_D @ LIT 1 ADD LIT SCRATCH_D !
    ARITY 0 EXIT
]
vis-text: masm 1 [
    DUP LIT 16 MOD SUB LIT SCRATCH_B !
    LIT 0 LIT SCRATCH_A !
    LIT SCRATCH_B @ @ LIT SCRATCH_F !
  vis-text-loop:
    LIT SCRATCH_A @ LIT SCRATCH_F @ LT ZBRANCH vis-text-done
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_A @ ADD @ LIT 16 MUL
    LIT G1_VIS_DATA LIT SCRATCH_D @ ADD
    !
    LIT SCRATCH_D @ LIT 1 ADD LIT SCRATCH_D !
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_A !
    BRANCH vis-text-loop
  vis-text-done:
    ARITY 0 EXIT
]
vis-finish: masm [ LIT SCRATCH_D @ LIT G1_VIS ! LIT G1_VIS LIT T_BLOCK ADD ARITY 1 EXIT ]
vis-int: func [n] [ either < n 0 [ vis-byte 45 vis-digits - 0 n ] [ vis-digits n ] ]
vis-digits: func [n] [
    either > n 9 [ vis-digits / n 10 ] [ none ]
    vis-byte + 48 - n * 10 / n 10
]


vis-box:  func [x y w h label] [ vis-byte 66 vis-byte 32 vis-int x vis-byte 32 vis-int y vis-byte 32 vis-int w vis-byte 32 vis-int h vis-byte 32 vis-text label vis-byte 10 ]
vis-line: func [x1 y1 x2 y2] [ vis-byte 76 vis-byte 32 vis-int x1 vis-byte 32 vis-int y1 vis-byte 32 vis-int x2 vis-byte 32 vis-int y2 vis-byte 10 ]
vis-dot:  func [id x y] [ vis-byte 68 vis-byte 32 vis-int id vis-byte 32 vis-int x vis-byte 32 vis-int y vis-byte 10 ]
vis-move: func [id x1 y1 x2 y2] [ vis-byte 77 vis-byte 32 vis-int id vis-byte 32 vis-int x1 vis-byte 32 vis-int y1 vis-byte 32 vis-int x2 vis-byte 32 vis-int y2 vis-byte 10 ]


block-len: masm 1 [ DUP LIT 16 MOD SUB @ LIT 16 MUL ARITY 1 EXIT ]
block-at: masm 2 [ LIT SCRATCH_B ! DUP LIT 16 MOD SUB LIT 2 ADD LIT SCRATCH_B @ LIT 16 DIV ADD @ ARITY 1 EXIT ]





select: func [rows key] [ select-at rows 0 block-len rows key ]
select-at: func [rows i n key] [
    either < i n [
        either = block-at block-at rows i 0 key [ block-at rows i ] [ select-at rows + i 1 n key ]
    ] [ none ]
]


emit-int: func [n] [ either < n 0 [ emit-byte 45 emit-digits - 0 n ] [ emit-digits n ] ]
emit-digits: func [n] [
    either > n 9 [ emit-digits / n 10 ] [ none ]
    emit-byte + 48 - n * 10 / n 10
]






emit-text: masm 1 [
    DUP LIT 16 MOD SUB LIT SCRATCH_B !
    LIT 0 LIT SCRATCH_A !
    LIT SCRATCH_B @ @ LIT SCRATCH_F !
  emit-text-loop:
    LIT SCRATCH_A @ LIT SCRATCH_F @ LT ZBRANCH emit-text-done
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_A @ ADD @ LIT 16 MUL
    LIT G1_OUT_DATA LIT SCRATCH_E @ ADD
    !
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_A !
    BRANCH emit-text-loop
  emit-text-done:
    ARITY 0 EXIT
]






h1-open:   "<h1>"
h1-close:  "</h1>"
h2-open:   "<h2>"
h2-close:  "</h2>"
p-open:    "<p>"
p-close:   "</p>"
catalog-open:  "<ul class='catalog'>"
catalog-close: "</ul>"
basket-list-open:  "<ul class='basket-list'>"
basket-list-close: "</ul>"
li-open:   "<li>"
li-close:  "</li>"
span-open:  "<span class='item'>"
span-close: "</span>"
qty-open:  "<span class='qty'>"
qty-close: "</span>"
btn-open:  "<button class='btn' data-glon-route='"
btn-mid:   "'>"
btn-close: "</button>"
event-open: "<button class='btn' data-glon-event='"
input-open: "<input class='search-input' type='text' placeholder='Search' data-glon-input='"
value-mid:  "' data-glon-value='"
panel-open:  "<div class='panel'>"
panel-close: "</div>"
search-open:  "<div class='search-row'>"
search-close: "</div>"
basket-open:  "<div class='basket'>"
basket-close: "</div>"
total-open:  "<p class='total'>"
total-close: "</p>"
meta-open:   "<p class='meta'>"
meta-close:  "</p>"
tagline-open:  "<p class='tagline'>"
tagline-close: "</p>"
nav-open:   "<p class='nav'>"
nav-close:  "</p>"
pre-open:   "<pre>"
pre-close:  "</pre>"
load-btn-open: "<button class='btn' data-glon-route='"
load-btn-mid:  "' data-glon-load='"







wrap: func [open close] [
    func [content] [ emit-text open do content emit-text close ]
]
heading: wrap h1-open h1-close
subhead: wrap h2-open h2-close
text:    wrap p-open p-close
tagline: wrap tagline-open tagline-close
meta:    wrap meta-open meta-close
pre:     wrap pre-open pre-close
link:    func [label route] [
    emit-text nav-open
    emit-text btn-open emit-text route emit-text btn-mid emit-text label emit-text btn-close
    emit-text nav-close
]



load-link: func [label route path] [
    emit-text nav-open
    emit-text load-btn-open emit-text route emit-text load-btn-mid emit-text path emit-text btn-mid
    emit-text label emit-text btn-close
    emit-text nav-close
]

button:  func [content event] [
    emit-text event-open emit-text event emit-text btn-mid do content emit-text btn-close
]

value-button: func [content event value] [
    emit-text event-open emit-text event emit-text value-mid emit-text value emit-text btn-mid
    do content emit-text btn-close
]



input:   func [name] [
    emit-text input-open emit-text name emit-text btn-mid
]






products: func [items] [ emit-text catalog-open each-product items emit-text catalog-close ]
each-product: func [items] [ emit-product-at items 0 block-len items ]
emit-product-at: func [items i n] [
    either < i n [
        emit-text li-open
        emit-text span-open emit-text get block-at items i emit-text span-close
        value-button [ emit-text "Add" ] "add-product" get block-at items i
        emit-text li-close
        emit-product-at items + i 1 n
    ] [ none ]
] 

























shop-loaded: 0
guide-loaded: 0
merchant-flow-loaded: 0
tuple-space-loaded: 0
always: 1          



shop-route: "shop"  shop-label: "Shop SPA"  shop-path: "demos/shop.glon"
guide-route: "guide"  guide-label: "Programmer's guide"  guide-path: "demos/guide.glon"
mf-route: "merchant-flow"  mf-label: "Multitasking / dataflow"  mf-path: "demos/merchant-flow.glon"
ts-route: "tuple-space"  ts-label: "Tuple space / dataflow"  ts-path: "demos/tuple-space.glon"

demos: [
    [shop-loaded          shop-route shop-label shop-path]
    [guide-loaded         guide-route guide-label guide-path]
    [merchant-flow-loaded mf-route   mf-label   mf-path]
    [tuple-space-loaded   ts-route   ts-label   ts-path]
]


home-view: [
    heading [ emit-text "Glon Demos" ]
    tagline [ emit-text "Small applications running in Glon" ]
    each-demo 0 block-len demos
]

each-demo: func [i n] [
    either < i n [
        row: block-at demos i
        either get block-at row 0 [
            link get block-at row 2 get block-at row 1
        ] [
            load-link get block-at row 2 get block-at row 1 get block-at row 3
        ]
        each-demo + i 1 n
    ] [ none ]
]


not-found-view: [
    heading [ emit-text "Not found" ]
    link "Back to demos" "home"
]

loading-view: [
    heading [ emit-text "Loading…" ]
    text [ emit-text "Loading the selected demo…" ]
    link "Back to demos" "home"
]

error-view: [
    heading [ emit-text "Load failed" ]
    text [ emit-text "The selected demo could not be loaded." ]
    link "Back to demos" "home"
]








renderer: func [view] [
    does [
        emit-clear
        do view
        emit-finish
    ]
]
render-home:      renderer home-view
render-not-found: renderer not-found-view
render-loading:   renderer loading-view
render-error:     renderer error-view



routes: [
    ['home          always               [render-home]]
    ['shop          shop-loaded          [render-shop]]
    ['products      shop-loaded          [render-products]]
    ['guide         guide-loaded         [render-guide]]
    ['merchant-flow merchant-flow-loaded [render-merchant-flow]]
    ['tuple-space   tuple-space-loaded   [render-tuple-space]]
]

render-current: func [] [
    route-row: select routes current-route
    either route-row [
        either get block-at route-row 1 [ do block-at route-row 2 ] [ render-loading ]
    ] [ render-not-found ]
]


route: [
    either = current-route 'products [
        either shop-loaded [ visit-count: + visit-count 1 ] [ none ]
    ] [ none ]
    render-current
]



events: [
    ['load-failed   [render-error]]
    ['start         [do-start]]
    ['reset         [do-reset]]
    ['run           [do-space-run]]
    ['space-reset   [do-space-reset]]
]

do-event: [
    event-row: select events current-event
    either event-row [
        do block-at event-row 1
    ] [
        either shop-loaded [ do-shop-event ] [ render-current ]
    ]
] ]