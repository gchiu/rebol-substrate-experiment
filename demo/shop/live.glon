;; demo/shop/live.glon -- the smallest text Live Translate application.
;;
;; Glon owns the application: what the source and translation text mean, how
;; deltas accumulate, when a completed utterance replaces them, and what the
;; page shows.  JavaScript (demo/shop/qwen-client.js + live-host.js) owns only
;; the Qwen WebSocket/wire mechanics.
;;
;; Semantic intents sent to the host (host_call).  No audio, base64, WebSocket
;; or Qwen JSON ever appears at this layer:
;;   listen-start <language>   start microphone + authenticated Qwen session
;;   listen-stop  <ignored>    stop it
;;
;; Events returned by the host (glon_event_bytes):
;;   qwen-status        status line (Listening/Stopped)
;;   qwen-source-delta  incremental source transcription (append)
;;   qwen-source-done   completed utterance (append to final, clear partial)
;;   qwen-text-delta    incremental translation (append)
;;   qwen-text-done     final translation (replace)
;;   qwen-error         error text
;;
;; Needs common.glon (emit-*/heading/text/button/mk-string) and strings.glon
;; (s/+).  Loaded only by the GLON_LIVE page and its focused tests.

[
empty: ""

status-text: "Stopped"
source-final: empty
source-live: empty
translation-text: empty
error-text: none

;; Render a host-call request fragment: 1 op 0 arg.
emit-host-call: func [op arg] [
    emit-clear
    emit-byte 1
    emit-text op
    emit-byte 0
    emit-text arg
    emit-finish
]

live-view: [
    heading [ emit-text "Live Translate" ]
    text [ emit-text status-text ]

    subhead [ emit-text "Source" ]
    text [ emit-text source-final emit-text source-live ]

    subhead [ emit-text "Translation" ]
    text [ emit-text translation-text ]

    either error-text [
        text [ emit-text "Error: " emit-text error-text ]
    ] [ none ]

    button [ emit-text "Start" ] "start"
    button [ emit-text "Stop" ] "stop"
]

render-live: func [] [ emit-clear do live-view emit-finish ]
render-current: func [] [ render-live ]

do-event: [
    either = current-event 'start [
        emit-host-call "listen-start" "zh"
    ] [
        either = current-event 'stop [
            emit-host-call "listen-stop" ""
        ] [
            either = current-event 'qwen-status [
                status-text: current-value
                error-text: none
                render-current
            ] [
                either = current-event 'qwen-source-delta [
                    source-live: s/+ source-live current-value
                    render-current
                ] [
                    either = current-event 'qwen-source-done [
                        source-final: s/+ source-final current-value
                        source-live: empty
                        render-current
                    ] [
                        either = current-event 'qwen-text-delta [
                            translation-text: s/+ translation-text current-value
                            render-current
                        ] [
                            either = current-event 'qwen-text-done [
                                translation-text: current-value
                                render-current
                            ] [
                                either = current-event 'qwen-error [
                                    error-text: current-value
                                    render-current
                                ] [
                                    render-current
                                ]
                            ]
                        ]
                    ]
                ]
            ]
        ]
    ]
]

]
