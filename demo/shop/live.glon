;; demo/shop/live.glon -- the Live Translate microphone capture application.
;;
;; Glon owns the control semantics of the capture appliance: Start / Stop and
;; the status / error line.  JavaScript (demo/shop/qwen-client.js +
;; live-host.js) owns only the microphone, the relay WebSocket and the Qwen
;; wire mechanics.
;;
;; This page is capture-only.  One microphone stream is fanned out by the relay
;; to the English and Chinese output sessions; audience devices display the
;; translation separately.  No source or translated text is shown here, and the
;; page never names a translation language.
;;
;; Semantic intents sent to the host (host_call).  No audio, base64, WebSocket
;; or Qwen JSON ever appears at this layer:
;;   listen-start <ignored>   start microphone + relay connection
;;   listen-stop  <ignored>   stop it
;;
;; Events returned by the host (glon_event_bytes):
;;   qwen-status        status line (Starting…/Listening/Stopped)
;;   qwen-error         error text
;;
;; Needs common.glon (emit-*/button/mk-string) and strings.glon (s/=).  Loaded
;; only by the GLON_LIVE page and its focused tests.

[
empty: ""

status-text: "Ready"
error-text: none

;; Render a host-call request fragment: 1 op 0 arg.
emit-host-call: func [op arg] [
    emit-clear
    emit-byte 1
    emit-text op
    emit-byte 0
    emit-text arg
    emit-finish
]

live-view: [
    emit-text "<div class='console'>"
    emit-text "<div class='brand'>LIVE TRANSLATE</div>"

    emit-text "<div class='status'>"
    either s/= status-text "Listening" [
        emit-text "<span class='dot live'></span>"
    ] [
        emit-text "<span class='dot'></span>"
    ]
    emit-text "<span class='status-text'>"
    emit-text status-text
    emit-text "</span></div>"

    either s/= status-text "Listening" [
        button [ emit-text "STOP" ] "stop"
    ] [
        button [ emit-text "START" ] "start"
    ]

    emit-text "<div class='hint'>"
    either s/= status-text "Listening" [
        emit-text "Translation active"
    ] [
        emit-text "Microphone idle"
    ]
    emit-text "</div>"

    emit-text "<div class='meter'><span id='mic-level'></span></div>"

    either error-text [
        emit-text "<div class='error'>"
        emit-text error-text
        emit-text "</div>"
    ] [ none ]

    emit-text "<div class='foot'>Glon</div>"
    emit-text "</div>"
]

render-live: func [] [ emit-clear do live-view emit-finish ]
render-current: func [] [ render-live ]

do-event: [
    either = current-event 'start [
        emit-host-call "listen-start" ""
    ] [
        either = current-event 'stop [
            emit-host-call "listen-stop" ""
        ] [
            either = current-event 'qwen-status [
                status-text: current-value
                error-text: none
                render-current
            ] [
                either = current-event 'qwen-error [
                    error-text: current-value
                    status-text: "Error"
                    render-current
                ] [
                    render-current
                ]
            ]
        ]
    ]
]

]
