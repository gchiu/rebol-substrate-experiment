;; demo/shop/live.glon -- experimental Live Translate host-boundary probe.
;;
;; This is NOT the shop and NOT the product application.  It exists only to
;; prove the two new GLON_LIVE host-boundary mechanisms:
;;
;;   1. outbound host_call: `emit-host-call` clears the HTML output, writes the
;;      request marker byte 1, the op bytes, a 0 separator and the arg bytes,
;;      then finishes the fragment.  The GLON_LIVE dispatcher recognises it and
;;      calls the browser host's generic host_call(op, arg) import.
;;
;;   2. inbound glon_event_bytes: the host asynchronously replies by calling
;;      glon_event_bytes("reply", <bytes>); the dispatcher binds those bytes as
;;      current-value and runs `do-event`.
;;
;; It needs the common.glon view dialect (emit-*, heading/text/button,
;; mk-string) and strings.glon (s/+).  It is loaded only by the GLON_LIVE page
;; and the focused native test; existing shop/browser builds never see it.

[
reply-text: none

;; Render a host-call request fragment: 1 op 0 arg.
emit-host-call: func [op arg] [
    emit-clear
    emit-byte 1
    emit-text op
    emit-byte 0
    emit-text arg
    emit-finish
]

live-view: [
    heading [ emit-text "Live Translate host-boundary probe" ]
    text [ emit-text "Glon requests a generic host capability; the host replies asynchronously with UTF-8 bytes through glon_event_bytes." ]
    either reply-text [
        text [ emit-text "Reply: " emit-text reply-text ]
    ] [
        text [ emit-text "Reply: (waiting for the host)" ]
    ]
    button [ emit-text "Request host capability" ] "go"
]

render-live: func [] [ emit-clear do live-view emit-finish ]
render-current: func [] [ render-live ]

do-event: [
    either = current-event 'go [
        emit-host-call "echo" "roundtrip"
    ] [
        either = current-event 'reply [
            reply-text: current-value
            render-current
        ] [
            render-current
        ]
    ]
]

]
