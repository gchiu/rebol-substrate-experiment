;; demo/shop/shop.glon -- the Glon Shop G1A application (authoritative source).
;;
;; This is the FIRST real Glon application: a browser-hosted, WASM-executed
;; shopping-front demo. It proves the G1A runtime model:
;;
;;   * a persistent Glon runtime (WASM) acting as the application engine;
;;   * browser events forwarded to Glon through the host bridge;
;;   * application state that survives route changes;
;;   * routes that select bundled HTML fragments;
;;   * fragments that contain embedded Glon (<% ... %>), evaluated at render.
;;
;; ROUTING, STATE and the FRAGMENT SELECTION all live in this source. The
;; browser host (host.js) and the WASM host (standalone/glon.c) only forward
;; events, render HTML into the DOM, and expose the two imports/exports; they
;; contain no application logic.
;;
;; The three fragments (home-fragment, products-fragment, not-found-fragment)
;; are INJECTED by demo/shop/build.py at the `;; @fragments` marker below, as
;; byte lists generated from demo/shop/fragments/*.html. GLON has no string
;; literals, so a bundled fragment is a loader-heap BLOCK of integer byte
;; codes (0..255) -- permanent across runs, and the shape a future compressed
;; fragment would decompress into.

[
;; ---- application state -----------------------------------------------------
;; An integer in the global context. It persists across every route change and
;; proves the runtime is alive and not reconstructed per route.
visit-count: 0

;; ---- fragments (injected by demo/shop/build.py) ---------------------------
;; @fragments

;; ---- routing --------------------------------------------------------------
;; `current-route` holds the token for the requested route (bound by the host's
;; glon_route before `do route`). The ROUTE DECISION lives here in GLON: the
;; route block maps a token to the fragment that page should render.
current-route: none

home-page: [ home-fragment ]
products-page: [ products-fragment ]
not-found-page: [ not-found-fragment ]

route: [
    either = current-route 'products [ do products-page ]
    [ either = current-route 'home [ do home-page ] [ do not-found-page ] ]
]
]
