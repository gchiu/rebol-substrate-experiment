;; demo/shop/shop.glon -- the Glon Demos launcher application (authoritative source).
;;
;; The root view is a demo launcher ("home"). It routes to three demonstrations:
;;
;;   shop          -- the G1E shop/products demonstration ("Glon Shop")
;;   guide         -- the G1E programmer's guide
;;   merchant-flow -- a page describing the Julia merchant_flow.jl demo
;;
;; The shop itself remains the G1E repeated-interactive-composition demo: the
;; catalogue renders a dynamic family of "Add" buttons, each carrying its
;; product's identity as the event value. The SAME event semantic
;; ("add-product") is instantiated repeatedly with DISTINCT application data
;; ("tea" vs "rice"), and Glon — not JavaScript — decides what each value means.
;;
;;   state        -> plain GLON set-words (visit-count, tea-count, rice-count, search-term)
;;   product data -> a GLON block (catalog)
;;   views        -> composable GLON blocks (heading/text/products/input/button/link/basket)
;;   routes       -> entry side effects + render-current
;;   events       -> a generic dispatcher (do-event) + handlers
;;
;; The basket holds per-product quantities as explicit Glon state. It is
;; regenerated from that state on every render, so the visible basket reflects
;; real quantities (Tea x2, Rice x1, ...) rather than an aggregate counter.
;; The browser host remains generic: it forwards route tokens and event
;; token/value pairs opaquely; Glon owns all application meaning.

;; ---- application state -----------------------------------------------------
visit-count: 0
tea-count: 0
rice-count: 0
search-term: []

;; ---- product data ---------------------------------------------------------
tea: "Tea"
rice: "Rice"
catalog: [ tea rice ]

;; ---- basket rendering ------------------------------------------------------
;; A basket row is emitted only when its quantity is non-zero (empty basket =
;; no rows). The total is derived from the two counts, so it cannot drift.
basket-row: func [name count] [
    either > count 0 [
        emit-text li-open
        emit-text span-open emit-text name emit-text span-close
        emit-text qty-open emit-text "× " emit-int count emit-text qty-close
        emit-text li-close
    ] [ none ]
]
basket: func [] [
    emit-text basket-open
    subhead [ emit-text "Your basket" ]
    emit-text basket-list-open
    basket-row "Tea" tea-count
    basket-row "Rice" rice-count
    emit-text basket-list-close
    emit-text total-open
    emit-int + tea-count rice-count
    emit-text " "
    either = + tea-count rice-count 1 [ emit-text "item" ] [ emit-text "items" ]
    emit-text total-close
    emit-text basket-close
]

;; ---- views -----------------------------------------------------------------
home-view: [
    heading [ emit-text "Glon Demos" ]
    tagline [ emit-text "Small applications running in Glon" ]
    link [ emit-text "Shop SPA" ] "shop"
    link [ emit-text "Julia merchant flow" ] "merchant-flow"
    link [ emit-text "Programmer's guide" ] "guide"
]

shop-view: [
    heading [ emit-text "Glon Shop" ]
    tagline [ emit-text "A tiny GLON storefront" ]
    link [ emit-text "View products" ] "products"
    link [ emit-text "Back to demos" ] "home"
]

products-view: [
    heading [ emit-text "Products" ]
    products catalog
    emit-text panel-open
    emit-text search-open
    input "search"
    button [ emit-text "Search" ] "search"
    emit-text search-close
    meta [ emit-text "Search: " emit-text search-term ]
    meta [ emit-text "Products page visits: " emit-int visit-count ]
    emit-text panel-close
    basket
    link [ emit-text "Back to shop" ] "shop"
]

not-found-view: [
    heading [ emit-text "Not found" ]
    link [ emit-text "Back to demos" ] "home"
]

guide-view: [
    heading [ emit-text "Programmer's guide" ]

    text [ emit-text "Glon owns the application: state, routing, and page logic. JavaScript only loads the WASM and source, writes rendered HTML into the page, and forwards route, event, and value messages. It never interprets a product, a basket, or a route." ]

    subhead [ emit-text "The three paths" ]
    text [ emit-text "route -> current-route -> route logic" ]
    text [ emit-text "event -> current-event -> event logic" ]
    text [ emit-text "event + value -> current-event + current-value -> application logic" ]

    subhead [ emit-text "Where to extend" ]
    text [ emit-text "New page: add a view, a renderer, a route branch, and a link." ]
    text [ emit-text "New action: add a button or value-button, then a do-event branch." ]
    text [ emit-text "New state: add a value, mutate it in a handler, call render-current." ]
    text [ emit-text "New repeated UI: put the data in a block and write a function that renders each value." ]
    text [ emit-text "New appearance: edit style.css, not the application logic." ]

    subhead [ emit-text "Not yet production" ]
    text [ emit-text "Products and basket state are written explicitly, not data-driven. Search shows a term but does not filter the catalogue. Routes are internal, with no history and no persistence across reloads. Rendered HTML is installed with innerHTML and is not escaped." ]

    text [
        emit-text "Full guide: "
        emit-text "<a href='https://github.com/gchiu/rebol-substrate-experiment/blob/glon-shop-g1a/demo/shop/README.md'>demo/shop/README.md</a>"
    ]

    link [ emit-text "Back to demos" ] "home"
]

merchant-flow-view: [
    heading [ emit-text "Julia merchant flow" ]
    tagline [ emit-text "A Julia Tasks + Channels dataflow demonstration" ]
    pre [ emit-text "Transaction pool
      ↓
anonymous workers
      ↓
    router
    / | \
stock cash sales" ]
    subhead [ emit-text "How it works" ]
    text [ emit-text "Four anonymous workers compete for transactions from a single shared pool; each transaction is consumed exactly once." ]
    text [ emit-text "One router fans each consequence out to three typed channels — stock, cash, and sales." ]
    text [ emit-text "Three reducer tasks own the only mutable state, one concern each; they return immutable final totals when their channel closes." ]
    text [ emit-text "Bounded channels give back-pressure: a slow consumer pauses the whole pipeline, making the flow visible." ]
    text [ emit-text "Money is integer cents, so the final totals are exact and independent of processing order." ]
    text [
        emit-text "Runs under Julia, not the browser. Source: "
        emit-text "<a href='https://github.com/gchiu/rebol-substrate-experiment/blob/glon-shop-g1a/julia/merchant_flow.jl'>julia/merchant_flow.jl</a>"
    ]
    link [ emit-text "Back to demos" ] "home"
]

;; ---- rendering -------------------------------------------------------------
render-home:      func [] [ emit-clear do home-view emit-finish ]
render-shop:      func [] [ emit-clear do shop-view emit-finish ]
render-products:  func [] [ emit-clear do products-view emit-finish ]
render-guide:     func [] [ emit-clear do guide-view emit-finish ]
render-merchant-flow: func [] [ emit-clear do merchant-flow-view emit-finish ]
render-not-found: func [] [ emit-clear do not-found-view emit-finish ]

render-current: func [] [
    either = current-route 'shop [ render-shop ]
    [ either = current-route 'products [ render-products ]
      [ either = current-route 'guide [ render-guide ]
        [ either = current-route 'merchant-flow [ render-merchant-flow ]
          [ either = current-route 'home [ render-home ] [ render-not-found ] ] ] ] ]
]

;; ---- routes (entry side effects, then render) -----------------------------
go-home:      func [] [ render-current ]
go-shop:      func [] [ render-current ]
go-products:  func [] [ visit-count: + visit-count 1 render-current ]
go-guide:     func [] [ render-current ]
go-merchant-flow: func [] [ render-current ]
go-not-found: func [] [ render-current ]

route: [
    either = current-route 'shop [ go-shop ]
    [ either = current-route 'products [ go-products ]
      [ either = current-route 'guide [ go-guide ]
        [ either = current-route 'merchant-flow [ go-merchant-flow ]
          [ either = current-route 'home [ go-home ] [ go-not-found ] ] ] ] ]
]

;; ---- events (mutate state, rerender current view) -------------------------
;; The product identity arrives as the event VALUE (a byte-list). Glon matches
;; it against the catalogue and increments the matching quantity, so repeated
;; "Add" clicks on different products produce distinct basket state.
add-product: func [] [
    either str-eq current-value "Tea" [ tea-count: + tea-count 1 ]
    [ either str-eq current-value "Rice" [ rice-count: + rice-count 1 ] [ none ] ]
    render-current
]
search: func [] [ search-term: current-value render-current ]

;; Unknown events fall back to re-rendering the current view (no state change).
do-event: [
    either = current-event 'add-product [ add-product ]
    [ either = current-event 'search [ search ] [ render-current ] ]
]
