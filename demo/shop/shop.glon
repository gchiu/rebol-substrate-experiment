;; demo/shop/shop.glon -- the Glon Shop G1B application (authoritative source).
;;
;; G1B reframes the shop from "HTML fragments with embedded code" (G1A) to a
;; small persistent-SPA dialect. The application now reads as:
;;
;;   state        -> a plain GLON set-word (visit-count)
;;   product data -> a GLON block (catalog)
;;   views        -> composable GLON blocks of heading/text/list/link
;;   routes       -> ordinary GLON functions (go-home / go-products / …)
;;   router       -> a GLON block dispatching on current-route
;;
;; Rendering a view is `do view-block`; each term emits HTML into the fixed
;; output block (see g1b.glon). String literals here are converted to byte-lists
;; by demo/shop/build.py (GLON has no string literals yet). The browser host
;; (host.js) and the WASM host (standalone/glon.c) are unchanged from G1A.

;; ---- application state -----------------------------------------------------
visit-count: 0

;; ---- product data ---------------------------------------------------------
catalog: [ "Tea" "Rice" ]

;; ---- views -----------------------------------------------------------------
home-view: [
    heading [ emit-text "Glon Shop" ]
    link    [ emit-text "View products" ] "products"
]

products-view: [
    heading [ emit-text "Products" ]
    list    catalog
    text    [ emit-text "Products page visits: " emit-int visit-count ]
    link    [ emit-text "Back home" ] "home"
]

not-found-view: [
    heading [ emit-text "Not found" ]
    link    [ emit-text "Back home" ] "home"
]

;; ---- routes ----------------------------------------------------------------
go-home:      func [] [ emit-clear do home-view emit-finish ]
go-products:  func [] [ visit-count: + visit-count 1 emit-clear do products-view emit-finish ]
go-not-found: func [] [ emit-clear do not-found-view emit-finish ]

;; ---- router ----------------------------------------------------------------
route: [
    either = current-route 'products [ go-products ]
    [ either = current-route 'home [ go-home ] [ go-not-found ] ]
]
