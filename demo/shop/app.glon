;; demo/shop/app.glon -- the Glon Demos launcher (bootstrap).
;;
;; This is the WHOLE initial Glon application. It contains no demo content: the
;; shop, the programmer's guide, and the merchant-flow page each live in their
;; own demos/<name>.glon file, loaded on first selection.
;;
;;   bootstrap (common.glon + app.glon)
;;       |
;;       +-- Shop ------------> load demos/shop.glon when selected
;;       +-- Guide -----------> load demos/guide.glon when selected
;;       +-- Merchant flow ---> load demos/merchant-flow.glon when selected
;;
;; The launcher owns routing and event dispatch. Each demo, once loaded, sets
;; its <name>-loaded flag and defines its own views, renderers, and (for the
;; shop) event handlers. The dispatch references those definitions only under
;; the matching loaded flag, so an unloaded demo is never dereferenced.
;;
;; The browser host stays generic: it fetches whatever [data-glon-load] names,
;; injects it via glon_load, and re-dispatches the route. It never knows what
;; "shop", "guide", or "merchant-flow" mean.
;;
;; Routing, event dispatch and the launcher menu are DATA tables (see `demos`,
;; `routes`, `events` below) resolved with the one general `select` word from
;; common.glon -- not nested EITHER chains.

;; ---- which demos are resident (load-on-demand state) -----------------------
shop-loaded: 0
guide-loaded: 0
merchant-flow-loaded: 0
tuple-space-loaded: 0
always: 1          ;; truthy flag for routes that need no load check

;; ---- demo registry (one row per demo) --------------------------------------
;; each demo row: [loaded-flag route-string label-string path-string]
shop-route: "shop"  shop-label: "Shop SPA"  shop-path: "demos/shop.glon"
guide-route: "guide"  guide-label: "Programmer's guide"  guide-path: "demos/guide.glon"
mf-route: "merchant-flow"  mf-label: "Multitasking / dataflow"  mf-path: "demos/merchant-flow.glon"
ts-route: "tuple-space"  ts-label: "Tuple space / dataflow"  ts-path: "demos/tuple-space.glon"

demos: [
    [shop-loaded          shop-route shop-label shop-path]
    [guide-loaded         guide-route guide-label guide-path]
    [merchant-flow-loaded mf-route   mf-label   mf-path]
    [tuple-space-loaded   ts-route   ts-label   ts-path]
]

;; ---- launcher view ---------------------------------------------------------
home-view: [
    heading [ emit-text "Glon Demos" ]
    tagline [ emit-text "Small applications running in Glon" ]
    each-demo 0 block-len demos
]

each-demo: func [i n] [
    either < i n [
        row: block-at demos i
        either get block-at row 0 [
            link get block-at row 2 get block-at row 1
        ] [
            load-link get block-at row 2 get block-at row 1 get block-at row 3
        ]
        each-demo + i 1 n
    ] [ none ]
]

;; ---- fallback views --------------------------------------------------------
not-found-view: [
    heading [ emit-text "Not found" ]
    link "Back to demos" "home"
]

loading-view: [
    heading [ emit-text "Loading…" ]
    text [ emit-text "Loading the selected demo…" ]
    link "Back to demos" "home"
]

error-view: [
    heading [ emit-text "Load failed" ]
    text [ emit-text "The selected demo could not be loaded." ]
    link "Back to demos" "home"
]

;; ---- rendering -------------------------------------------------------------
;; render-home / render-not-found / render-loading / render-error live here;
;; the demo renderers (render-shop, render-products, render-guide,
;; render-merchant-flow) are defined by their demos and referenced only under
;; the matching loaded flag below.
render-home:      func [] [ emit-clear do home-view emit-finish ]
render-not-found: func [] [ emit-clear do not-found-view emit-finish ]
render-loading:   func [] [ emit-clear do loading-view emit-finish ]
render-error:     func [] [ emit-clear do error-view emit-finish ]

;; ---- route dispatch --------------------------------------------------------
;; each route row: ['token loaded-flag [renderer]]
routes: [
    ['home          always               [render-home]]
    ['shop          shop-loaded          [render-shop]]
    ['products      shop-loaded          [render-products]]
    ['guide         guide-loaded         [render-guide]]
    ['merchant-flow merchant-flow-loaded [render-merchant-flow]]
    ['tuple-space   tuple-space-loaded   [render-tuple-space]]
]

render-current: func [] [
    route-row: select routes current-route
    either route-row [
        either get block-at route-row 1 [ do block-at route-row 2 ] [ render-loading ]
    ] [ render-not-found ]
]

;; ---- routes (entry side effects, then render) -----------------------------
route: [
    either = current-route 'products [
        either shop-loaded [ visit-count: + visit-count 1 ] [ none ]
    ] [ none ]
    render-current
]

;; ---- event dispatch --------------------------------------------------------
;; each event row: ['token [handler]]
events: [
    ['load-failed   [render-error]]
    ['start         [do-start]]
    ['reset         [do-reset]]
    ['run           [do-space-run]]
    ['space-reset   [do-space-reset]]
]

do-event: [
    event-row: select events current-event
    either event-row [
        do block-at event-row 1
    ] [
        either shop-loaded [ do-shop-event ] [ render-current ]
    ]
]
