[ 











mk-string: raw 1 [
    DUP LIT 16 MOD SUB LIT SCRATCH_B !
    LIT SCRATCH_B @ @ LIT SCRATCH_F !
    LIT SCRATCH_F @ LIT 1 ADD LIT 15 ADD LIT 16 DIV LIT 16 MUL LIT GC_KIND_STRING CALL alloc LIT SCRATCH_C !
    LIT SCRATCH_F @ LIT SCRATCH_C @ !
    LIT 0 LIT SCRATCH_A !
  mk-loop:
    LIT SCRATCH_A @ LIT SCRATCH_F @ LT ZBRANCH mk-done
    LIT SCRATCH_B @ LIT 2 ADD LIT SCRATCH_A @ ADD @ LIT 16 DIV
    LIT SCRATCH_C @ LIT 1 ADD LIT SCRATCH_A @ ADD
    !
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_A !
    BRANCH mk-loop
  mk-done:
    LIT SCRATCH_C @ LIT T_STRING ADD ARITY 1 EXIT
]



str-eq: raw 2 [
    LIT SCRATCH_B !
    DUP LIT 16 MOD SUB LIT SCRATCH_A !
    DROP
    LIT SCRATCH_B @ DUP LIT 16 MOD SUB LIT SCRATCH_B !
    DROP
    LIT SCRATCH_A @ @ LIT SCRATCH_B @ @ EQ ZBRANCH str-eq-neq
    LIT SCRATCH_A @ @ LIT SCRATCH_F !
    LIT 0 LIT SCRATCH_E !
  str-eq-loop:
    LIT SCRATCH_E @ LIT SCRATCH_F @ LT ZBRANCH str-eq-yes
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_E @ ADD @
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_E @ ADD @
    EQ ZBRANCH str-eq-neq
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    BRANCH str-eq-loop
  str-eq-yes:
    INT 1 ARITY 1 EXIT
  str-eq-neq:
    INT 0 ARITY 1 EXIT
]


get: raw 1 [ CALL lookup ARITY 1 EXIT ] 
























emit-clear: raw [ LIT 0 LIT SCRATCH_E ! ARITY 0 EXIT ]
emit-byte: raw 1 [
    LIT SCRATCH_E @ LIT G1_OUT_DATA ADD !
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    ARITY 0 EXIT
]
emit-finish: raw [ LIT SCRATCH_E @ LIT G1_OUT ! LIT G1_OUT LIT T_BLOCK ADD ARITY 1 EXIT ]


block-len: raw 1 [ DUP LIT 16 MOD SUB @ LIT 16 MUL ARITY 1 EXIT ]
block-at: raw 2 [ LIT SCRATCH_B ! DUP LIT 16 MOD SUB LIT 2 ADD LIT SCRATCH_B @ LIT 16 DIV ADD @ ARITY 1 EXIT ]


emit-int: func [n] [ either < n 0 [ emit-byte 45 emit-digits - 0 n ] [ emit-digits n ] ]
emit-digits: func [n] [
    either > n 9 [ emit-digits / n 10 ] [ none ]
    emit-byte + 48 - n * 10 / n 10
]






emit-text: raw 1 [
    DUP LIT 16 MOD SUB LIT SCRATCH_B !
    LIT 0 LIT SCRATCH_A !
    LIT SCRATCH_B @ @ LIT SCRATCH_F !
  emit-text-loop:
    LIT SCRATCH_A @ LIT SCRATCH_F @ LT ZBRANCH emit-text-done
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_A @ ADD @ LIT 16 MUL
    LIT G1_OUT_DATA LIT SCRATCH_E @ ADD
    !
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_A !
    BRANCH emit-text-loop
  emit-text-done:
    ARITY 0 EXIT
]






h1-open:   "<h1>"
h1-close:  "</h1>"
h2-open:   "<h2>"
h2-close:  "</h2>"
p-open:    "<p>"
p-close:   "</p>"
catalog-open:  "<ul class='catalog'>"
catalog-close: "</ul>"
basket-list-open:  "<ul class='basket-list'>"
basket-list-close: "</ul>"
li-open:   "<li>"
li-close:  "</li>"
span-open:  "<span class='item'>"
span-close: "</span>"
qty-open:  "<span class='qty'>"
qty-close: "</span>"
btn-open:  "<button class='btn' data-glon-route='"
btn-mid:   "'>"
btn-close: "</button>"
event-open: "<button class='btn' data-glon-event='"
input-open: "<input class='search-input' type='text' placeholder='Search' data-glon-input='"
value-mid:  "' data-glon-value='"
panel-open:  "<div class='panel'>"
panel-close: "</div>"
search-open:  "<div class='search-row'>"
search-close: "</div>"
basket-open:  "<div class='basket'>"
basket-close: "</div>"
total-open:  "<p class='total'>"
total-close: "</p>"
meta-open:   "<p class='meta'>"
meta-close:  "</p>"
tagline-open:  "<p class='tagline'>"
tagline-close: "</p>"
nav-open:   "<p class='nav'>"
nav-close:  "</p>"







wrap: func [open close] [
    func [content] [ emit-text open do content emit-text close ]
]
heading: wrap h1-open h1-close
subhead: wrap h2-open h2-close
text:    wrap p-open p-close
tagline: wrap tagline-open tagline-close
meta:    wrap meta-open meta-close
link:    func [content route] [
    emit-text nav-open
    emit-text btn-open emit-text route emit-text btn-mid do content emit-text btn-close
    emit-text nav-close
]

button:  func [content event] [
    emit-text event-open emit-text event emit-text btn-mid do content emit-text btn-close
]

value-button: func [content event value] [
    emit-text event-open emit-text event emit-text value-mid emit-text value emit-text btn-mid
    do content emit-text btn-close
]



input:   func [name] [
    emit-text input-open emit-text name emit-text btn-mid
]






products: func [items] [ emit-text catalog-open each-product items emit-text catalog-close ]
each-product: func [items] [ emit-product-at items 0 block-len items ]
emit-product-at: func [items i n] [
    either < i n [
        emit-text li-open
        emit-text span-open emit-text get block-at items i emit-text span-close
        value-button [ emit-text "Add" ] "add-product" get block-at items i
        emit-text li-close
        emit-product-at items + i 1 n
    ] [ none ]
] 




















visit-count: 0
tea-count: 0
rice-count: 0
search-term: []


tea: "Tea"
rice: "Rice"
catalog: [ tea rice ]




basket-row: func [name count] [
    either > count 0 [
        emit-text li-open
        emit-text span-open emit-text name emit-text span-close
        emit-text qty-open emit-text "× " emit-int count emit-text qty-close
        emit-text li-close
    ] [ none ]
]
basket: func [] [
    emit-text basket-open
    subhead [ emit-text "Your basket" ]
    emit-text basket-list-open
    basket-row "Tea" tea-count
    basket-row "Rice" rice-count
    emit-text basket-list-close
    emit-text total-open
    emit-int + tea-count rice-count
    emit-text " "
    either = + tea-count rice-count 1 [ emit-text "item" ] [ emit-text "items" ]
    emit-text total-close
    emit-text basket-close
]


home-view: [
    heading [ emit-text "Glon Shop" ]
    tagline [ emit-text "A tiny GLON storefront" ]
    link    [ emit-text "View products" ] "products"
    link    [ emit-text "Programmer's guide" ] "guide"
]

products-view: [
    heading [ emit-text "Products" ]
    products catalog
    emit-text panel-open
    emit-text search-open
    input "search"
    button [ emit-text "Search" ] "search"
    emit-text search-close
    meta [ emit-text "Search: " emit-text search-term ]
    meta [ emit-text "Products page visits: " emit-int visit-count ]
    emit-text panel-close
    basket
    link [ emit-text "Back home" ] "home"
]

not-found-view: [
    heading [ emit-text "Not found" ]
    link    [ emit-text "Back home" ] "home"
]

guide-view: [
    heading [ emit-text "Programmer's guide" ]

    text [ emit-text "Glon owns the application: state, routing, and page logic. JavaScript only loads the WASM and source, writes rendered HTML into the page, and forwards route, event, and value messages. It never interprets a product, a basket, or a route." ]

    subhead [ emit-text "The three paths" ]
    text [ emit-text "route -> current-route -> route logic" ]
    text [ emit-text "event -> current-event -> event logic" ]
    text [ emit-text "event + value -> current-event + current-value -> application logic" ]

    subhead [ emit-text "Where to extend" ]
    text [ emit-text "New page: add a view, a renderer, a route branch, and a link." ]
    text [ emit-text "New action: add a button or value-button, then a do-event branch." ]
    text [ emit-text "New state: add a value, mutate it in a handler, call render-current." ]
    text [ emit-text "New repeated UI: put the data in a block and write a function that renders each value." ]
    text [ emit-text "New appearance: edit style.css, not the application logic." ]

    subhead [ emit-text "Not yet production" ]
    text [ emit-text "Products and basket state are written explicitly, not data-driven. Search shows a term but does not filter the catalogue. Routes are internal, with no history and no persistence across reloads. Rendered HTML is installed with innerHTML and is not escaped." ]

    text [
        emit-text "Full guide: "
        emit-text "<a href='https://github.com/gchiu/rebol-substrate-experiment/blob/glon-shop-g1a/demo/shop/README.md'>demo/shop/README.md</a>"
    ]

    link [ emit-text "Back home" ] "home"
]


render-home:      func [] [ emit-clear do home-view emit-finish ]
render-products:  func [] [ emit-clear do products-view emit-finish ]
render-not-found: func [] [ emit-clear do not-found-view emit-finish ]
render-guide:     func [] [ emit-clear do guide-view emit-finish ]

render-current: func [] [
    either = current-route 'products [ render-products ]
    [ either = current-route 'home [ render-home ]
      [ either = current-route 'guide [ render-guide ] [ render-not-found ] ] ]
]


go-home:      func [] [ render-current ]
go-products:  func [] [ visit-count: + visit-count 1 render-current ]
go-not-found: func [] [ render-current ]
go-guide:     func [] [ render-current ]

route: [
    either = current-route 'products [ go-products ]
    [ either = current-route 'home [ go-home ]
      [ either = current-route 'guide [ go-guide ] [ go-not-found ] ] ]
]





add-product: func [] [
    either str-eq current-value "Tea" [ tea-count: + tea-count 1 ]
    [ either str-eq current-value "Rice" [ rice-count: + rice-count 1 ] [ none ] ]
    render-current
]
search: func [] [ search-term: current-value render-current ]


do-event: [
    either = current-event 'add-product [ add-product ]
    [ either = current-event 'search [ search ] [ render-current ] ]
] ]