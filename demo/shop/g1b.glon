;; demo/shop/g1b.glon -- the G1B SPA view dialect (library).
;;
;; This is the smallest dialect that makes a persistent SPA read as a Rebol
;; application rather than as HTML templates. It provides:
;;
;;   * a byte-output trapdoor (RAW helpers writing into a fixed output block);
;;   * text emission (emit-int / emit-text);
;;   * a small composable view vocabulary (heading / text / list / link);
;;   * a raw HTML escape (a view may emit arbitrary bytes via emit-text).
;;
;; The dialect LOWERS onto the existing G1A machinery: a view is an ordinary
;; GLON block of function calls; rendering a view is `do view-block`; the result
;; is a loader-style byte-list block at a fixed address that the unchanged G1A
;; renderer (r0_s1_g1a_render_fragment) writes to the DOM via host_set_html.
;;
;; Output buffer layout (fixed M[] cells, chosen free in [25315, 32768)):
;;   M[G1_OUT]     = byte count        (set by emit-finish)
;;   M[G1_OUT + 1] = site (unused)
;;   M[G1_OUT + 2 + i] = byte i as a tagged int (mk_int)
;;   SCRATCH_E    = live length during emission
;; The returned value is mk_block(G1_OUT), exactly what the renderer expects.
;; This is TEMPORARY scratch/output storage (see r0_s1.h G1_OUT); it uses no
;; new S1 primitive, no native id, and no evaluator change.

;; ---- byte output (RAW trapdoor) -------------------------------------------
emit-clear: raw [ LIT 0 LIT SCRATCH_E ! ARITY 0 EXIT ]
emit-byte: raw 1 [
    LIT SCRATCH_E @ LIT G1_OUT_DATA ADD !
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    ARITY 0 EXIT
]
emit-finish: raw [ LIT SCRATCH_E @ LIT G1_OUT ! LIT G1_OUT LIT T_BLOCK ADD ARITY 1 EXIT ]

;; ---- loader-block primitives (RAW) ----------------------------------------
block-len: raw 1 [ DUP LIT 16 MOD SUB @ LIT 16 MUL ARITY 1 EXIT ]
block-at: raw 2 [ LIT SCRATCH_B ! DUP LIT 16 MOD SUB LIT 2 ADD LIT SCRATCH_B @ LIT 16 DIV ADD @ ARITY 1 EXIT ]

;; ---- text emission (GLON policy over RAW mechanics) -----------------------
emit-int: func [n] [ either < n 0 [ emit-byte 45 emit-digits - 0 n ] [ emit-digits n ] ]
emit-digits: func [n] [
    either > n 9 [ emit-digits / n 10 ] [ none ]
    emit-byte + 48 - n * 10 / n 10
]
;; emit-text is a RAW loop (not per-byte GLON recursion): the frozen return
;; stack is small, and recursive emit-text-at exhausted it once the view atoms
;; grew beyond a few dozen bytes. Iterating in S1 keeps the render depth flat.
;; Scratch cells: A (index), B (string ptr), F (length) are all above RS_INIT;
;; E is the shared output length. The string payload is [len, b0..bN-1] with a
;; raw byte (0..255) per cell, so each byte is re-tagged (x16) for G1_OUT.
emit-text: raw 1 [
    DUP LIT 16 MOD SUB LIT SCRATCH_B !
    LIT 0 LIT SCRATCH_A !
    LIT SCRATCH_B @ @ LIT SCRATCH_F !
  emit-text-loop:
    LIT SCRATCH_A @ LIT SCRATCH_F @ LT ZBRANCH emit-text-done
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_A @ ADD @ LIT 16 MUL
    LIT G1_OUT_DATA LIT SCRATCH_E @ ADD
    !
    LIT SCRATCH_E @ LIT 1 ADD LIT SCRATCH_E !
    LIT SCRATCH_A @ LIT 1 ADD LIT SCRATCH_A !
    BRANCH emit-text-loop
  emit-text-done:
    ARITY 0 EXIT
]
;; ---- string equality (content equality of managed strings) ----------------
;; The basket must decide which product an add-product VALUE refers to. The
;; value arrives as a fresh STRING! each event, so pointer equality (=) cannot
;; distinguish it from a catalogue entry; compare byte-by-byte via string=?. 

;; ---- HTML tag atoms (single-quoted attributes keep the source simple) ------
h1-open:   "<h1>"
h1-close:  "</h1>"
h2-open:   "<h2>"
h2-close:  "</h2>"
p-open:    "<p>"
p-close:   "</p>"
catalog-open:  "<ul class='catalog'>"
catalog-close: "</ul>"
basket-list-open:  "<ul class='basket-list'>"
basket-list-close: "</ul>"
li-open:   "<li>"
li-close:  "</li>"
span-open:  "<span class='item'>"
span-close: "</span>"
qty-open:  "<span class='qty'>"
qty-close: "</span>"
btn-open:  "<button class='btn' data-glon-route='"
btn-mid:   "'>"
btn-close: "</button>"
event-open: "<button class='btn' data-glon-event='"
input-open: "<input class='search-input' type='text' placeholder='Search' data-glon-input='"
value-mid:  "' data-glon-value='"
panel-open:  "<div class='panel'>"
panel-close: "</div>"
search-open:  "<div class='search-row'>"
search-close: "</div>"
basket-open:  "<div class='basket'>"
basket-close: "</div>"
total-open:  "<p class='total'>"
total-close: "</p>"
meta-open:   "<p class='meta'>"
meta-close:  "</p>"
tagline-open:  "<p class='tagline'>"
tagline-close: "</p>"
nav-open:   "<p class='nav'>"
nav-close:  "</p>"
pre-open:   "<pre>"
pre-close:  "</pre>"

;; ---- view vocabulary ------------------------------------------------------
;; Each term wraps its CONTENT (a block of emit-* calls) in an HTML element.
;; The five single-element wrappers share one algorithm. `wrap` is a factory:
;; it returns a closure that wraps its content in a given open/close atom pair.
;; The algorithm therefore lives in one place, and each term below is declared
;; as plain data (name -> [open close]).
wrap: func [open close] [
    func [content] [ emit-text open do content emit-text close ]
]
heading: wrap h1-open h1-close
subhead: wrap h2-open h2-close
text:    wrap p-open p-close
tagline: wrap tagline-open tagline-close
meta:    wrap meta-open meta-close
pre:     wrap pre-open pre-close
link:    func [content route] [
    emit-text nav-open
    emit-text btn-open emit-text route emit-text btn-mid do content emit-text btn-close
    emit-text nav-close
]
;; G1C: a button that carries a generic application-event token (not a route).
button:  func [content event] [
    emit-text event-open emit-text event emit-text btn-mid do content emit-text btn-close
]
;; G1E: a button carrying an event token AND a static value (e.g. a product id).
value-button: func [content event value] [
    emit-text event-open emit-text event emit-text value-mid emit-text value emit-text btn-mid
    do content emit-text btn-close
]
;; G1D: a named text input. An event button whose token matches the name will
;; forward this input's value (see host.js) — the event token doubles as the
;; input's name.
input:   func [name] [
    emit-text input-open emit-text name emit-text btn-mid
]

;; ---- iteration (a repeated interactive catalogue) -------------------------
;; G1E: ordinary GLON iteration generates a repeated family of interactive
;; controls. Each product renders as its name plus an "Add" button that carries
;; the product's identity as the event value — the same event semantic
;; instantiated repeatedly with distinct application data.
products: func [items] [ emit-text catalog-open each-product items emit-text catalog-close ]
each-product: func [items] [ emit-product-at items 0 block-len items ]
emit-product-at: func [items i n] [
    either < i n [
        emit-text li-open
        emit-text span-open emit-text get block-at items i emit-text span-close
        value-button [ emit-text "Add" ] "add-product" get block-at items i
        emit-text li-close
        emit-product-at items + i 1 n
    ] [ none ]
]
