;; examples/escape.r0 -- a first-class dynamic ESCAPE facility, written
;; entirely in ordinary R0 plus two generic `raw` S1 fragments.  The R0
;; evaluator knows only that RAW values are callable (Phase 4A); it has no
;; WITH-ESCAPE / ESCAPE built-in, keyword, native, or status code.
;;
;; The raw fragments use the symbolic RAW ABI (REG_*, RV_*, FRAME_SAVED_*,
;; SCRATCH_*) -- no hard-wired machine addresses.
;;
;; This is a canonical source listing: the harness has no file loader, so the
;; tests in r0_s1_tests.c embed this exact source as strings.

[ ;; -- RAW fragments (low-level work R0 cannot express) ----------------------

  ;; frame-here : ( -- frame )  read the current activation-frame pointer.
  frame-here: raw [ LIT RV_FRAME @ ARITY 1 EXIT ]

  ;; restore : ( frame result -- )  restore the caller state recorded in
  ;; `frame` and jump to its return address, leaving [result, 1].
  restore: raw 2 [
      LIT SCRATCH_A ! LIT SCRATCH_B !                     ;; save (result, frame)
      LIT SCRATCH_B @ LIT FRAME_SAVED_CTX ADD @ LIT RV_CTX !
      LIT SCRATCH_B @ LIT FRAME_SAVED_CUR ADD @ LIT RV_CUR !
      LIT SCRATCH_B @ LIT FRAME_SAVED_END ADD @ LIT RV_END !
      LIT SCRATCH_B @ LIT FRAME_SAVED_BLK ADD @ LIT RV_BLK !
      LIT SCRATCH_B @ @ LIT RV_FRAME !                    ;; RV_FRAME <- frame.prev
      LIT SCRATCH_B @ LIT FRAME_SAVED_RP ADD @ LIT REG_RP !
      LIT SCRATCH_B @ LIT FRAME_SAVED_IP ADD @ >R         ;; stage frame.ip on R
      LIT SCRATCH_B @ LIT FRAME_SAVED_SP ADD @ LIT REG_SP !
      LIT SCRATCH_A @ LIT 16                              ;; push [result, 1]
      EXIT
  ]

  ;; -- ordinary R0 composition ----------------------------------------------

  ;; with-escape : ( body -- result )  run `body` with a first-class ESCAPE.
  with-escape: func [body] [
      target: frame-here
      escape: func [r] [ restore target r ]
      body :escape
  ]

  ;; -- usage ----------------------------------------------------------------

  x: with-escape func [escape] [
      escape 42
      99           ;; never evaluated
  ]

  x                ;; => 42
]
