doom/tex-row-mirror: func [y] [
    doom/trdy: - doom/horizon y
    doom/trdist: block-at doom/rowdist - 99 y
    doom/trbx: + * doom/px 65536 * doom/trdist - doom/dirx doom/planex
    doom/trsx: / * * doom/trdist doom/planex 2 319
    doom/trby: + * doom/py 65536 * doom/trdist - doom/diry doom/planey
    doom/trsy: / * * doom/trdist doom/planey 2 319
    doom/trshade: either < doom/trdist 262144 [ 3 ] [
        either < doom/trdist 524288 [ 2 ] [
            either < doom/trdist 1048576 [ 1 ] [ 0 ]
        ]
    ]
    print y
    print 1
    print doom/trbx
    print doom/trby
    print doom/trsx
    print doom/trsy
    print doom/trshade
    print - 200 y
    print 1
    print doom/trbx
    print doom/trby
    print doom/trsx
    print doom/trsy
    print doom/trshade
]

