      either > doom/t 0 [
        doom/hy: + doom/py / * doom/t doom/rayy 64
        either < doom/hy 256 [ none ] [
          either > doom/hy 1024 [ none ] [
            either < doom/t doom/best [
              doom/best: doom/t
              doom/bcolor: 3
              doom/bu: doom/hy
              doom/bmat: 4
            ] [ none ]
          ]
        ]
      ] [ none ]
    ]
    either = doom/rayy 0 [ none ] [
      doom/t: / * - 1024 doom/py 64 doom/rayy
      either > doom/t 0 [
        doom/hx: + doom/px / * doom/t doom/rayx 64
        either < doom/hx 1152 [ none ] [
          either > doom/hx 1280 [ none ] [
            either < doom/t doom/best [
              doom/best: doom/t
              doom/bcolor: 3
              doom/bu: doom/hx
              doom/bmat: 0
            ] [ none ]
          ]
        ]
      ] [ none ]
    ]
    either = doom/rayx 0 [ none ] [
      doom/t: / * - 1152 doom/px 64 doom/rayx
      either > doom/t 0 [
        doom/hy: + doom/py / * doom/t doom/rayy 64
        either < doom/hy 384 [ none ] [
          either > doom/hy 1024 [ none ] [
            either < doom/t doom/best [
              doom/best: doom/t
              doom/bcolor: 3
              doom/bu: doom/hy
              doom/bmat: 3
            ] [ none ]
          ]
        ]
      ] [ none ]
    ]
    either = doom/rayy 0 [ none ] [
      doom/t: / * - 384 doom/py 64 doom/rayy
      either > doom/t 0 [
        doom/hx: + doom/px / * doom/t doom/rayx 64
        either < doom/hx 768 [ none ] [
          either > doom/hx 1152 [ none ] [
            either < doom/t doom/best [
              doom/best: doom/t
              doom/bcolor: 2
              doom/bu: doom/hx
              doom/bmat: 2
            ] [ none ]
          ]
        ]
      ] [ none ]
    ]
    either = doom/rayx 0 [ none ] [
      doom/t: / * - 768 doom/px 64 doom/rayx
      either > doom/t 0 [
        doom/hy: + doom/py / * doom/t doom/rayy 64
        either < doom/hy 384 [ none ] [
          either > doom/hy 640 [ none ] [
            either < doom/t doom/best [
              doom/best: doom/t
              doom/bcolor: 1
              doom/bu: doom/hy
              doom/bmat: 1
            ] [ none ]
          ]
        ]
      ] [ none ]
    ]
    either = doom/rayy 0 [ none ] [
      doom/t: / * - 640 doom/py 64 doom/rayy
      either > doom/t 0 [
        doom/hx: + doom/px / * doom/t doom/rayx 64
        either < doom/hx 128 [ none ] [
          either > doom/hx 768 [ none ] [
            either < doom/t doom/best [
              doom/best: doom/t
              doom/bcolor: 1
              doom/bu: doom/hx
              doom/bmat: 0
            ] [ none ]
          ]
        ]
      ] [ none ]
    ]
    either = doom/rayx 0 [ none ] [
      doom/t: / * - 128 doom/px 64 doom/rayx
      either > doom/t 0 [
        doom/hy: + doom/py / * doom/t doom/rayy 64
        either < doom/hy 128 [ none ] [
          either > doom/hy 640 [ none ] [
            either < doom/t doom/best [
              doom/best: doom/t
              doom/bcolor: 1
              doom/bu: doom/hy
              doom/bmat: 3
            ] [ none ]
          ]
        ]
      ] [ none ]
    ]
    either = doom/door-open 64 [ none ] [
      either = doom/rayx 0 [ none ] [
        doom/t: / * - 768 doom/px 64 doom/rayx
        either > doom/t 0 [
          doom/hy: + doom/py / * doom/t doom/rayy 64
          either < doom/hy 256 [ none ] [
            either > doom/hy 384 [ none ] [
              either < doom/hy 320 [
                doom/cy: - 320 doom/hy
              ] [
                doom/cy: - doom/hy 320
              ]
              either >= doom/cy doom/door-open [
                either < doom/t doom/best [
                  doom/best: doom/t
                  doom/bcolor: 4
                  doom/bu: doom/hy
                  doom/bmat: 5
                ] [ none ]
              ] [ none ]
            ]
          ]
        ] [ none ]
      ]
    ]
    doom/half: / * doom/projection 64 either < doom/best 1 [ 1 ] [ doom/best ]
    doom/top: - doom/horizon doom/half
    doom/bot: + doom/horizon doom/half
    either < doom/top 0 [ doom/top: 0 ] [ none ]
    either > doom/bot 199 [ doom/bot: 199 ] [ none ]
    doom/shade: either < doom/best 256 [ 3 ] [
        either < doom/best 512 [ 2 ] [
            either < doom/best 1024 [ 1 ] [ 0 ]
        ]
    ]
    print doom/top
    print doom/bot
    print doom/bcolor
    print doom/bu
    print + * doom/bmat 4 doom/shade
]

