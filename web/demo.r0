;; web/demo.r0 -- R0 application for the WASM browser demo.
;;
;; This file is the single authoritative source.  A build/publish step
;; (web/build-docs.py) reads it and HTML-escapes the two marked sections to
;; generate the static code listings in docs/index.html.  The `;; @section`
;; markers are ordinary line comments; the R0 reader (web/demo.c) strips them
;; before parsing, so they have no runtime effect.
;;
;; The counter STATE and the increment LOGIC live entirely in R0.  On each
;; button click the JS glue calls the exported WASM entry `r0_click`, which
;; runs `do on-click` below; that increments the counter and asks the browser
;; to update the DOM through the small `web-set-int` HOST adapter.

[
;; @section application
counter: 0

on-click: [
    counter: + counter 1
    web-set-int 1 counter
]

;; @section raw
web-set-int: raw 2 [
    LIT 16 DIV
    >R
    LIT 16 DIV
    LIT 1000000 MUL
    R> ADD
    PRINT
    ARITY 0 EXIT
]
]
