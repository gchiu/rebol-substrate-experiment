t/cases: reduce [
    reduce [ 'p "F1 skip one" "a" reduce [ 4 ] 1 ]
    reduce [ 'p "F2 skip at end" "" reduce [ 4 ] 0 ]
    reduce [ 'p "F3 skip leading space" " a" reduce [ 4 ] 1 ]
    reduce [ 'p "F4 skip rejects trailing space" "a " reduce [ 4 ] 0 ]
    reduce [ 'p "F5 two skips over space" "a b" reduce [ reduce [ 4 ] reduce [ 4 ] ] 1 ]
    reduce [ 'p "F6 skip then literal" "a b" reduce [ reduce [ 4 ] "b" ] 1 ]
    reduce [ 'm "F7 to finds target, leaves it" "abc" reduce [ 5 "b" ] 1 1 ]
    reduce [ 'm "F8 thru consumes target" "abc" reduce [ 6 "b" ] 1 2 ]
    reduce [ 'p "F9 to then target literal" "abc" reduce [ reduce [ 5 "b" ] "b" "c" ] 1 ]
    reduce [ 'p "F10 to then wrong literal" "abc" reduce [ reduce [ 5 "b" ] "c" ] 0 ]
    reduce [ 'p "F11 to failure alternative" "abc" reduce [ reduce [ 5 "z" ] 0 "abc" ] 1 ]
    reduce [ 'p "F12 thru failure alternative" "abc" reduce [ reduce [ 6 "z" ] 0 "abc" ] 1 ]
]
t/run 0
t/done "F1 (Stage 2A) tests"
