;; experiments/glon-latex/latex-tests.glon -- GLON-LATEX v001 regression tests.
;;
;; Run after latex.glon in ONE glon session (see Makefile). Every check compares
;; an exact result; a failure prints its name, what was produced and what was
;; expected. The last line raises a SIN! when anything failed, so the glon exit
;; status is 1 on failure and 0 on success.

lt/pass: 0
lt/fail: 0

lt/ok: func [name] [ lt/pass: + lt/pass 1 ]
lt/bad: func [name] [ lt/fail: + lt/fail 1  s/print s/+ "FAIL " name ]

;; lt/str: a string result against the expected string
lt/str: func [name got want] [
    either s/= got want [ lt/ok name ] [
        lt/bad name
        s/print s/+ "  got:  " got
        s/print s/+ "  want: " want
    ]
]
;; lt/tex: the bare LaTeX of a term against the expected string
lt/tex: func [name got want] [ lt/str name l/text got want ]
;; lt/num: an integer result against the expected integer
lt/num: func [name got want] [
    either = got want [ lt/ok name ] [
        lt/bad name
        print got
        print want
    ]
]
;; lt/sin: a judged block must raise SIN! with this id
lt/sin: func [name e id] [
    either sin? e [
        either = sin-id e id [ lt/ok name ] [ lt/bad name ]
    ] [ lt/bad name ]
]

;; ---- 1. coexistence: the same session, both vocabularies --------------------
do [
lt/num "numeric + still adds"         + 1 2 3
lt/num "numeric prefix nesting"       + 1 * 2 3 7
lt/num "numeric - and /"              - 10 / 9 2 6
lt/tex "latex l/+ describes"          l/+ 1 2 "1+2"
lt/tex "latex nesting mirrors numeric" l/+ 1 l/* 2 3 "1+2 \cdot 3"
lt/tex "latex - and frac"             l/- 10 l/frac 9 2 "10-\frac{9}{2}"
;; numeric words evaluate inside a latex expression (eagerly, to atoms)
lt/tex "numeric result as latex atom" l/^ "x" + 1 2 "x^{3}"
lt/tex "numeric product as atom"      l/* "n" * 6 7 "n \cdot 42"
;; and the latex vocabulary leaves numeric results untouched afterwards
lt/num "numeric after latex"          * + 2 3 4 20
]

;; ---- 2. atoms ---------------------------------------------------------------
do [
lt/tex "zero"                  0 "0"
lt/tex "multi-digit integer"   1234567 "1234567"
lt/tex "negative integer"      -42 "-42"
lt/tex "string atom"           "\pi" "\pi"
lt/tex "decimal via string"    "2.15" "2.15"
lt/tex "term passes through"   l/term l/term "x" "x"
]

;; ---- 3. addition and subtraction ---------------------------------------------
do [
lt/tex "a+b"                   l/+ "a" "b" "a+b"
lt/tex "left-nested +"         l/+ l/+ "a" "b" "c" "a+b+c"
lt/tex "right-nested + kept"   l/+ "a" l/+ "b" "c" "a+\left(b+c\right)"
lt/tex "left-nested -"         l/- l/- "a" "b" "c" "a-b-c"
lt/tex "right-nested - kept"   l/- "a" l/- "b" "c" "a-\left(b-c\right)"
lt/tex "a-(b+c)"               l/- "a" l/+ "b" "c" "a-\left(b+c\right)"
lt/tex "(a-b)+c"               l/+ l/- "a" "b" "c" "a-b+c"
lt/tex "a+(-b)"                l/+ "a" l/neg "b" "a+\left(-b\right)"
lt/tex "a-(-3)"                l/- "a" -3 "a-\left(-3\right)"
lt/tex "-a+b"                  l/+ l/neg "a" "b" "-a+b"
lt/tex "a+b*c"                 l/+ "a" l/* "b" "c" "a+b \cdot c"
lt/tex "a-b*c"                 l/- "a" l/* "b" "c" "a-b \cdot c"
]

;; ---- 4. multiplication --------------------------------------------------------
do [
lt/tex "(a+b)*c"               l/* l/+ "a" "b" "c" "\left(a+b\right) \cdot c"
lt/tex "a*(b+c)"               l/* "a" l/+ "b" "c" "a \cdot \left(b+c\right)"
lt/tex "(a-b)*(c-d)"           l/* l/- "a" "b" l/- "c" "d" "\left(a-b\right) \cdot \left(c-d\right)"
lt/tex "left-nested *"         l/* l/* "a" "b" "c" "a \cdot b \cdot c"
lt/tex "right-nested * kept"   l/* "a" l/* "b" "c" "a \cdot \left(b \cdot c\right)"
lt/tex "(-a)*b"                l/* l/neg "a" "b" "\left(-a\right) \cdot b"
lt/tex "a*(-b)"                l/* "a" l/neg "b" "a \cdot \left(-b\right)"
lt/tex "2*(-3)"                l/* 2 -3 "2 \cdot \left(-3\right)"
lt/tex "a*b^2"                 l/* "a" l/^ "b" 2 "a \cdot b^{2}"
lt/tex "a*frac"                l/* "a" l/frac 1 2 "a \cdot \frac{1}{2}"
lt/tex "frac*a"                l/* l/frac 1 2 "a" "\frac{1}{2} \cdot a"
]

;; ---- 5. exponentiation ----------------------------------------------------------
do [
lt/tex "x^2"                   l/^ "x" 2 "x^{2}"
lt/tex "e^(1+x) exponent braced" l/^ "e" l/+ 1 "x" "e^{1+x}"
lt/tex "(1+x)^2 base kept"     l/^ l/+ 1 "x" 2 "\left(1+x\right)^{2}"
lt/tex "(a*b)^2"               l/^ l/* "a" "b" 2 "\left(a \cdot b\right)^{2}"
lt/tex "(a^b)^c"               l/^ l/^ "a" "b" "c" "\left(a^{b}\right)^{c}"
lt/tex "a^(b^c)"               l/^ "a" l/^ "b" "c" "a^{b^{c}}"
lt/tex "(-3)^2"                l/^ -3 2 "\left(-3\right)^{2}"
lt/tex "(-a)^2"                l/^ l/neg "a" 2 "\left(-a\right)^{2}"
lt/tex "-(a^2)"                l/neg l/^ "a" 2 "-a^{2}"
lt/tex "x^(-1)"                l/^ "x" -1 "x^{-1}"
lt/tex "(frac)^2"              l/^ l/frac 1 2 2 "\left(\frac{1}{2}\right)^{2}"
lt/tex "sqrt base unwrapped"   l/^ l/sqrt "x" 2 "\sqrt{x}^{2}"
]

;; ---- 6. negation ------------------------------------------------------------------
do [
lt/tex "-a"                    l/neg "a" "-a"
lt/tex "-(a+b)"                l/neg l/+ "a" "b" "-\left(a+b\right)"
lt/tex "-(-a)"                 l/neg l/neg "a" "-\left(-a\right)"
lt/tex "-(a*b)"                l/neg l/* "a" "b" "-a \cdot b"
lt/tex "-(-3)"                 l/neg -3 "-\left(-3\right)"
]

;; ---- 7. fractions and roots ----------------------------------------------------------
do [
lt/tex "frac groups by braces" l/frac l/+ "a" "b" l/- "c" "d" "\frac{a+b}{c-d}"
lt/tex "1/(1-x)"               l/frac 1 l/- 1 "x" "\frac{1}{1-x}"
lt/tex "nested frac"           l/frac l/frac 1 2 3 "\frac{\frac{1}{2}}{3}"
lt/tex "sqrt groups by braces" l/sqrt l/+ "x" 1 "\sqrt{x+1}"
lt/tex "sqrt of negative"      l/sqrt -1 "\sqrt{-1}"
]

;; ---- 8. relations --------------------------------------------------------------------
do [
lt/tex "a=b"                   l/= "a" "b" "a=b"
lt/tex "sum = sum"             l/= l/+ "a" "b" l/+ "b" "a" "a+b=b+a"
lt/tex "(a=b)=c"               l/= l/= "a" "b" "c" "\left(a=b\right)=c"
]

;; ---- 9. rendering ------------------------------------------------------------------
do [
lt/str "inline"                l/inline l/^ "x" 2 "$x^{2}$"
lt/str "display"               l/render l/^ "x" 2 "\[x^{2}\]"
lt/str "render a bare operand" l/render 7 "\[7\]"
lt/str "quadratic formula"
    l/render l/= "x" l/frac l/+ l/neg "b" l/sqrt l/- l/^ "b" 2 l/* l/* 4 "a" "c" l/* 2 "a"
    "\[x=\frac{-b+\sqrt{b^{2}-4 \cdot a \cdot c}}{2 \cdot a}\]"
lt/str "geometric series"
    l/render l/= l/^ l/- 1 "x" -1 l/frac 1 l/- 1 "x"
    "\[\left(1-x\right)^{-1}=\frac{1}{1-x}\]"
lt/str "pythagoras"
    l/render l/= l/+ l/^ "a" 2 l/^ "b" 2 l/^ "c" 2
    "\[a^{2}+b^{2}=c^{2}\]"
;; one tree, two vocabularies: the numeric value beside its notation
lt/num "the same shape, numerically"  - * + 2 3 4 / 9 3  17
lt/tex "the same shape, as latex"     l/- l/* l/+ 2 3 4 l/frac 9 3  "\left(2+3\right) \cdot 4-\frac{9}{3}"
]

;; ---- 10. errors ------------------------------------------------------------------------
do [
lt/sin "word operand is a type error"  judge [ l/+ 'x 1 ] 'l/term
lt/sin "block operand is a type error" judge [ l/text reduce [ 1 2 3 ] ] 'l/term
lt/sin "none operand is a type error"  judge [ l/neg none ] 'l/term
]

;; ---- summary -----------------------------------------------------------------------
print lt/pass
print lt/fail
either = lt/fail 0 [ s/print "glon-latex v001: all tests passed" ] [
    raise create-sin 'test 'failed lt/fail
]
