;; experiments/glon-iter/dump-v004.glon -- the REFERENCE token walk: the frozen
;; Pratt v004 lexer (p/token) over a whole source string. Load after
;; ../glon-pratt/s-extra.glon and ../glon-pratt/pratt.glon (both unmodified).
;; Driven by build/v004-NN.glon (iter_corpus.mjs).
do [
d/src: none
d/pos: 0
d/done: 0
d/line: func [tk] [
    s/print s/+ s/from-int block-at tk 0 s/+ " " s/+ s/from-int block-at tk 1 s/+ " " s/+ s/from-int block-at tk 2 s/+ " " s/from-int block-at tk 3
]
d/start: func [src] [ d/src: src  d/pos: 0  d/done: 0 ]
d/one: func [z] [
    d-tk: p/token d/src d/pos
    either = block-at d-tk 0 p/k-end [ s/print s/+ "end " s/from-int block-at d-tk 1  d/done: 1 ] [
        d/line d-tk  d/pos: block-at d-tk 2
    ]
]
d/steps: func [k] [
    either either = k 0 [ 1 ] [ d/done ] [ none ] [
        d-e: judge [ d/one 0 ]
        either sin? d-e [
            s/print s/+ "error " s/+ s/from-int block-at sin-arg d-e 1 s/+ ": " block-at sin-arg d-e 0
            d/done: 1
        ] [ none ]
        d/steps - k 1
    ]
]
]
