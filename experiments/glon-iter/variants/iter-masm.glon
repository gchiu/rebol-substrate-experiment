;; experiments/glon-iter/variants/iter-masm.glon -- GLON-ITER v001, the MEASURED
;; ALTERNATIVE (not adopted): iter.glon with its fragment search and argument
;; checks done by masm loops instead of balanced Glon recursion. The API and
;; behaviour are identical, and the same tests pass. GLON-ITER-V001.md compares
;; the costs: 586 code cells against 27, in exchange for a cheaper crossing of
;; many fragments. Everything below the line "MASM VARIANT" differs from
;; iter.glon only in it/full, it/strings? and it/iter?.
;;
;; (iter.glon header follows)
;;
;; After Chris Ross-Gill's iterator concept: an iterator is a value that keeps
;; its own traversal state between calls, so a consumer asks for "the next
;; value" instead of carrying a source and a position through every call.
;;
;;   it/bytes frags   an iterator over a BLOCK! of STRING!s, read as one byte
;;                    stream (empty fragments are allowed anywhere)
;;   it/peek i        the current byte (0..255), without advancing; it/end at the end
;;   it/peek2 i       the byte after the current one; it/end if there is none
;;   it/next i        the current byte, then advance past it; it/end at the end
;;   it/pos i         the 0-based byte offset of the cursor, counted across fragments
;;   it/skip i set    advance past the run of bytes that are in the string `set`;
;;                    returns the new it/pos. Allocates nothing.
;;   it/take i set    the same advance, returning that run as a NEW string
;;   it/end           the end-of-stream marker; it/end? v is 1 only for it
;;
;; END OF STREAM. it/end is a unique BLOCK!, and = compares blocks by identity
;; (GLON-ALPHA-LAWS.md §9), so no byte, no NONE and no 0 can equal it. At the
;; end, peek/peek2/next keep returning it/end, skip returns the final position
;; and take returns "".
;;
;; THE PROTOCOL. An iterator is a one-element BLOCK! holding a closure
;; func [m x]; the words above send it a message number m (0 peek, 1 next,
;; 2 pos, 3 peek2, 4 skip, 5 take) with argument x. The block matters: a
;; closure is CALLED wherever its word is evaluated, so a bare closure could not
;; be passed by name. Any iterator that answers messages 0-2 (peek, next, pos)
;; works with it/peek, it/next and it/pos; iter-lexer.glon's token stream is one.
;; The public words check their arguments and raise SIN! 'type: block-at and
;; invoke are unchecked, and a non-iterator would otherwise fail-stop the machine.
;;
;; STATE. The constructor's PARAMETERS hold the state (fragment index, byte
;; index within it, absolute position). Parameters are always local, and the
;; closure updates them in place with set-words. Every other local name has an
;; it- prefix, because a set-word updates the nearest existing binding, which
;; can be a global.
;;
;; BOUNDED RETURN STACK. No operation recurses once per byte or once per
;; fragment:
;;   - within a fragment, a run is scanned by s/scan-set (a masm loop);
;;   - fragments are searched, counted, joined and validated by BALANCED
;;     recursion over fragment ranges: depth about log2(fragments), and
;;     none when the run ends inside its own fragment (the parser's case).
;; GLON-ITER-V001.md compares this with a masm cross-fragment scanner
;; (variants/iter-masm.glon): equally bounded, but 586 cells of code space.
;;
;; Requires prelude.glon, strings.glon and demo/shop/strings-ext.glon.
;; Wrapped in [ ] because it contains masm.
[
it/end: reduce [ 'end ]
it/end?: func [v] [ = v it/end ]

;; ---- MASM VARIANT ----
;; it/raw-full ( frags:block! f:int set:string! -> int ): UNCHECKED. The first
;; index j >= f such that element j is not a STRING!, or is a string containing
;; a byte that is not in `set`; the block length if there is none. Requires
;; 0 <= f. A nested loop over fragments, bytes and the set needs more than the
;; safe scratch cells A/B/C/F, so it keeps its state in a 16-cell workspace: a
;; length-0 STRING!, which the collector never scans (the s/raw-scan-set
;; discipline). The inputs stay on the data stack (GC roots) across that one
;; allocation; nothing allocates in the loop, so the raw pointers stay valid.
;;   W+1 block base   W+2 block length   W+3 set base   W+4 set length
;;   W+5 current string base   W+6 bytes of it still to check
it/raw-full: masm 3 [
    LIT SCRATCH_C ! LIT SCRATCH_B ! LIT SCRATCH_A !
    LIT SCRATCH_A @ LIT SCRATCH_B @ LIT SCRATCH_C @
    LIT 16 LIT GC_KIND_STRING CALL alloc LIT SCRATCH_F !
    LIT SCRATCH_C ! LIT SCRATCH_B ! LIT SCRATCH_A !
    LIT 0 LIT SCRATCH_F @ !
    LIT SCRATCH_A @ DUP LIT 16 MOD SUB LIT SCRATCH_F @ LIT 1 ADD !
    LIT SCRATCH_F @ LIT 1 ADD @ @ LIT SCRATCH_F @ LIT 2 ADD !
    LIT SCRATCH_C @ LIT T_STRING SUB LIT SCRATCH_F @ LIT 3 ADD !
    LIT SCRATCH_C @ LIT T_STRING SUB @ LIT SCRATCH_F @ LIT 4 ADD !
    LIT SCRATCH_B @ LIT 16 DIV LIT SCRATCH_B !
  it-full-frag:
    LIT SCRATCH_B @ LIT SCRATCH_F @ LIT 2 ADD @ LT ZBRANCH it-full-done
    LIT SCRATCH_F @ LIT 1 ADD @ LIT 2 ADD LIT SCRATCH_B @ ADD @ LIT SCRATCH_A !
    LIT SCRATCH_A @ LIT 16 MOD LIT T_STRING EQ ZBRANCH it-full-done
    LIT SCRATCH_A @ LIT T_STRING SUB LIT SCRATCH_F @ LIT 5 ADD !
    LIT SCRATCH_A @ LIT T_STRING SUB @ LIT SCRATCH_F @ LIT 6 ADD !
  it-full-byte:
    LIT SCRATCH_F @ LIT 6 ADD @ ZBRANCH it-full-next
    LIT SCRATCH_F @ LIT 5 ADD @ LIT SCRATCH_F @ LIT 6 ADD @ ADD @ LIT SCRATCH_C !
    LIT SCRATCH_F @ LIT 4 ADD @ LIT SCRATCH_A !
  it-full-set:
    LIT SCRATCH_A @ ZBRANCH it-full-done
    LIT SCRATCH_A @ LIT 1 SUB LIT SCRATCH_A !
    LIT SCRATCH_F @ LIT 3 ADD @ LIT 1 ADD LIT SCRATCH_A @ ADD @ LIT SCRATCH_C @ EQ ZBRANCH it-full-set
    LIT SCRATCH_F @ LIT 6 ADD @ LIT 1 SUB LIT SCRATCH_F @ LIT 6 ADD !
    BRANCH it-full-byte
  it-full-next:
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_B !
    BRANCH it-full-frag
  it-full-done:
    LIT SCRATCH_B @ LIT 16 MUL ARITY 1 EXIT
]

;; it/raw-frags? ( v -> int ): safe for any value (it reads only type tags).
;; 1 when v is a BLOCK! whose elements are all STRING!s, else 0. One loop, no
;; allocation.
it/raw-frags?: masm 1 [
    DUP LIT 16 MOD LIT T_BLOCK EQ ZBRANCH it-fr-no
    DUP LIT 16 MOD SUB LIT SCRATCH_A !
    LIT 0 LIT SCRATCH_B !
  it-fr-loop:
    LIT SCRATCH_B @ LIT SCRATCH_A @ @ LT ZBRANCH it-fr-yes
    LIT SCRATCH_A @ LIT 2 ADD LIT SCRATCH_B @ ADD @ LIT 16 MOD LIT T_STRING EQ ZBRANCH it-fr-no0
    LIT SCRATCH_B @ LIT 1 ADD LIT SCRATCH_B !
    BRANCH it-fr-loop
  it-fr-yes:
    INT 1 ARITY 1 EXIT
  it-fr-no:
    DROP
  it-fr-no0:
    INT 0 ARITY 1 EXIT
]

;; it/raw-iter? ( v -> int ): safe for any value. 1 when v is a non-empty
;; BLOCK! whose first element is a closure (an iterator), else 0. masm has no
;; T_CLOSURE name, so the tag is the literal 8 (T_CLOSURE in r0_s1.h).
it/raw-iter?: masm 1 [
    DUP LIT 16 MOD LIT T_BLOCK EQ ZBRANCH it-iter-no
    DUP LIT 16 MOD SUB DUP @ ZBRANCH it-iter-empty
    LIT 2 ADD @ LIT 16 MOD LIT 8 EQ LIT 16 MUL ARITY 1 EXIT
  it-iter-empty:
    DROP INT 0 ARITY 1 EXIT
  it-iter-no:
    DROP INT 0 ARITY 1 EXIT
]

it/iter?: func [i] [ it/raw-iter? i ]
it/peek:  func [i] [ either it/iter? i [ invoke block-at i 0 0 none ] [ raise create-sin 'type 'it/peek i ] ]
it/next:  func [i] [ either it/iter? i [ invoke block-at i 0 1 none ] [ raise create-sin 'type 'it/next i ] ]
it/pos:   func [i] [ either it/iter? i [ invoke block-at i 0 2 none ] [ raise create-sin 'type 'it/pos i ] ]
it/peek2: func [i] [ either it/iter? i [ invoke block-at i 0 3 none ] [ raise create-sin 'type 'it/peek2 i ] ]
it/skip:  func [i set] [ it/run i set 4 'it/skip ]
it/take:  func [i set] [ it/run i set 5 'it/take ]
it/run: func [i set m op] [
    either it/iter? i [
        either s/raw-string? set [ invoke block-at i 0 m set ] [ raise create-sin 'type op set ]
    ] [ raise create-sin 'type op i ]
]

;; Balanced recursion over the fragment range [a, b) of frags: each call
;; splits the range at its midpoint / + a b 2, so the depth is about
;; log2(b - a) whatever the input's length.
;; it/full: the first fragment in [a, b) NOT made entirely of bytes in `set`
;; (with set "", the first non-empty one); b if there is none. An empty
;; fragment is skipped without a scan (s/scan-set allocates a workspace).
it/full: func [frags a b set] [ it/raw-full frags a set ]   ;; b is always the block length
;; it/lens: the total length of fragments [a, b)
it/lens: func [frags a b] [
    either >= a b [ 0 ] [
        either = b + a 1 [ s/length block-at frags a ] [
            + it/lens frags a / + a b 2 it/lens frags / + a b 2 b
        ]
    ]
]
;; it/join: fragments [a, b) joined into one string
it/join: func [frags a b] [
    either >= a b [ "" ] [
        either = b + a 1 [ block-at frags a ] [
            s/+ it/join frags a / + a b 2 it/join frags / + a b 2 b
        ]
    ]
]
;; it/strings?: 1 when every element of [a, b) is a STRING!
it/strings?: func [frags a b] [ it/raw-frags? frags ]   ;; always the whole block

;; it/live frags f: f, or the first non-empty fragment after it (or the end)
it/live: func [frags f] [
    either < f block-len frags [
        either = s/length block-at frags f 0 [ it/full frags f block-len frags "" ] [ f ]
    ] [ f ]
]
;; it/gather: the bytes from (f0, i0) up to (f1, i1)
it/gather: func [frags f0 i0 f1 i1] [
    either = f0 f1 [ s/span block-at frags f0 i0 i1 ] [
        s/+ s/+ s/span block-at frags f0 i0 s/length block-at frags f0
                it/join frags + f0 1 f1
            either < f1 block-len frags [ s/span block-at frags f1 0 i1 ] [ "" ]
    ]
]

it/bytes: func [frags] [
    either it/raw-frags? frags [
        it/bytes* frags it/live frags 0 0 0
    ] [ raise create-sin 'type 'it/bytes frags ]
]
;; Invariant: it-f is the block length (the end) or a NON-EMPTY fragment, and
;; it-i is a valid index into it.
it/bytes*: func [frags it-f it-i it-n] [
    reduce [ func [m x] [
        either = m 2 [ it-n ] [
            either < it-f block-len frags [
                either = m 0 [ s/at block-at frags it-f it-i ] [
                    either = m 1 [
                        it-b: s/at block-at frags it-f it-i
                        it-i: + it-i 1  it-n: + it-n 1
                        either < it-i s/length block-at frags it-f [ none ] [
                            it-f: it/live frags + it-f 1  it-i: 0
                        ]
                        it-b
                    ] [
                        either = m 3 [
                            either < + it-i 1 s/length block-at frags it-f [ s/at block-at frags it-f + it-i 1 ] [
                                it-g: it/live frags + it-f 1
                                either < it-g block-len frags [ s/at block-at frags it-g 0 ] [ it/end ]
                            ]
                        ] [
                            ;; 4 skip, 5 take: the run of bytes in x
                            it-f0: it-f  it-i0: it-i
                            it-e: s/scan-set block-at frags it-f it-i x
                            either < it-e s/length block-at frags it-f [
                                it-n: + it-n - it-e it-i  it-i: it-e
                            ] [
                                it-g: it/full frags + it-f 1 block-len frags x
                                it-n: + it-n + - s/length block-at frags it-f it-i it/lens frags + it-f 1 it-g
                                it-f: it-g  it-i: 0
                                either < it-f block-len frags [
                                    it-i: s/scan-set block-at frags it-f 0 x  it-n: + it-n it-i
                                ] [ none ]
                            ]
                            either = m 4 [ it-n ] [ it/gather frags it-f0 it-i0 it-f it-i ]
                        ]
                    ]
                ]
            ] [ either = m 4 [ it-n ] [ either = m 5 [ "" ] [ it/end ] ] ]
        ]
    ] ]
]
]
