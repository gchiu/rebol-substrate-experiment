doom/objects-on: 0
doom/light-phase: 0

doom/status-block: [
    doom/alien-dx: - doom/alien-x doom/px
    doom/alien-dy: - doom/alien-y doom/py
    doom/td2: + * doom/alien-dx doom/alien-dx * doom/alien-dy doom/alien-dy
    doom/tdepth: / + * doom/alien-dx doom/dirx * doom/alien-dy doom/diry 64
    doom/tside: / + * doom/alien-dx doom/planex * doom/alien-dy doom/planey 64
    doom/los doom/alien-x doom/alien-y
    doom/alien-visible: 0
    doom/alien-sx: 0
    doom/alien-sprite-h: 0
    doom/alien-left: 0
    doom/alien-right: 0
    doom/alien-top: 0
    doom/alien-bot: 0
    either > doom/tdepth 0 [
        doom/alien-sx: + 160 / * doom/tside 160 doom/tdepth
        doom/alien-sprite-h: / * 96 doom/projection doom/tdepth
        doom/alien-left: - doom/alien-sx / doom/alien-sprite-h 4
        doom/alien-right: + doom/alien-sx / doom/alien-sprite-h 4
        doom/alien-top: - doom/horizon / doom/alien-sprite-h 2
        doom/alien-bot: + doom/horizon / doom/alien-sprite-h 2
        either = doom/occluded 0 [
            either >= doom/alien-sx -40 [
                either <= doom/alien-sx 359 [ doom/alien-visible: 1 ] [ none ]
            ] [ none ]
        ] [ none ]
    ] [ none ]
    print doom/door-open
    print doom/door-blocked
    print doom/door-target
    print doom/alien-x
    print doom/alien-y
    print doom/alien-health
    print doom/alien-state
    print doom/alien-detected
    print doom/td2
    print doom/tside
    print doom/tdepth
    print doom/alien-visible
    print doom/alien-left
    print doom/alien-right
    print doom/alien-top
    print doom/alien-bot
    print doom/light-phase
    print doom/ammo
    print doom/player-hit
    print doom/e2dep
]

doom/sector-report: does [
    print block-at doom/sector 2
    print block-at doom/sector 3
]

doom/report: does [
    print doom/px
    print doom/py
    print doom/angle
]

doom/valid: does [
    doom/hit: 0
    doom/check-all doom/px doom/py doom/radius2
    print either = doom/hit 0 [ 1 ] [ 0 ]
]
]
