doom/detail-line: func [x1 y1 x2 y2 z c] [
    doom/e1dx: - x1 doom/px
    doom/e1dy: - y1 doom/py
    doom/e1dep: / + * doom/e1dx doom/dirx * doom/e1dy doom/diry 64
    doom/e1side: / - * doom/e1dx doom/diry * doom/e1dy doom/dirx 64
    doom/e2dx: - x2 doom/px
    doom/e2dy: - y2 doom/py
    doom/e2dep: / + * doom/e2dx doom/dirx * doom/e2dy doom/diry 64
    doom/e2side: / - * doom/e2dx doom/diry * doom/e2dy doom/dirx 64
    doom/dvis: 0
    either > doom/e1dep 0 [
        either > doom/e2dep 0 [
            doom/dvis: 1
        ] [
            doom/dt: / * - 0 doom/e1dep 1024 - doom/e2dep doom/e1dep
            doom/e2side: + doom/e1side / * - doom/e2side doom/e1side doom/dt 1024
            doom/e2dep: 1
            doom/dvis: 1
        ]
    ] [
        either > doom/e2dep 0 [
            doom/dt: / * - 0 doom/e2dep 1024 - doom/e1dep doom/e2dep
            doom/e1side: + doom/e2side / * - doom/e1side doom/e2side doom/dt 1024
            doom/e1dep: 1
            doom/dvis: 1
        ] [ none ]
    ]
    either = doom/dvis 1 [
        doom/e1sx: + 160 / * doom/e1side doom/focal-h doom/e1dep
        doom/e1sy: - doom/horizon / * - z doom/eye doom/projection doom/e1dep
        doom/e2sx: + 160 / * doom/e2side doom/focal-h doom/e2dep
        doom/e2sy: - doom/horizon / * - z doom/eye doom/projection doom/e2dep
        print 1
        print doom/e1sx
        print doom/e1sy
        print doom/e2sx
        print doom/e2sy
        print c
    ] [
        print 0
        print 0
        print 0
        print 0
        print 0
        print c
    ]
]
doom/detail-block: [
    print 38
    doom/detail-line 256 128 256 640 0 5
    doom/detail-line 512 128 512 640 0 5
    doom/detail-line 128 256 768 256 0 5
    doom/detail-line 128 512 768 512 0 5
    doom/detail-line 832 256 832 384 0 5
    doom/detail-line 960 256 960 384 0 5
    doom/detail-line 1088 256 1088 384 0 5
    doom/detail-line 1216 256 1216 384 0 5
    doom/detail-line 1152 448 1280 448 0 5
    doom/detail-line 1152 576 1280 576 0 5
    doom/detail-line 1152 704 1280 704 0 5
    doom/detail-line 1152 832 1280 832 0 5
    doom/detail-line 1152 960 1280 960 0 5
    doom/detail-line 800 320 1280 320 0 8
    doom/detail-line 1216 384 1216 1024 0 8
    doom/detail-line 768 280 1280 280 0 10
    doom/detail-line 768 360 1280 360 0 10
    doom/detail-line 1176 384 1176 1024 0 10
    doom/detail-line 1256 384 1256 1024 0 10
    doom/detail-line 256 128 256 640 128 5
    doom/detail-line 512 128 512 640 128 5
    doom/detail-line 128 256 768 256 128 5
    doom/detail-line 128 512 768 512 128 5
    doom/detail-line 832 256 832 384 128 5
    doom/detail-line 960 256 960 384 128 5
    doom/detail-line 1088 256 1088 384 128 5
    doom/detail-line 1216 256 1216 384 128 5
    doom/detail-line 1152 448 1280 448 128 5
    doom/detail-line 1152 576 1280 576 128 5
    doom/detail-line 1152 704 1280 704 128 5
    doom/detail-line 1152 832 1280 832 128 5
    doom/detail-line 1152 960 1280 960 128 5
    doom/detail-line 896 280 896 360 128 9
    doom/detail-line 1088 280 1088 360 128 9
    doom/detail-line 1176 480 1256 480 128 9
    doom/detail-line 1176 640 1256 640 128 9
    doom/detail-line 1176 800 1256 800 128 9
    doom/detail-line 1176 960 1256 960 128 9
]

doom/status-block: [
    doom/alien-dx: - doom/alien-x doom/px
    doom/alien-dy: - doom/alien-y doom/py
    doom/td2: + * doom/alien-dx doom/alien-dx * doom/alien-dy doom/alien-dy
    doom/tdepth: / + * doom/alien-dx doom/dirx * doom/alien-dy doom/diry 64
    doom/tside: / + * doom/alien-dx doom/planex * doom/alien-dy doom/planey 64
    doom/los doom/alien-x doom/alien-y
    doom/alien-visible: 0
    doom/alien-sx: 0
    doom/alien-sprite-h: 0
    doom/alien-left: 0
    doom/alien-right: 0
    doom/alien-top: 0
    doom/alien-bot: 0
    either > doom/tdepth 0 [
        doom/alien-sx: + 160 / * doom/tside 160 doom/tdepth
        doom/alien-sprite-h: / * 96 doom/projection doom/tdepth
        doom/alien-left: - doom/alien-sx / doom/alien-sprite-h 4
        doom/alien-right: + doom/alien-sx / doom/alien-sprite-h 4
        doom/alien-top: - doom/horizon / doom/alien-sprite-h 2
        doom/alien-bot: + doom/horizon / doom/alien-sprite-h 2
        either = doom/occluded 0 [
            either >= doom/alien-sx -40 [
                either <= doom/alien-sx 359 [ doom/alien-visible: 1 ] [ none ]
            ] [ none ]
        ] [ none ]
    ] [ none ]
    print doom/door-open
    print doom/door-blocked
    print doom/door-target
    print doom/alien-x
    print doom/alien-y
    print doom/alien-health
    print doom/alien-state
    print doom/alien-detected
    print doom/td2
    print doom/tside
    print doom/tdepth
    print doom/alien-visible
    print doom/alien-left
    print doom/alien-right
    print doom/alien-top
    print doom/alien-bot
]

doom/sector-report: does [
    print block-at doom/sector 2
    print block-at doom/sector 3
]

doom/report: does [
    print doom/px
    print doom/py
    print doom/angle
]

doom/valid: does [
    doom/hit: 0
    doom/check-all doom/px doom/py doom/radius2
    print either = doom/hit 0 [ 1 ] [ 0 ]
]
]
