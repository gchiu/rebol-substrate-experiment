;; G5h isolated prepared-wall prototype and correctness harness.
;; Same masm workers as raw-wall.glon, plus fixed/generic ray wrappers.
[
w/setup: masm 4 [
    LIT 16 DIV LIT SCRATCH_D !
    LIT 16 DIV LIT SCRATCH_C !
    LIT 16 DIV LIT SCRATCH_B !
    LIT 16 DIV LIT SCRATCH_A !
    LIT 100000 LIT SCRATCH_E !
    LIT 0 LIT SCRATCH_F !
    ARITY 0 EXIT
]
w/walls1: masm 0 [
    LIT SCRATCH_D @ ZBRANCH none1 LIT 128 LIT SCRATCH_B @ SUB LIT 64 MUL LIT SCRATCH_D @ DIV DUP LIT 0 GT ZBRANCH drop1 DUP LIT SCRATCH_C @ MUL LIT 64 DIV LIT SCRATCH_A @ ADD DUP LIT 128 GE ZBRANCH drop21 DUP LIT 768 LE ZBRANCH drop21 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop1 DUP LIT SCRATCH_E ! LIT 8 LIT SCRATCH_F ! DROP BRANCH done1 none1: BRANCH done1 drop1: DROP BRANCH done1 drop21: DROP DROP BRANCH done1 done1: LIT SCRATCH_C @ ZBRANCH none2 LIT 768 LIT SCRATCH_A @ SUB LIT 64 MUL LIT SCRATCH_C @ DIV DUP LIT 0 GT ZBRANCH drop2 DUP LIT SCRATCH_D @ MUL LIT 64 DIV LIT SCRATCH_B @ ADD DUP LIT 128 GE ZBRANCH drop22 DUP LIT 256 LE ZBRANCH drop22 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop2 DUP LIT SCRATCH_E ! LIT 9 LIT SCRATCH_F ! DROP BRANCH done2 none2: BRANCH done2 drop2: DROP BRANCH done2 drop22: DROP DROP BRANCH done2 done2: LIT SCRATCH_D @ ZBRANCH none3 LIT 256 LIT SCRATCH_B @ SUB LIT 64 MUL LIT SCRATCH_D @ DIV DUP LIT 0 GT ZBRANCH drop3 DUP LIT SCRATCH_C @ MUL LIT 64 DIV LIT SCRATCH_A @ ADD DUP LIT 768 GE ZBRANCH drop23 DUP LIT 1280 LE ZBRANCH drop23 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop3 DUP LIT SCRATCH_E ! LIT 18 LIT SCRATCH_F ! DROP BRANCH done3 none3: BRANCH done3 drop3: DROP BRANCH done3 drop23: DROP DROP BRANCH done3 done3: LIT SCRATCH_C @ ZBRANCH none4 LIT 1280 LIT SCRATCH_A @ SUB LIT 64 MUL LIT SCRATCH_C @ DIV DUP LIT 0 GT ZBRANCH drop4 DUP LIT SCRATCH_D @ MUL LIT 64 DIV LIT SCRATCH_B @ ADD DUP LIT 256 GE ZBRANCH drop24 DUP LIT 1024 LE ZBRANCH drop24 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop4 DUP LIT SCRATCH_E ! LIT 28 LIT SCRATCH_F ! DROP BRANCH done4 none4: BRANCH done4 drop4: DROP BRANCH done4 drop24: DROP DROP BRANCH done4 done4: LIT SCRATCH_D @ ZBRANCH none5 LIT 1024 LIT SCRATCH_B @ SUB LIT 64 MUL LIT SCRATCH_D @ DIV DUP LIT 0 GT ZBRANCH drop5 DUP LIT SCRATCH_C @ MUL LIT 64 DIV LIT SCRATCH_A @ ADD DUP LIT 1152 GE ZBRANCH drop25 DUP LIT 1280 LE ZBRANCH drop25 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop5 DUP LIT SCRATCH_E ! LIT 24 LIT SCRATCH_F ! DROP BRANCH done5 none5: BRANCH done5 drop5: DROP BRANCH done5 drop25: DROP DROP BRANCH done5 done5:
    ARITY 0 EXIT
]
w/walls2: masm 1 [
    LIT 16 DIV >R
    LIT SCRATCH_C @ ZBRANCH none6 LIT 1152 LIT SCRATCH_A @ SUB LIT 64 MUL LIT SCRATCH_C @ DIV DUP LIT 0 GT ZBRANCH drop6 DUP LIT SCRATCH_D @ MUL LIT 64 DIV LIT SCRATCH_B @ ADD DUP LIT 384 GE ZBRANCH drop26 DUP LIT 1024 LE ZBRANCH drop26 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop6 DUP LIT SCRATCH_E ! LIT 27 LIT SCRATCH_F ! DROP BRANCH done6 none6: BRANCH done6 drop6: DROP BRANCH done6 drop26: DROP DROP BRANCH done6 done6: LIT SCRATCH_D @ ZBRANCH none7 LIT 384 LIT SCRATCH_B @ SUB LIT 64 MUL LIT SCRATCH_D @ DIV DUP LIT 0 GT ZBRANCH drop7 DUP LIT SCRATCH_C @ MUL LIT 64 DIV LIT SCRATCH_A @ ADD DUP LIT 768 GE ZBRANCH drop27 DUP LIT 1152 LE ZBRANCH drop27 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop7 DUP LIT SCRATCH_E ! LIT 18 LIT SCRATCH_F ! DROP BRANCH done7 none7: BRANCH done7 drop7: DROP BRANCH done7 drop27: DROP DROP BRANCH done7 done7: LIT SCRATCH_C @ ZBRANCH none8 LIT 768 LIT SCRATCH_A @ SUB LIT 64 MUL LIT SCRATCH_C @ DIV DUP LIT 0 GT ZBRANCH drop8 DUP LIT SCRATCH_D @ MUL LIT 64 DIV LIT SCRATCH_B @ ADD DUP LIT 384 GE ZBRANCH drop28 DUP LIT 640 LE ZBRANCH drop28 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop8 DUP LIT SCRATCH_E ! LIT 9 LIT SCRATCH_F ! DROP BRANCH done8 none8: BRANCH done8 drop8: DROP BRANCH done8 drop28: DROP DROP BRANCH done8 done8: LIT SCRATCH_D @ ZBRANCH none9 LIT 640 LIT SCRATCH_B @ SUB LIT 64 MUL LIT SCRATCH_D @ DIV DUP LIT 0 GT ZBRANCH drop9 DUP LIT SCRATCH_C @ MUL LIT 64 DIV LIT SCRATCH_A @ ADD DUP LIT 128 GE ZBRANCH drop29 DUP LIT 768 LE ZBRANCH drop29 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop9 DUP LIT SCRATCH_E ! LIT 8 LIT SCRATCH_F ! DROP BRANCH done9 none9: BRANCH done9 drop9: DROP BRANCH done9 drop29: DROP DROP BRANCH done9 done9: LIT SCRATCH_C @ ZBRANCH none10 LIT 128 LIT SCRATCH_A @ SUB LIT 64 MUL LIT SCRATCH_C @ DIV DUP LIT 0 GT ZBRANCH drop10 DUP LIT SCRATCH_D @ MUL LIT 64 DIV LIT SCRATCH_B @ ADD DUP LIT 128 GE ZBRANCH drop210 DUP LIT 640 LE ZBRANCH drop210 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop10 DUP LIT SCRATCH_E ! LIT 11 LIT SCRATCH_F ! DROP BRANCH done10 none10: BRANCH done10 drop10: DROP BRANCH done10 drop210: DROP DROP BRANCH done10 done10:
    R> ZBRANCH door_done
    LIT SCRATCH_C @ ZBRANCH none11 LIT 768 LIT SCRATCH_A @ SUB LIT 64 MUL LIT SCRATCH_C @ DIV DUP LIT 0 GT ZBRANCH drop11 DUP LIT SCRATCH_D @ MUL LIT 64 DIV LIT SCRATCH_B @ ADD DUP LIT 256 GE ZBRANCH drop211 DUP LIT 384 LE ZBRANCH drop211 DROP DUP LIT SCRATCH_E @ LT ZBRANCH drop11 DUP LIT SCRATCH_E ! LIT 37 LIT SCRATCH_F ! DROP BRANCH done11 none11: BRANCH done11 drop11: DROP BRANCH done11 drop211: DROP DROP BRANCH done11 done11:
door_done:
    ARITY 0 EXIT
]
w/finish: masm 0 [
    LIT SCRATCH_F @ ZBRANCH nohit
LIT SCRATCH_F @ LIT 8 MOD
DUP LIT 0 EQ ZBRANCH axis_not0
DROP
BRANCH horiz
axis_not0:
DUP LIT 2 EQ ZBRANCH axis_vert
DROP
BRANCH horiz
axis_vert:
DROP
LIT SCRATCH_E @ LIT SCRATCH_D @ MUL LIT 64 DIV LIT SCRATCH_B @ ADD LIT SCRATCH_A !
BRANCH udone
horiz:
LIT SCRATCH_E @ LIT SCRATCH_C @ MUL LIT 64 DIV LIT SCRATCH_A @ ADD LIT SCRATCH_A !
udone:
LIT SCRATCH_F @ LIT 8 DIV LIT SCRATCH_B !
LIT SCRATCH_F @ LIT 8 MOD LIT SCRATCH_C !
LIT 246 LIT 64 MUL LIT SCRATCH_E @ DIV LIT SCRATCH_D !
LIT 100 LIT SCRATCH_D @ SUB
DUP LIT 0 LT ZBRANCH topok
DROP LIT 0
topok:
LIT 16 MUL
LIT 100 LIT SCRATCH_D @ ADD
DUP LIT 199 GT ZBRANCH botok
DROP LIT 199
botok:
LIT 16 MUL
LIT 0 LIT SCRATCH_F !
LIT SCRATCH_E @ LIT 256 LT ZBRANCH not3
LIT 3 LIT SCRATCH_F ! BRANCH shdone
not3:
LIT SCRATCH_E @ LIT 512 LT ZBRANCH not2
LIT 2 LIT SCRATCH_F ! BRANCH shdone
not2:
LIT SCRATCH_E @ LIT 1024 LT ZBRANCH sh0
LIT 1 LIT SCRATCH_F ! BRANCH shdone
sh0:
LIT 0 LIT SCRATCH_F !
shdone:
LIT SCRATCH_B @ LIT 16 MUL
LIT SCRATCH_A @ LIT 16 MUL
LIT SCRATCH_C @ LIT 4 MUL LIT SCRATCH_F @ ADD LIT 16 MUL
BRANCH outdone
nohit:
LIT 0 LIT SCRATCH_A !
LIT 0 LIT SCRATCH_B !
LIT 0 LIT SCRATCH_C !
LIT 100 LIT 16 MUL
LIT 100 LIT 16 MUL
LIT 0
LIT 0
LIT 0
outdone:
    ARITY 5 EXIT
]
w/finish-print: masm 0 [
    LIT SCRATCH_F @ ZBRANCH nohit
LIT SCRATCH_F @ LIT 8 MOD
DUP LIT 0 EQ ZBRANCH axis_not0
DROP
BRANCH horiz
axis_not0:
DUP LIT 2 EQ ZBRANCH axis_vert
DROP
BRANCH horiz
axis_vert:
DROP
LIT SCRATCH_E @ LIT SCRATCH_D @ MUL LIT 64 DIV LIT SCRATCH_B @ ADD LIT SCRATCH_A !
BRANCH udone
horiz:
LIT SCRATCH_E @ LIT SCRATCH_C @ MUL LIT 64 DIV LIT SCRATCH_A @ ADD LIT SCRATCH_A !
udone:
LIT SCRATCH_F @ LIT 8 DIV LIT SCRATCH_B !
LIT SCRATCH_F @ LIT 8 MOD LIT SCRATCH_C !
LIT 246 LIT 64 MUL LIT SCRATCH_E @ DIV LIT SCRATCH_D !
LIT 100 LIT SCRATCH_D @ SUB
DUP LIT 0 LT ZBRANCH topok
DROP LIT 0
topok:
LIT 16 MUL
LIT 100 LIT SCRATCH_D @ ADD
DUP LIT 199 GT ZBRANCH botok
DROP LIT 199
botok:
LIT 16 MUL
LIT 0 LIT SCRATCH_F !
LIT SCRATCH_E @ LIT 256 LT ZBRANCH not3
LIT 3 LIT SCRATCH_F ! BRANCH shdone
not3:
LIT SCRATCH_E @ LIT 512 LT ZBRANCH not2
LIT 2 LIT SCRATCH_F ! BRANCH shdone
not2:
LIT SCRATCH_E @ LIT 1024 LT ZBRANCH sh0
LIT 1 LIT SCRATCH_F ! BRANCH shdone
sh0:
LIT 0 LIT SCRATCH_F !
shdone:
LIT SCRATCH_B @ LIT 16 MUL
LIT SCRATCH_A @ LIT 16 MUL
LIT SCRATCH_C @ LIT 4 MUL LIT SCRATCH_F @ ADD LIT 16 MUL
BRANCH outdone
nohit:
LIT 0 LIT SCRATCH_A !
LIT 0 LIT SCRATCH_B !
LIT 0 LIT SCRATCH_C !
LIT 100 LIT 16 MUL
LIT 100 LIT 16 MUL
LIT 0
LIT 0
LIT 0
outdone:
    >R >R >R >R >R
    R> LIT 16 DIV PRINT R> LIT 16 DIV PRINT R> LIT 16 DIV PRINT R> LIT 16 DIV PRINT R> LIT 16 DIV PRINT
    ARITY 0 EXIT
]
w/ray: func [sx] [
    w/rayx: + 64 / * 0 - * 2 sx 319 319
    w/rayy: + 0 / * -42 - * 2 sx 319 319
    w/setup 320 320 w/rayx w/rayy
    w/walls1
    w/walls2 0
    w/finish
]
w/ray-at: func [sx px py dirx diry planex planey door] [
    w/rayx: + dirx / * planex - * 2 sx 319 319
    w/rayy: + diry / * planey - * 2 sx 319 319
    w/setup px py w/rayx w/rayy
    w/walls1
    w/walls2 door
    w/finish
]
w/column-print: func [sx] [
    w/rayx: + 64 / * 0 - * 2 sx 319 319
    w/rayy: + 0 / * -42 - * 2 sx 319 319
    w/setup 320 320 w/rayx w/rayy
    w/walls1
    w/walls2 0
    w/finish-print
]
]
