;; experiments/glon-dom-host/app.glon -- extract the links of a REAL browser page,
;; in Glon, with the host-backed walker (hostwalk.glon) and the link extractor of
;; experiments/glon-dom-links/links.glon (loaded unchanged: lk/event decides what
;; a link is and builds the results).
;;
;; The conversation with the host (GLON_LIVE ABI: Glon asks with a host-call
;; request at the end of a dispatch; the host answers with glon_event_bytes):
;;
;;   host -> Glon   web-load      url            (the page's "Load" action)
;;   Glon -> host   web-load      url            fetch the page, parse it
;;   host -> Glon   web-loaded    doc handle     (or web-error  message)
;;   Glon -> host   dom-next      "doc max close-depth attrs bytes"
;;   host -> Glon   dom-events    a batch of encoded events
;;        ... dom-next / dom-events until the batch holds the end ...
;;   Glon           prints the links, renders the summary
;;
;; The host releases the document when it sends the end (or on the next load).
;; The rendered summary holds only fixed text and numbers (it becomes HTML).
;; Each link is printed as two netstrings, "len:href" and "len:text", so the host
;; can read them back exactly, whatever bytes they hold.
;;
;; Requires common.glon (emit-*, mk-string), strings.glon, strings-ext.glon,
;; iter.glon, list-block.glon, links.glon and hostwalk.glon.

web/page: none          ;; the walker over the current page, or none
web/status: "Ready"
web/count: 0            ;; links found in the last page
web/events: 0           ;; events walked in the last page
web/batches: 0          ;; dom-events replies received
web/max: 64             ;; events per batch
web/bytes: 120          ;; bytes per batch. A string costs one cell per byte and
                        ;; needs ONE contiguous block; with open-element views
                        ;; spread through the heap, a 240-byte batch could not be
                        ;; placed beyond about 30 levels of nesting, 120 bytes
                        ;; reaches 40-50 (see REPORT.md). Keep it under the live
                        ;; wrapper's 400-byte chunk: larger replies are joined
                        ;; from copies.
web/attrs: reduce [ "href" ]
hl/stop: 0

;; the integer in a decimal string (the host's handles)
web/int: func [s] [ web/int-at s 0 0 ]
web/int-at: func [s i acc] [
    either < i s/length s [ web/int-at s + i 1 + * acc 10 - s/at s i 48 ] [ acc ]
]

;; ---- driving the extractor until the batch runs out ---------------------------
;; As lk/steps (balanced, depth log2 n), but it also stops at hw/wait.
hl/steps: func [w n] [
    either either lk/done [ 1 ] [ hl/stop ] [ none ] [
        either = n 1 [
            either hw/wait? it/peek w [ hl/stop: 1 ] [ lk/event it/next w ]
        ] [
            hl/steps w / n 2
            hl/steps w - n / n 2
        ]
    ]
]
hl/pump: func [w n] [
    hl/steps w n
    either either lk/done [ 1 ] [ hl/stop ] [ none ] [ hl/pump w * n 2 ]
]

;; ---- output -----------------------------------------------------------------------
web/net: func [s] [ s/print s/+ s/+ s/from-int s/length s ":" s ]
web/print-links: func [links i] [
    either < i block-len links [
        web/net block-at block-at links i 0
        web/net block-at block-at links i 1
        web/print-links links + i 1
    ] [ none ]
]
web/view: func [] [
    emit-clear
    emit-text "<div class='glon-summary'>"
    emit-text web/status
    emit-text "</div>"
    emit-finish
]

;; ---- the steps of the conversation ------------------------------------------------------
web/load: func [url] [
    web/status: "Loading"
    emit-host-call "web-load" url
]
web/start: func [doc] [
    web/page: hw/walk web/int doc web/attrs web/max web/bytes
    lk/found: none  lk/count: 0  lk/anchor: none  lk/text: none  lk/done: 0
    web/batches: 0
    emit-host-call "dom-next" hw/request web/page
]
web/batch: func [bytes] [
    hw/feed web/page bytes
    web/batches: + web/batches 1
    hl/stop: 0
    hl/pump web/page 16
    either lk/done [ web/finish ] [ emit-host-call "dom-next" hw/request web/page ]
]
web/finish: func [] [
    web/links: lb/to-block lk/found lk/count
    lk/found: none
    web/count: lk/count
    web/events: it/pos web/page
    web/page: none
    s/print s/+ "LINKS " s/from-int web/count
    web/print-links web/links 0
    s/print s/+ s/+ s/+ "EVENTS " s/from-int web/events " BATCHES " s/from-int web/batches
    web/status: s/+ s/+ s/+ s/from-int web/count " links in " s/from-int web/events " events"
    web/view
]
web/links: none

;; Render a host-call request fragment: 1 op 0 arg (as demo/shop/live.glon does).
emit-host-call: func [op arg] [
    emit-clear
    emit-byte 1
    emit-text op
    emit-byte 0
    emit-text arg
    emit-finish
]

render-current: func [] [ web/view ]

do-event: [
    either = current-event 'web-load [ web/load current-value ] [
        either = current-event 'web-loaded [ web/start current-value ] [
            either = current-event 'dom-events [ web/batch current-value ] [
                either = current-event 'web-error [
                    web/page: none
                    ;; the message is host text: printed, never put into HTML
                    web/status: "Error (see the log)"
                    s/print s/+ "ERROR " current-value
                    web/view
                ] [ web/view ]
            ]
        ]
    ]
]
route: [ web/view ]
