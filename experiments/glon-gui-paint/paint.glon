;; Glon Paint application logic. This file owns all brush/tool/event decisions;
;; the C host only translates SDL input into calls and executes command strings.
[
paint/color: 1
paint/size: 4
paint/tool: 1
paint/drawing: 0
paint/px: 0
paint/py: 0
paint/pressure-prev: 180
paint/calligraphy-diameter: 24
paint/pressure: 180
paint/ink-opacity: 255
paint/script-buf: ""
paint/script-ops: 0
paint/script-error: 0
paint/script-saved-tool: 1

paint/color-rgb: func [n] [
    either = n 1 [ reduce [ 220 60 60 ] ] [
        either = n 2 [ reduce [ 40 120 220 ] ] [
            either = n 3 [ reduce [ 40 160 80 ] ] [ reduce [ 230 170 40 ] ]
        ]
    ]
]
paint/title: func [] [
    paint/t: "T Glon Paint | color="
    paint/t: s/+ paint/t s/from-int paint/color
    paint/t: s/+ paint/t " size="
    paint/t: s/+ paint/t s/from-int paint/size
    paint/t: s/+ paint/t " tool="
    paint/t: s/+ paint/t either = paint/tool 1 [ "brush" ] [ "eraser" ]
    paint/t: s/+ paint/t mk-string [ 10 ]
    s/+ paint/t paint/status
]
paint/status: func [] [
    paint/s: "I "
    paint/s: s/+ paint/s s/from-int paint/color
    paint/s: s/+ paint/s " "
    paint/s: s/+ paint/s s/from-int paint/size
    paint/s: s/+ paint/s " "
    paint/s: s/+ paint/s s/from-int paint/tool
    paint/s: s/+ paint/s " "
    paint/s: s/+ paint/s s/from-int paint/drawing
    paint/s: s/+ paint/s " "
    paint/s: s/+ paint/s s/from-int paint/calligraphy-diameter
    paint/s: s/+ paint/s " "
    paint/s: s/+ paint/s s/from-int paint/pressure
    paint/s: s/+ paint/s " "
    paint/s: s/+ paint/s s/from-int paint/ink-opacity
    s/+ paint/s mk-string [ 10 ]
]
paint/line: func [x1 y1 x2 y2] [
    paint/c: either = paint/tool 2 [ 0 ] [ paint/color ]
    paint/rgb: either = paint/tool 2 [ reduce [ 255 255 255 ] ] [ paint/color-rgb paint/c ]
    paint/cmd: either = paint/tool 2 [ "E " ] [ "L " ]
    paint/cmd: s/+ paint/cmd s/from-int x1
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int y1
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int x2
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int y2
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int paint/size
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int block-at paint/rgb 0
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int block-at paint/rgb 1
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int block-at paint/rgb 2
    s/+ paint/cmd mk-string [ 10 ]
]

paint/set-color: func [n] [
    paint/color: either = n 2 [ 2 ] [ either = n 3 [ 3 ] [ either = n 4 [ 4 ] [ 1 ] ] ]
    paint/title
]
paint/set-size: func [n] [
    paint/size: either < n 1 [ 1 ] [ either > n 64 [ 64 ] [ n ] ]
    paint/title
]
paint/set-tool: func [n] [
    paint/tool: either = n 2 [ 2 ] [ either = n 3 [ 3 ] [ 1 ] ]
    paint/title
]
paint/set-calligraphy-diameter: func [n] [
    paint/calligraphy-diameter: either < n 1 [ 1 ] [ either > n 64 [ 64 ] [ n ] ]
    paint/title
]
paint/set-pressure: func [n] [
    paint/pressure: either < n 0 [ 0 ] [ either > n 255 [ 255 ] [ n ] ]
    paint/title
]
paint/set-ink-opacity: func [n] [
    paint/ink-opacity: either < n 0 [ 0 ] [ either > n 255 [ 255 ] [ n ] ]
    paint/title
]
paint/pressure-command: func [x1 y1 p1 x2 y2 p2] [
    paint/rgb: paint/color-rgb paint/color
    paint/cmd: "P "
    paint/cmd: s/+ paint/cmd s/from-int x1
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int y1
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int p1
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int x2
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int y2
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int p2
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int paint/calligraphy-diameter
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int paint/ink-opacity
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int block-at paint/rgb 0
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int block-at paint/rgb 1
    paint/cmd: s/+ paint/cmd " "
    paint/cmd: s/+ paint/cmd s/from-int block-at paint/rgb 2
    s/+ paint/cmd mk-string [ 10 ]
]
paint/draw-pressure-line: func [x1 y1 p1 x2 y2 p2] [
    paint/cmd: paint/pressure-command x1 y1 p1 x2 y2 p2
    paint/script-add paint/cmd
]
paint/script-reset: func [] [
    paint/script-buf: ""
    paint/script-ops: 0
    paint/script-error: 0
    ""
]
paint/script-add: func [cmd] [
    either < paint/script-ops 4096 [
        paint/script-buf: s/+ paint/script-buf cmd
        paint/script-ops: + paint/script-ops 1
        cmd
    ] [
        paint/script-error: 1
        ""
    ]
]
paint/script-status: func [] [
    either = paint/script-error 1 [ "ERR" ] [ "OK" ]
]
paint/script-result: func [] [ paint/script-buf ]
paint/draw-line: func [x1 y1 x2 y2] [
    paint/script-saved-tool: paint/tool
    paint/tool: 1
    paint/cmd: paint/line x1 y1 x2 y2
    paint/tool: paint/script-saved-tool
    paint/script-add paint/cmd
]
paint/erase-line: func [x1 y1 x2 y2] [
    paint/script-saved-tool: paint/tool
    paint/tool: 2
    paint/cmd: paint/line x1 y1 x2 y2
    paint/tool: paint/script-saved-tool
    paint/script-add paint/cmd
]
paint/draw-clear: func [] [
    paint/cmd: s/+ "C" mk-string [ 10 ]
    paint/script-add paint/cmd
]
paint/draw-rect: func [x y w h] [
    paint/rx2: + x w
    paint/ry2: + y h
    paint/draw-line x y paint/rx2 y
    paint/draw-line paint/rx2 y paint/rx2 paint/ry2
    paint/draw-line paint/rx2 paint/ry2 x paint/ry2
    paint/draw-line x paint/ry2 x y
]
paint/init: func [] [
    paint/color: 1
    paint/size: 4
    paint/tool: 1
    paint/drawing: 0
    paint/px: 0
    paint/py: 0
    paint/pressure-prev: 180
    paint/calligraphy-diameter: 24
    paint/pressure: 180
    paint/ink-opacity: 255
    paint/title
]
paint/down: func [x y button] [
    either = button 1 [
        paint/drawing: 1
        paint/px: x
        paint/py: y
        paint/pressure-prev: paint/pressure
        either = paint/tool 3 [
            paint/pressure-command x y paint/pressure x y paint/pressure
        ] [ paint/line x y x y ]
    ] [ "" ]
]
paint/move: func [x y] [
    either = paint/drawing 1 [
        paint/cmd: either = paint/tool 3 [
            paint/pressure-command paint/px paint/py paint/pressure-prev x y paint/pressure
        ] [ paint/line paint/px paint/py x y ]
        paint/px: x
        paint/py: y
        paint/pressure-prev: paint/pressure
        paint/cmd
    ] [ "" ]
]
paint/up: func [x y button] [
    either = button 1 [ paint/drawing: 0 ] [ none ]
    ""
]
paint/key: func [k] [
    either = k 49 [ paint/color: 1  paint/title ] [
    either = k 50 [ paint/color: 2  paint/title ] [
    either = k 51 [ paint/color: 3  paint/title ] [
    either = k 52 [ paint/color: 4  paint/title ] [
    either = k 43 [ paint/size: either < paint/size 64 [ + paint/size 1 ] [ 64 ]  paint/title ] [
    either = k 45 [ paint/size: either > paint/size 1 [ - paint/size 1 ] [ 1 ]  paint/title ] [
    either = k 101 [ paint/tool: 2  paint/title ] [
    either = k 98 [ paint/tool: 1  paint/title ] [
    either = k 99 [ s/+ "C" mk-string [ 10 ] ] [
    either = k 115 [ s/+ "S glon-paint.png" mk-string [ 10 ] ] [
    either = k 27 [ s/+ "Q" mk-string [ 10 ] ] [ "" ]
    ] ] ] ] ] ] ] ] ] ] ]
]
