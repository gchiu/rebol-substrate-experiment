--- a/src/plugins/cairo/libdecor-cairo.c
+++ b/src/plugins/cairo/libdecor-cairo.c
@@ -1249,14 +1249,18 @@
 	case NONE:
 		break;
 	case SHADOW:
-		render_shadow(cr,
-			      frame_cairo->shadow_blur,
-			      -(int)SHADOW_MARGIN/2,
