@@ -1659,9 +1663,12 @@
 				&frame_cairo->link);
 		break;
 	case DECORATION_TYPE_TITLE_ONLY:
-		/* hide borders */
-		if (is_border_surfaces_showing(frame_cairo))
-			hide_border_surfaces(frame_cairo);
+		/* Keep the border/shadow surface mapped but transparent. WSLg
+		 * does not clear the old shadow when it is unmapped on maximize;
