;; modules/file.glon -- optional asynchronous file I/O for the native Glon CLI.
;;
;; This is ordinary Glon built over a host request/reply boundary.  It adds no
;; primitive, HOST id, parser/evaluator change or blocking file word.
;;
;; Host protocol (built here, decoded by glon_io_file.c):
;;   request  = 0x01 op:u8 id:u32be field-count:u8 field*
;;   field    = length:u32be bytes[length]
;; The host owns paths, file descriptors and bytes.  Replacement stays in Glon.
;;
;; Multiple requests may be outstanding (bounded by io/max-pending).  Each is a
;; record [id op fields success failure arg] held in a FIFO queue; the host
;; takes one at a time with `io/take-request` and feeds each reply back with
;; `io/reply id status v1 v2`, which correlates by id and delivers to the
;; originating task's success/failure closure.  The host serialises execution
;; (one outstanding host request), but many Glon tasks can be pending at once.
;;
;; Requires the shipped prelude/strings libraries and strings-ext (s/slice).
[
io/next-id: 0
io/count: 0
io/max-pending: 16
io/queue: none      ;; FIFO of records not yet taken by the host
io/inflight: none   ;; records taken by the host, awaiting their reply

;; Big-endian u32 as exactly four bytes.  No bitwise or MOD word is used.
io/u32: func [n] [
    b0: / n 16777216
    b1: - / n 65536 * 256 / n 16777216
    b2: - / n 256 * 256 / n 65536
    b3: - n * 256 / n 256
    s/+ s/+ s/+
        mk-string reduce [ b0 ]
        mk-string reduce [ b1 ]
        mk-string reduce [ b2 ]
        mk-string reduce [ b3 ]
]

io/handle-field: func [h] [
    s/+ io/u32 block-at h 0 io/u32 block-at h 1
]

io/mode-byte: func [mode] [
    either = mode 'read [
        1
    ] [
        either = mode 'write [
            2
        ] [
            either = mode 'read-write [
                3
            ] [
                either = mode 'append [
                    4
                ] [
                    raise create-sin 'io 'unsupported mode
                ]
            ]
        ]
    ]
]

;; ---- bounded FIFO of pending requests ------------------------------------
io/find: func [xs id] [
    either xs [
        rec: block-at xs 0
        either = block-at rec 0 id [ rec ] [ io/find block-at xs 1 id ]
    ] [ none ]
]
io/remove: func [xs id] [
    either xs [
        rec: block-at xs 0
        either = block-at rec 0 id [
            block-at xs 1
        ] [
            reduce [ rec io/remove block-at xs 1 id ]
        ]
    ] [ none ]
]

;; Queue one request.  Request construction and callback retention are Glon
;; state; the returned frame is consumed by the host driver.  A full queue is
;; rejected without touching existing requests.
io/request: func [op fields success failure arg] [
    either >= io/count io/max-pending [
        raise create-sin 'io 'capacity arg
    ] [
        io/next-id: + io/next-id 1
        rec: reduce [ io/next-id op fields :success :failure arg ]
        io/queue: reduce [ rec io/queue ]
        io/count: + io/count 1
        none
    ]
]

;; Pop the head request for the host and keep its record in `inflight` (so the
;; collector still roots the callbacks until the reply arrives).
io/take-request: func [] [
    either io/queue [
        rec: block-at io/queue 0
        io/queue: block-at io/queue 1
        io/inflight: reduce [ rec io/inflight ]
        reduce [ block-at rec 0 block-at rec 1 block-at rec 2 ]
    ] [ none ]
]

;; The host feeds one bounded reply back.  Unknown/stale ids are a job failure,
;; not a recoverable file error.  Recoverable statuses become SIN! values in
;; the failure closure.  A judge in the original caller cannot span this turn.
io/deliver: func [op success failure arg status v1 v2] [
    either = status 'ok [
        either = op 1 [
            success reduce [ v1 v2 ]
        ] [
            either = op 2 [
                success v1
            ] [
                either = op 3 [
                    success v1
                ] [
                    either = op 5 [ success reduce [ v1 v2 ] ] [ success none ]
                ]
            ]
        ]
    ] [
        either = status 'eof [
            either = op 2 [
                success ""
            ] [
                failure create-sin 'io status arg
            ]
        ] [
            failure create-sin 'io status arg
        ]
    ]
]
io/reply: func [id status v1 v2] [
    rec: io/find io/inflight id
    either rec [
        io/inflight: io/remove io/inflight id
        io/count: - io/count 1
        io/deliver block-at rec 1 block-at rec 3 block-at rec 4 block-at rec 5
            status v1 v2
    ] [
        raise create-sin 'io 'stale-reply id
    ]
]

;; Low-level handle jobs.
io/open: func [name mode success failure] [
    io/request 1 reduce [ name mk-string reduce [ io/mode-byte mode ] ]
        :success :failure name
]

io/read: func [handle max success failure] [
    io/request 2 reduce [ io/handle-field handle io/u32 max ] :success :failure handle
]

io/write: func [handle bytes success failure] [
    io/request 3 reduce [ io/handle-field handle bytes ] :success :failure handle
]

io/close: func [handle success failure] [
    io/request 4 reduce [ io/handle-field handle ] :success :failure handle
]

;; Whole-file convenience.  The cap belongs to this immutable-string API; the
;; host's --io-max-file is a separate per-handle streaming safety bound.  This
;; path uses 128-byte allocations so the non-moving heap can satisfy them after
;; the result string is live.  Streaming (file-stream.glon) uses the 400-byte
;; protocol chunk.
file/max-bytes: 1024

file/read-loop: func [h acc success failure] [
    io/read h 128
        func [chunk] [
            either = 0 s/length chunk [
                io/close h func [x] [ success acc ] :failure
            ] [
                either > + s/length acc s/length chunk file/max-bytes [
                    io/close h
                        func [x] [ failure create-sin 'io 'too-large file/max-bytes ]
                        :failure
                ] [
                    file/read-loop h s/+ acc chunk :success :failure
                ]
            ]
        ]
        func [e] [
            io/close h func [x] [ failure e ] :failure
        ]
]

file/read: func [name success failure] [
    io/open name 'read
        func [h] [ file/read-loop h "" :success :failure ]
        :failure
]

file/write-loop: func [h bytes success failure] [
    chunk: either > s/length bytes 128 [ s/slice bytes 0 128 ] [ bytes ]
    io/write h chunk
        func [n] [
            either = n s/length bytes [
                io/close h func [x] [ success none ] :failure
            ] [
                file/write-loop h s/slice bytes n - s/length bytes n :success :failure
            ]
        ]
        func [e] [
            io/close h func [x] [ failure e ] :failure
        ]
]

file/write: func [name bytes success failure] [
    either > s/length bytes file/max-bytes [
        failure create-sin 'io 'too-large file/max-bytes
    ] [
        io/open name 'write
            func [h] [
                either = 0 s/length bytes [
                    io/close h func [x] [ success none ] :failure
                ] [
                    file/write-loop h bytes :success :failure
                ]
            ]
            :failure
    ]
]
]
