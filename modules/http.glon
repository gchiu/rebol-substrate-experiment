;; modules/http.glon -- optional HTTPS vocabulary for the native Glon CLI.
;;
;; This is ordinary Glon built over the existing persistent-session
;; request/reply boundary.  CivetWeb owns sockets, TLS and HTTP parsing; the
;; application owns the handler and the response bytes.
;;
;; Host -> Glon:  http/dispatch <id> <method> <path> <query> <body> <headers> <peer>
;; Glon -> host:  http/take-response
;;                => [id status content-type headers body] | NONE
;;
;; The request passed to the handler is an opaque block
;; [id method path query body headers peer].  `body` is a bounded STRING! (empty
;; when absent); `headers` is a block of alternating STRING! name/value pairs;
;; `peer` is the transport remote address (host-provided, not X-Forwarded-For).
;; The id is an integer, never a native pointer.  A response is accepted only
;; for the request currently being dispatched, so a stale or fabricated handle
;; cannot address another connection.  `headers` is NONE or an alternating
;; block of STRING! name/value pairs; the host owns Content-Type,
;; Content-Length and Connection.
;;
;; Requires the shipped prelude (block-at, reduce, either) and the built-in
;; SIN! vocabulary (judge, sin?, raise, create-sin).
[
http/port: none
http/handler: none
http/current: none
http/response: none
http/stop-requested: none
;; H2B: when task-mode is set, each request runs as a Glon task; request-field
;; trusts the passed request (no global http/current) and responses are stored
;; per-id in http/responses instead of the single http/response.
http/task-mode: 0
http/responses: none

http/listen: func [port handler] [
    either < port 1 [
        raise create-sin 'http 'bad-port port
    ] [
        either > port 65535 [
            raise create-sin 'http 'bad-port port
        ] [
            http/port: port
            http/handler: :handler
            none
        ]
    ]
]

;; Consumed once by the host before it starts the listener.
http/take-listen: func [] [
    either http/port [ reduce [ 1 http/port ] ] [ none ]
]

;; Request inspection.  Each accessor validates that the block is the request
;; currently being dispatched; a stale or foreign handle raises a SIN!.
;;   http/method  r -> STRING!  "GET", "POST", ...
;;   http/path    r -> STRING!  decoded path without the query string
;;   http/query   r -> STRING!  raw query bytes without the leading "?", or ""
;;   http/body    r -> STRING!  request body bytes (empty when absent)
;;   http/header  r n -> STRING! value, or NONE (case-insensitive name match)
;;   http/content-type r -> STRING! value, or NONE
;;   http/peer    r -> STRING! remote address, or "" when unavailable
http/request-field: func [request index] [
    either sin? request [
        raise request
    ] [
        either http/task-mode [
            block-at request index
        ] [
        either http/current [
            either = block-at request 0 block-at http/current 0 [
                block-at http/current index
            ] [
                raise create-sin 'http 'stale-request request
            ]
        ] [
            raise create-sin 'http 'no-request request
        ]
        ]
    ]
]

http/method: func [request] [ http/request-field request 1 ]
http/path: func [request] [ http/request-field request 2 ]
http/query: func [request] [ http/request-field request 3 ]
http/body: func [request] [ http/request-field request 4 ]

;; Header names are compared case-insensitively.  The first matching header is
;; returned; duplicate request headers are not merged.
http/lower: func [b] [
    either either >= b 65 [ <= b 90 ] [ 0 ] [ + b 32 ] [ b ]
]
http/ci-eq: func [a b] [
    either = s/length a s/length b [ http/ci-loop a b 0 ] [ 0 ]
]
http/ci-loop: func [a b i] [
    either >= i s/length a [
        1
    ] [
        either = http/lower s/at a i http/lower s/at b i [
            http/ci-loop a b + i 1
        ] [
            0
        ]
    ]
]
http/header-scan: func [headers name i] [
    either < i block-len headers [
        either http/ci-eq block-at headers i name [
            block-at headers + i 1
        ] [
            http/header-scan headers name + i 2
        ]
    ] [
        none
    ]
]
http/header: func [request name] [
    http/header-scan http/request-field request 5 name 0
]
http/content-type: func [request] [ http/header request "Content-Type" ]
http/peer: func [request] [ http/request-field request 6 ]

;; Application response generation.  The body is a STRING! or a nested block
;; of STRING!/BLOCK! parts; the host flattens it in order.  The short form sends
;; no application headers.
http/respond: func [request status content-type body] [
    http/respond-with request status content-type none body
]

;; Response with additional application headers.  `headers` is NONE or an
;; alternating block such as reduce [ "Allow" "GET" ].  The host validates the
;; shape and filters headers it owns.
http/clear-current: func [] [ http/current: none ]

http/respond-with: func [request status content-type headers body] [
    either sin? request [
        raise request
    ] [
        either either < status 100 [ 1 ] [ > status 599 ] [
            raise create-sin 'http 'bad-status status
        ] [
            either http/task-mode [
                http/responses: reduce [
                    reduce [ block-at request 0 status content-type headers body ]
                    http/responses
                ]
                none
            ] [
            either http/current [
                either = block-at request 0 block-at http/current 0 [
                    http/response: reduce [
                        block-at http/current 0 status content-type headers body
                    ]
                    none
                ] [
                    raise create-sin 'http 'stale-request request
                ]
            ] [
                raise create-sin 'http 'no-request request
            ]
            ]
        ]
    ]
]

;; H2B: per-id response lookup for the interpreter-owner loop.  Returns the
;; head pair [id status ctype headers body] and removes it when the id matches,
;; or NONE.  The owner re-polls, so responses are drained in order.
http/take-response-for: func [id] [
    either http/responses [
        pair: block-at http/responses 0
        either - block-at pair 0 id [
            none
        ] [
            http/responses: block-at http/responses 1
            pair
        ]
    ] [ none ]
]
http/response-find: func [xs id] [
    either xs [
        pair: block-at xs 0
        either = block-at pair 0 id [
            pair
        ] [
            http/response-find block-at xs 1 id
        ]
    ] [ none ]
]
http/response-remove: func [xs id] [
    either xs [
        pair: block-at xs 0
        either = block-at pair 0 id [
            block-at xs 1
        ] [
            reduce [ pair http/response-remove block-at xs 1 id ]
        ]
    ] [ none ]
]

;; H2B: task entry.  The host passes the seven request fields as evaluated
;; arguments; the task builds the request block and runs the handler, which may
;; suspend on async I/O (task-wait) and whose reply callback calls http/respond.
http/task-run: func [id method path query body headers peer] [
    request: reduce [ id method path query body headers peer ]
    result: judge [ http/handler :request ]
    either sin? result [
        http/respond request 500 "text/plain; charset=utf-8" "internal error"
    ] [
        either http/take-response-for (block-at request 0) [
            none
        ] [
            http/respond request 500 "text/plain; charset=utf-8" "no response"
        ]
    ]
]

;; Ask the host to stop after the current response.  The host polls this flag
;; from the same worker that owns the Glon session.
http/stop: func [] [
    http/stop-requested: 1
    none
]

http/stopped?: func [] [
    either http/stop-requested [ 1 ] [ 0 ]
]

;; Called by the host for one completed request.  Handler errors become a 500
;; response; the host never loses track of the request id.
http/dispatch: func [id method path query body headers peer] [
    http/current: reduce [ id method path query body headers peer ]
    http/response: none
    result: judge [ http/handler :http/current ]
    either sin? result [
        either http/response [ none ] [
            http/response: reduce [ id 500 "text/plain; charset=utf-8" none "internal error" ]
        ]
    ] [
        either http/response [ none ] [
            http/response: reduce [ id 500 "text/plain; charset=utf-8" none "no response" ]
        ]
    ]
    none
]

;; Consumed by the host immediately after dispatch.  Clearing the stored
;; response here drops the last Glon reference; the collector reclaims it.
http/take-response: func [] [
    r: http/response
    http/response: none
    r
]
]
