;; modules/sqlite.glon - optional general-purpose SQLite vocabulary.
;;
;; Host protocol (decoded by glon_sqlite.c):
;;   sqlite/take-request -> [id op fields] | NONE
;;   sqlite/reply id status v1 v2
;;
;; Database and statement handles are opaque 8-byte strings generated by the
;; host and validated with a generation.  Handles are never native pointers.
;; One request may be outstanding.  Callbacks may queue the next operation.
;;
;; This file contains no application, user, session or chat policy.
;; Requires prelude, strings and strings-ext (s/from-int, s/at).
[
sqlite/next-id: 0
sqlite/pending: none
sqlite/pending-id: 0
sqlite/pending-op: 0
sqlite/pending-record: none
sqlite/pending-request: none

sqlite/request: func [op fields success failure] [
    either sqlite/pending [
        raise create-sin 'sqlite 'busy none
    ] [
        sqlite/next-id: + sqlite/next-id 1
        sqlite/pending-id: sqlite/next-id
        sqlite/pending-op: op
        sqlite/pending-record: reduce [ sqlite/next-id op :success :failure ]
        sqlite/pending-request: reduce [ sqlite/next-id op fields ]
        sqlite/pending: 1
        none
    ]
]

sqlite/take-request: func [] [
    either sqlite/pending [ sqlite/pending-request ] [ none ]
]

sqlite/be64-loop: func [s i acc] [
    either >= i 8 [ acc ] [
        sqlite/be64-loop s + i 1 + * acc 256 s/at s i
    ]
]

sqlite/be64: func [s] [ sqlite/be64-loop s 0 0 ]

sqlite/reply: func [id status v1 v2] [
    either either sqlite/pending [ = id sqlite/pending-id ] [ 0 ] [
        op: sqlite/pending-op
        success: block-at sqlite/pending-record 2
        failure: block-at sqlite/pending-record 3
        sqlite/pending: none
        sqlite/pending-id: 0
        sqlite/pending-op: 0
        sqlite/pending-record: none
        sqlite/pending-request: none
        either = status 'ok [
            either either = op 1 [ 1 ] [ = op 2 ] [
                success v1
            ] [
                either = op 11 [
                    success sqlite/be64 v1
                ] [
                    success none
                ]
            ]
        ] [
            either = status 'row [
                success v1
            ] [
                either = status 'done [
                    success none
                ] [
                    failure create-sin 'sqlite status v1
                ]
            ]
        ]
    ] [
        raise create-sin 'sqlite 'stale-reply id
    ]
]

sqlite/open: func [path success failure] [
    sqlite/request 1 reduce [ path ] :success :failure
]

sqlite/prepare: func [db sql success failure] [
    sqlite/request 2 reduce [ db sql ] :success :failure
]

sqlite/bind-int: func [stmt index value success failure] [
    sqlite/request 3 reduce [ stmt s/from-int index s/from-int value ]
        :success :failure
]

sqlite/bind-text: func [stmt index text success failure] [
    sqlite/request 4 reduce [ stmt s/from-int index text ] :success :failure
]

sqlite/bind-null: func [stmt index success failure] [
    sqlite/request 5 reduce [ stmt s/from-int index ] :success :failure
]

sqlite/bind-blob: func [stmt index bytes success failure] [
    sqlite/request 6 reduce [ stmt s/from-int index bytes ] :success :failure
]

sqlite/step: func [stmt success failure] [
    sqlite/request 7 reduce [ stmt ] :success :failure
]

sqlite/reset: func [stmt success failure] [
    sqlite/request 8 reduce [ stmt ] :success :failure
]

sqlite/clear: func [stmt success failure] [
    sqlite/request 9 reduce [ stmt ] :success :failure
]

sqlite/finalize: func [stmt success failure] [
    sqlite/request 10 reduce [ stmt ] :success :failure
]

sqlite/exec: func [db sql success failure] [
    sqlite/request 11 reduce [ db sql ] :success :failure
]

sqlite/close: func [db success failure] [
    sqlite/request 12 reduce [ db ] :success :failure
]
]
