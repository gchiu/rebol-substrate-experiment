gallery/build-table-preview: func [theme parent] [
    s: gallery/preview-shell theme parent 4 68 592 596
    g: block-at s 0
    c: block-at s 1
    gallery/section theme c 16 0 500 20 "Table: 100 records; wheel or scrollbar; header stays"
    gallery/set-id 31  vid/table theme c 16 24 548 380
        "#:44:2;Name:182:0;Place:156:0;Notes:156:0:1" ""
    tid: block-at gallery/id 31 1
    gallery/table-id: tid
    gallery/set-id 36 tid
    ;; the table is as wide as the preview pane allows (its scrollbar stays at
    ;; the visible right edge; narrower than its columns, the last one is cut
    ;; by the table's own clip), at least 300; fixed height
    lay/add tid 0 gallery/lay-pv 16 0 24 0 -40 1000 380 0 300 0
    gallery/table-fill-all tid 0
    ;; back where the user left it
    either < gallery/table-sel 0 [ 0 ] [
        table/select tid gallery/table-sel
        table/focus tid gallery/table-sel 0
    ]
    either = gallery/table-start 0 [ 0 ] [ table/scroll tid gallery/table-start ]
    ;; column widths the user dragged or fitted
    either = s/length gallery/table-widths 0 [ 0 ] [ table/widths tid gallery/table-widths ]
    g
]

gallery/build-vocab-preview: func [theme parent] [
    s: gallery/preview-shell theme parent 4 68 592 596
    g: block-at s 0
    c: block-at s 1
    gallery/section theme c 16 0 500 20 "V-1 vocabulary dispatch"
    gallery/set-id 19  vid/button theme c 16 32 160 32 "Call Theme"
    gallery/set-id 20  vid/button theme c 190 32 160 32 "Call Status"
    gallery/set-id 21  vid/button theme c 16 76 160 32 "Call Add"
    vid/label theme c 16 126 500 24 "vocab/call0 / call1 / call2"
    g
]

gallery/build-center: func [theme root] [
    p: vid/panel theme root 252 16 600 668 0 0 0 0 []
    id: block-at p 1
    ;; takes 3/4 of the width beyond 1200 and all the extra height
    gallery/lay-center: lay/add id 1 gallery/lay-root 252 0 16 0 -300 750 -32 1000 0 0
    vid/heading theme id 20 14 560 24 "Live preview"
    vid/caption theme id 20 40 560 18 "Rendered by the VID widget library"
    ;; previews are built (at y 68 and below, as before) into a content group
    ;; shifted up by 64 inside a viewport below the heading: a pane smaller
    ;; than the preview scrolls it (wheel, focus reveal) instead of clipping
    pv: view/next-id
    view/create pv id 8 0 64 600 604 1 1 0 0
    pvr: lay/add pv 3 gallery/lay-center 0 0 64 0 0 1000 -64 1000 0 0
    gallery/lay-pv: pvr
    pc: view/next-id
    view/create pc pv view/type-group 0 -64 600 668 1 1 0 0
    gallery/pscroll: lay/thumbs lay/scroll pv -1 600 604 0 1 pvr id theme
    gallery/set-id 37 pc
]

gallery/build-right: func [theme root] [
    p: vid/panel theme root 864 16 320 668 0 0 0 0 []
    id: block-at p 1
    ;; right-aligned; takes 1/4 of the width beyond 1200, all the height
    r: lay/add id 1 gallery/lay-root -36 750 16 0 20 250 -32 1000 0 0
    gallery/lay-right: r
    vid/heading theme id 16 14 288 24 "Glon source"
    vid/caption theme id 16 40 288 18 "Documentation and library source"
    ;; the source box stretches with the pane; its text stays clipped to it
    lay/add vid/border-rect theme id 16 70 288 538 125 2 r 16 0 70 0 -32 1000 -130 1000 0 0
    lay/add vid/rect theme id 16 70 288 538 89 0 r 16 0 70 0 -32 1000 -130 1000 0 0
    clip: view/next-id
    ;; the source document: a text-mode table filling the box
    st: table/new-auto id 17 71 286 536
    vid/table-theme theme st
    lay/add st 0 r 17 0 71 0 -34 1000 -132 1000 0 0
    gallery/set-id 40 st
    gallery/show-source
    ;; the scroll buttons stay at the bottom of the pane
    foot: view/next-id
    view/create foot id view/type-group 0 622 320 30 1 1 0 0
    f: lay/add foot 0 r 0 0 -46 1000 0 1000 30 0 0 0
    ;; the two buttons share the pane's width (138 each at 320)
    up: vid/button theme foot 16 0 138 30 "Scroll Up"
    down: vid/button theme foot 166 0 138 30 "Scroll Down"
    lay/add up 4 f 16 0 0 0 -22 500 30 0 0 0
    lay/add down 4 f 6 500 0 0 -22 500 30 0 0 0
    gallery/set-id 42 up
    gallery/set-id 43 down
]

gallery/build-ui: func [theme] [
    clear-state: func [i] [
        either < i 34 [
            vid/set-block! gallery/ids i 0
            clear-state + i 1
        ] [
            gallery/states: none
            gallery/source: ""
            gallery/widget-source: ""
            ;; GUI-P2: no forced collection here any more.  It cost 250-600
            ;; ms of every theme switch; with the allocation-free command
            ;; builder a rebuild leaves ~26K cells of garbage, which the
            ;; collector takes when the heap needs it.
        ]
    ]
    either = gallery/root 0 [ 0 ] [
        either > gallery/id 36 0 [
            table/destroy gallery/id 36
                    ] [ 0 ]
        ;; the whole root panel (its outer group), not only its content group:
        ;; destroying the content left the old panel and its fill behind
        view/destroy gallery/root-outer
        gallery/root: 0
        clear-state 0
        view/id: gallery/id-base
        gallery/pmark: 0
    ]
    either = gallery/id-base 0 [ gallery/id-base: view/id ] [ 0 ]
    vid/fill-color theme 1 1
    lay/reset
    ;; a group filling the window holds a viewport with the root panel (the
    ;; window's size but never below the minimum) and its scroll thumbs; the
    ;; group is what a rebuild destroys
    rg: view/next-id
    view/create rg 1 view/type-group 0 0 1200 700 1 1 0 0
    gallery/root-outer: rg
    gr: lay/add rg 0 -1 0 0 0 0 0 1000 0 1000 0 0
    rv: view/next-id
    view/create rv rg 8 0 0 1200 700 1 1 0 0
    rvr: lay/add rv 3 gr 0 0 0 0 0 1000 0 1000 0 0
    p: vid/panel theme rv 0 0 1200 700 0 0 0 0 []
    gallery/root: block-at p 1
    gallery/lay-root: lay/add gallery/root 1 -1 0 0 0 0 0 1000 0 1000 gallery/min-w gallery/min-h
    lay/thumbs lay/scroll rv gallery/lay-root 0 0 -1 0 rvr rg theme
    gallery/build-left theme gallery/root
    gallery/build-center theme gallery/root
    gallery/build-right theme gallery/root
    lay/apply lay/w lay/h
    gallery/lay-mark: lay/count
    ;; (widgets taking events are found when an event arrives: gallery/live-states)
    gallery/select 3 gallery/src-button
]

;; focus and blur change only the widget they name and the one showing the
;; focus ring (vid/focus-ring); only buttons and fields have a ring (state
;; slot 9), so those two are found by kind and node id instead of running
;; vid/event for every widget (GUI-P2: half of a Tab's cost)
gallery/focus-one: func [st id] [
    k: block-at st 0
    either = k vid/kind-tabs [ vid/event st ] [
    either either = k vid/kind-button [ 1 ] [ = k vid/kind-field ] [
        either either = block-at st 1 id [ 1 ] [ = block-at st 9 vid/focus-ring ] [ vid/event st ] [ 0 ]
    ] [ 0 ]
    ]
]
;; both walk the UI slots, then the preview's tracked buttons, in place (no
;; list is built per event)
gallery/focus-states: func [i id] [
    either < i block-len gallery/slots [
        st: gallery/id block-at gallery/slots i
        either = st 0 [ 0 ] [ gallery/focus-one st id ]
        gallery/focus-states + i 1 id
    ] [ gallery/focus-list gallery/pstates id ]
]
gallery/focus-list: func [l id] [
    either = l 0 [ 0 ] [ gallery/focus-one block-at l 0 id gallery/focus-list block-at l 2 id ]
]
gallery/event-states: func [i] [
    either < i block-len gallery/slots [
        st: gallery/id block-at gallery/slots i
        either = st 0 [ 0 ] [ vid/event st ]
        gallery/event-states + i 1
    ] [ gallery/event-list gallery/pstates ]
]
gallery/event-list: func [l] [
    either = l 0 [ 0 ] [ vid/event block-at l 0 gallery/event-list block-at l 2 ]
]

gallery/click: func [id] [
    scroll: func [down] [
        table/page gallery/id 40 either down [ 1 ] [ -1 ]
        gallery/set-status "Source scrolled"
    ]
    case [
        [ = id gallery/nid 0 ] [ gallery/select 0 gallery/src-window ]
        [ = id gallery/nid 1 ] [ gallery/select 1 gallery/src-panel ]
        [ = id gallery/nid 2 ] [ gallery/select 2 gallery/src-label ]
        [ = id gallery/nid 3 ] [ gallery/select 3 gallery/src-button ]
        [ = id gallery/nid 4 ] [ gallery/select 4 gallery/src-checkbox ]
        [ = id gallery/nid 5 ] [ gallery/select 5 gallery/src-radio ]
        [ = id gallery/nid 6 ] [ gallery/select 6 gallery/src-field ]
        [ = id gallery/nid 7 ] [ gallery/select 7 gallery/src-table ]
        [ = id gallery/nid 8 ] [ gallery/select 8 gallery/src-vocab ]
        [ = id gallery/nid 46 ] [ gallery/select 9 gallery/src-tabs ]
        [ = id gallery/nid 9 ] [
            gallery/theme: either = gallery/theme theme/dark [ theme/light ] [ theme/dark ]
            gallery/build-ui gallery/theme
            gallery/set-status either = gallery/theme theme/dark [ "Dark theme" ] [ "Light theme" ]
        ]
        [ = id gallery/nid 10 ] [
            ;; this gallery's own file, read from disk
            gallery/set-id 45 1
            gallery/show-source
            gallery/set-status "Full source"
        ]
        [ = id gallery/nid 11 ] [
            gallery/select gallery/id 38 gallery/widget-source
        ]
        [ = id gallery/nid 12 ] [
            gallery/set-status "Button activated"
        ]
        [ = id gallery/nid 13 ] [
            gallery/field-input ""
            gallery/set-status "Field cleared"
        ]
        [ = id gallery/nid 14 ] [
            c: block-at gallery/id 14 5
            vid/checkbox/set-checked gallery/id 14 either = c 0 [ 1 ] [ 0 ]
            gallery/set-status either = block-at gallery/id 14 5 1 [ "Checkbox 1 checked" ] [ "Checkbox 1 unchecked" ]
        ]
        [ = id gallery/nid 15 ] [
            c: block-at gallery/id 15 5
            vid/checkbox/set-checked gallery/id 15 either = c 0 [ 1 ] [ 0 ]
            gallery/set-status either = block-at gallery/id 15 5 1 [ "Checkbox 2 checked" ] [ "Checkbox 2 unchecked" ]
        ]
        [ = id gallery/nid 16 ] [
            vid/checkbox/set-checked gallery/id 16 1
            vid/checkbox/set-checked gallery/id 17 0
            vid/checkbox/set-checked gallery/id 18 0
            gallery/set-status "Radio: Individual"
        ]
        [ = id gallery/nid 17 ] [
            vid/checkbox/set-checked gallery/id 16 0
            vid/checkbox/set-checked gallery/id 17 1
            vid/checkbox/set-checked gallery/id 18 0
            gallery/set-status "Radio: Household"
        ]
        [ = id gallery/nid 18 ] [
            vid/checkbox/set-checked gallery/id 16 0
            vid/checkbox/set-checked gallery/id 17 0
            vid/checkbox/set-checked gallery/id 18 1
            gallery/set-status "Radio: Business"
        ]
        [ = id gallery/nid 19 ] [ vocab/call0 gallery-vocab 'theme ]
        [ = id gallery/nid 20 ] [ vocab/call1 gallery-vocab 'status "Vocabulary dispatch" ]
        [ = id gallery/nid 21 ] [
            r: vocab/call2 gallery-vocab 'add 2 3
            gallery/set-status "Vocabulary add"
        ]
        [ = id gallery/nid 42 ] [ scroll 0 ]
        [ = id gallery/nid 43 ] [ scroll 1 ]
        [ 1 ] [
            label: gallery/tracked-label gallery/pstates id
            either = label 0 [ 0 ] [ gallery/set-status s/+ label " pressed" ]
        ]
    ]
]

gallery/handle: func [ev value] [
    ;; pointer moves and releases need nothing here (vid/event did the hover
    ;; and press looks), nor does the host's input buffer (view-set-text, see
    ;; Clear): skip the case chain, where every clause tried costs an
    ;; allocation (case.glon makes a func per condition)
    either either = ev 'view-pointer-move [ 1 ] [ either = ev 'view-pointer-up [ 1 ] [ = ev 'view-set-text ] ] [ 0 ] [
    case [
        [ = ev 'view-click ] [ gallery/click parse-int value ]
        ;; the field's text is owned here (gallery/field-value), built from
        ;; view-char and Backspace; the host's own input buffer (view-set-text)
        ;; is not used, since Clear could not reset it
        [ = ev 'view-char ] [
            either gallery/field-focused [ gallery/field-input s/+ gallery/field-value value ] [ 0 ]
        ]
        [ = ev 'view-key ] [
            either either = parse-int value 8 [ gallery/field-focused ] [ 0 ] [
                gallery/field-input gallery/drop-last gallery/field-value
            ] [ 0 ]
        ]
        [ either = ev 'table-click [ = parse-int value gallery/table-id ] [ 0 ] ] [
            ;; "tttt rrrr cccc": table id, row, column (the row used to be
            ;; read from the id field)
            ;; one selected row: a click on another row moves the selection,
            ;; a click on the selected row unselects it (Escape quits the
            ;; runner, so it cannot be the way to clear it)
            row: parse-int-at value 5 0
            tid: gallery/id 36
            either either < row 0 [ 1 ] [ = row gallery/table-sel ] [
                either < gallery/table-sel 0 [ 0 ] [ table/deselect tid gallery/table-sel ]
                table/focus tid -1 0
                gallery/table-sel: -1
                gallery/set-status "Table selection cleared"
            ] [
                table/clear-selection tid
                gallery/table-sel: row
                table/focus tid row 0
                table/select tid row
                gallery/set-status s/+ "Table row selected: " s/from-int + row 1
            ]
        ]
        ;; the host scrolled the table (wheel, scrollbar): remember where
        [ = ev 'table-columns ] [
            either = parse-int value gallery/table-id [
                gallery/table-widths: s/span value gallery/after-int value 0 s/length value
            ] [ 0 ]
        ]
        [ = ev 'table-scroll ] [
            tid: parse-int value
            p: gallery/after-int value 0
            either = tid gallery/table-id [ gallery/table-start: parse-int-at value p 0 ] [
                either = tid gallery/id 40 [
                    vid/set-block! gallery/src-tops gallery/src-key parse-int-at value gallery/after-int value p 0
                ] [ 0 ]
            ]
        ]
        [ = ev 'view-focus ] [
            lay/reveal parse-int value
            ;; the field's prompt ("Type here") is replaced by the first
            ;; keystroke, so the caret starts in front of it
            either either = parse-int value gallery/nid 32 [ = gallery/field-touched 0 ] [ 0 ] [
                view/caret block-at gallery/id 32 3 0
            ] [ 0 ]
            gallery/set-status "Focus changed"
        ]
        [ = ev 'view-blur ] [ gallery/set-status "Focus lost" ]
        ;; GUI-P2: window size, wheel and reveal answers go to the layout
        [ = ev 'view-resize ] [
            lay/apply parse-int value parse-int-at value + s/scan-set value 0 "0123456789" 1 0
        ]
        [ = ev 'view-wheel ] [ lay/wheel value ]
        [ = ev 'view-get ] [ lay/view-get value ]
        [ 1 ] [ 0 ]
    ]
    ]
]

do-event: [
    either = current-event 'view-build [
        vid/window theme/dark 1200 700
        gallery/theme: theme/dark
        gallery/build-ui gallery/theme
    ] [
        ;; layout events (window size, wheel, reveal answers) change no
        ;; widget's look: only the gallery handler needs them
        either either = current-event 'view-resize [ 1 ] [ either = current-event 'view-wheel [ 1 ] [ = current-event 'view-get ] ] [ 0 ] [
            either either = current-event 'view-focus [ 1 ] [ = current-event 'view-blur ] [
                gallery/focus-states 0 parse-int current-value
            ] [ gallery/event-states 0 ]
        ]
        gallery/handle current-event current-value
    ]
    widget/flush
]
]